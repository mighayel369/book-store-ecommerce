<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
            color: #333;
        }

        .order-details {
            margin-left: 350px;
            margin-top: 50px;
            max-width: 900px;
            background-color: #fff;
            border-radius: 10px;
            padding: 30px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .order-details h5 {
            border-bottom: 2px solid #b46363;
            padding-bottom: 10px;
            margin-bottom: 20px;
            color: #b46363;
        }

        .order-address {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
        }

        .order-address > div {
            width: 30%;
            padding: 10px;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            background-color: #f8f9fa;
        }

        .order-address h6 {
            font-size: 1rem;
            color: #b46363;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .order-address p {
            margin: 0 0 5px;
            font-size: 0.9rem;
            color: #555;
        }
        .order-tabledata table {
        width: 100%;
        margin-bottom: 30px;
        border-collapse: collapse;
    }

    .order-tabledata th, .order-tabledata td {
        padding: 15px;
        border: 1px solid #ccc;
        text-align: center;
        width: 12.5%; 
        height: 60px;
        vertical-align: middle;
    }

    .order-tabledata th {
        background-color: #e9ecef;
        font-weight: bold;
    }

    .order-tabledata td {
        background-color: #f9f9f9;
    }
        .btn-danger {
            background-color: #dc3545;
            color: #fff;
            border: none;
            padding: 5px 10px;
            border-radius: 5px;
            cursor: pointer;
        }

        .btn-danger:hover {
            background-color: #c82333;
        }

        .subtotal {
            border-top: 2px solid #e9ecef;
            padding-top: 20px;
            display: flex;
            justify-content: flex-end;
            flex-direction: column;
        }

        .subtotal p {
            margin: 0;
            text-align: right;
        }

        .subtotal p + p {
            margin-top: 5px;
        }

        .subtotal p:last-child {
            font-weight: bold;
            font-size: 1.2em;
        } 
        .return-box {
    background-color: #f9f9f9;
    border: 1px solid #ccc;
    border-radius: 5px;
  }

    </style>
</head>
<body>
    <%- include('../partials/adminHeader') %>

    <div class="container-fluid">
        <div class="order-details">
            <h5>Order Details</h5>
            <p>Details For Order Id : <%= orderDetails.orderId %></p>
            <div class="order-table">
                <div class="order-address">
                    <div class="customor-info">
                        <h6>User Details</h6>
                        <p><%= users.username %></p>
                        <p><%= users.email %></p>
                        <p><%= users.phoneno %></p>
                    </div>
                    <div class="order-info">
                        <h6>Order Info</h6>
                        <p>Shipping: Fargo Express</p>
                        <p>Payment Method: <%= orderDetails.paymentMethod %></p>
                        <p>Status: <%= orderDetails.status %></</p>
                    </div>
                    <div class="deleiver-info">
                        <h6>Delivery Address</h6>
                        <p><%= orderDetails.shippingAddress.houseno %>,<%= orderDetails.shippingAddress.area %></p>
                        <p><%= orderDetails.shippingAddress.landmark %></p>
                        <p><%= orderDetails.shippingAddress.town %>,<%= orderDetails.shippingAddress.state %></p>
                        <p><%= orderDetails.shippingAddress.pincode %></p>
                    </div>
                </div>
                <div class="order-tabledata">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th>Order Status</th>
                                <th>Payment Status</th>
                                <th>Return/Cancel</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% orderDetails.products.forEach(product => { %>
                                <tr>
                                    <td><%= product.productName %></td>
                                    <td><%= product.discountPrice?product.discountPrice:product.productprice %></td>
                                    <td><%= product.quantity %></td>
                                    <td><%=product.discountPrice?product.discountPrice * product.quantity:product.productprice * product.quantity %></td>
                                    <td><%= product.orderStatus?product.orderStatus: orderDetails.status %></td>
                                    <td><%= orderDetails.paymentStatus %></td>
                                    <td>
                                        <% if (product.reason) { %>
                                            <div class="return-box">
                                                <p><strong>Reason:</strong></p>
                                                <p class="return-reason"><%= product.reason %></p>
                                            </div>
                                        <% } else{%>
                                            <p class="mt-3 fw-bold">Active</p>
                                            <% } %>
                                    </td>
                                    
                                    <td><%= orderDetails.createdAt.toISOString().split('T')[0] %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                <div class="subtotal">
                    <p>Subtotal: <%= orderDetails.totalAmount %></p>
                    <p>Shipping Fee: Free</p>
                    <p>Coupon: 
                        <span class="text-warning">
                            <%= orderDetails.finalPrice ? "₹" + (orderDetails.totalAmount - orderDetails.finalPrice) : "No Coupon" %>
                        </span>
                    </p>
                    <p>Grand Total: <%= orderDetails.finalPrice?orderDetails.finalPrice:orderDetails.totalAmount %></p>
                
            </div>
        </div>
    </div>

    <%- include('../partials/adminfooter') %>
    <script>
          function cancelOrder(orderId){
        let url=`/orderCancel/${orderId}`
        Swal.fire({
          title: `Are you sure you want to cancel`,
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#3085d6',
          cancelButtonColor: '#d33',
          confirmButtonText: 'Yes'
        }).then((result) => {
          if (result.isConfirmed) {
            window.location.href = url;
          }
        });
      }

      function returnOrder(orderId){
        let url=`/orderReturn/${orderId}`
        Swal.fire({
          title: `Are you sure you want to cancel`,
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#3085d6',
          cancelButtonColor: '#d33',
          confirmButtonText: 'Yes'
        }).then((result) => {
          if (result.isConfirmed) {
            window.location.href = url;
          }
        });
      }
    </script>
</body>
</html>
