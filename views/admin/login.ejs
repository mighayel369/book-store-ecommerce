<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Login | Shoe Rack</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f5f7;
            color: #212529;
        }

        .login-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 16px;
        }

        .login-card {
            display: grid;
            grid-template-columns: 1fr 1fr;
            width: 100%;
            max-width: 950px;
            min-height: 540px;
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.10);
        }


        .brand-panel {
            background: #17191c;
            color: #fff;
            padding: 50px 42px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-icon {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #198754;
            border-radius: 12px;
            font-size: 22px;
        }

        .brand-name {
            font-size: 25px;
            font-weight: 800;
            letter-spacing: 1px;
            margin: 0;
        }

        .brand-description {
            margin-top: 70px;
            margin-bottom: auto;
        }

        .brand-description .eyebrow {
            color: #62d69b;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .brand-description h1 {
            margin-top: 18px;
            font-size: 36px;
            line-height: 1.25;
            font-weight: 800;
        }

        .brand-description p {
            margin-top: 18px;
            color: #b9bec5;
            font-size: 15px;
            line-height: 1.8;
        }

        .brand-footer {
            margin-top: 55px;
            color: #9ca3af;
            font-size: 12px;
        }


        .form-panel {
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 55px 48px;
        }

        .form-heading {
            margin-bottom: 32px;
        }

        .form-heading h2 {
            font-size: 29px;
            font-weight: 750;
            margin-bottom: 10px;
        }

        .form-heading p {
            color: #777e87;
            font-size: 14px;
            margin-bottom: 0;
            line-height: 1.7;
        }

        .form-label {
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 9px;
            color: #343a40;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 23px;
        }

        .input-icon {
            position: absolute;
            top: 50%;
            left: 15px;
            transform: translateY(-50%);
            color: #858b94;
            z-index: 2;
        }

        .form-control {
            height: 49px;
            width: 100% !important;
            border: 1px solid #dfe3e8;
            border-radius: 8px !important;
            padding: 12px 44px 12px 43px;
            font-size: 14px;
            box-shadow: none !important;
        }

        .form-control:focus {
            border-color: #198754;
            box-shadow: 0 0 0 3px rgba(25, 135, 84, 0.12) !important;
        }

        .password-toggle {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #858b94;
            z-index: 3;
            border: 0;
            background: transparent;
            padding: 5px;
        }

        .password-toggle:hover {
            color: #198754;
        }

        .login-btn {
            height: 49px;
            width: 100%;
            background: #198754;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 700;
            transition: background 0.2s ease;
            margin-top: 4px;
        }

        .login-btn:hover {
            background: #146c43;
            color: #fff;
        }

        .login-btn i {
            margin-left: 8px;
        }

        .error-message {
            background: #fff0f0;
            color: #b42318;
            border: 1px solid #ffd5d2;
            padding: 11px 13px;
            border-radius: 7px;
            font-size: 13px;
            margin-bottom: 18px;
        }

        .security-note {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            margin-top: 25px;
            color: #858b94;
            font-size: 12px;
        }

        .security-note i {
            color: #198754;
        }

        @media (max-width: 767px) {
            .login-card {
                grid-template-columns: 1fr;
                max-width: 460px;
            }

            .brand-panel {
                padding: 28px;
            }

            .brand-description {
                margin-top: 35px;
            }

            .brand-description h1 {
                font-size: 27px;
            }

            .brand-description p {
                margin-bottom: 0;
            }

            .brand-footer {
                margin-top: 25px;
            }

            .form-panel {
                padding: 35px 28px;
            }
        }

        @media (max-width: 380px) {
            .form-panel {
                padding: 30px 20px;
            }

            .brand-panel {
                padding: 25px 20px;
            }
        }
    </style>
</head>

<body>

    <main class="login-wrapper">
        <div class="login-card">

            <section class="brand-panel">

                <div class="brand-logo">
                    <div class="brand-icon">
                        <i class="fa-solid fa-shoe-prints"></i>
                    </div>

                    <p class="brand-name">SHOE RACK</p>
                </div>

                <div class="brand-description">
                    <span class="eyebrow">Administration Portal</span>

                    <h1>Manage your store.<br>Move forward.</h1>

                    <p>
                        Welcome to the Shoe Rack administration portal.
                        Manage products, categories, orders, customers
                        and offers from one place.
                    </p>
                </div>

                <div class="brand-footer">
                    &copy; <%= new Date().getFullYear() %> Shoe Rack.
                        All rights reserved.
                </div>

            </section>

            <section class="form-panel">

                <div class="form-heading">
                    <h2>Admin Login</h2>
                    <p>
                        Enter your administrator credentials
                        to access your dashboard.
                    </p>
                </div>

                <form action="/admin/login" method="POST" id="adminLoginForm">

                    <div class="mb-3">
                        <label for="email" class="form-label">
                            Email Address
                        </label>

                        <div class="input-group-custom">
                            <i class="fa-regular fa-envelope input-icon"></i>

                            <input type="email" class="form-control" id="email" name="email"
                                placeholder="Enter your admin email" autocomplete="username" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">
                            Password
                        </label>

                        <div class="input-group-custom">
                            <i class="fa-solid fa-lock input-icon"></i>

                            <input type="password" class="form-control" id="password" name="password"
                                placeholder="Enter your password" autocomplete="current-password" required>

                            <button type="button" class="password-toggle" id="togglePassword" aria-label="Show password"
                                aria-pressed="false">

                                <i class="fa-regular fa-eye-slash"></i>
                            </button>
                        </div>
                    </div>

                    <% if (typeof adminmessage !=='undefined' && adminmessage) { %>
                        <div class="error-message" id="change" role="alert">
                            <i class="fa-solid fa-circle-exclamation me-2"></i>
                            <%= adminmessage.message %>
                        </div>
                        <% } %>

                            <button type="submit" class="btn login-btn">
                                Login to Dashboard
                                <i class="fa-solid fa-arrow-right"></i>
                            </button>

                </form>

                <div class="security-note">
                    <i class="fa-solid fa-shield-halved"></i>
                    Secure administrator access
                </div>

            </section>
        </div>
    </main>

    <script>
        const emailInput = document.getElementById('email');
        const passwordInput = document.getElementById('password');
        const togglePassword = document.getElementById('togglePassword');
        const errorMessage = document.getElementById('change');

        togglePassword.addEventListener('click', function () {
            const isPassword = passwordInput.type === 'password';

            passwordInput.type = isPassword ? 'text' : 'password';

            this.querySelector('i').classList.toggle(
                'fa-eye',
                isPassword
            );

            this.querySelector('i').classList.toggle(
                'fa-eye-slash',
                !isPassword
            );

            this.setAttribute(
                'aria-label',
                isPassword ? 'Hide password' : 'Show password'
            );

            this.setAttribute('aria-pressed', String(isPassword));
        });

        function clearErrorMessage() {
            if (errorMessage) {
                errorMessage.remove();
            }
        }

        emailInput.addEventListener('input', clearErrorMessage);
        passwordInput.addEventListener('input', clearErrorMessage);
    </script>

</body>

</html>