<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Customer Management | Shoe Rack Admin</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <link href="https://cdn.datatables.net/2.1.8/css/dataTables.dataTables.min.css" rel="stylesheet">

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    body {
      background-color: #f5f6fa;
      color: #212529;
    }


    .page-container {
      width: calc(100% - var(--sidebar-width));
      max-width: none;
      margin-left: var(--sidebar-width) !important;
      margin-top: var(--navbar-height);
      padding: 28px;
      min-height: calc(100vh - var(--navbar-height));
      min-width: 0;
      box-sizing: border-box;
      transition: margin-left 0.25s ease, width 0.25s ease;
    }

    .page-heading {
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    .page-subtitle {
      color: #6c757d;
      font-size: 14px;
    }

    .customer-card {
      background: #fff;
      border: 1px solid #e9ecef;
      border-radius: 12px;
      box-shadow: 0 3px 15px rgba(0, 0, 0, 0.04);
    }

    .stat-card {
      padding: 20px;
      height: 100%;
    }

    .stat-label {
      color: #6c757d;
      font-size: 13px;
      font-weight: 500;
    }

    .stat-value {
      font-size: 28px;
      font-weight: 700;
      margin-top: 6px;
    }

    .stat-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 10px;
      font-size: 20px;
    }

    .icon-total {
      background: #e8efff;
      color: #3159b8;
    }

    .icon-active {
      background: #e1f7eb;
      color: #198754;
    }

    .icon-blocked {
      background: #fff0e6;
      color: #dc3545;
    }

    .table-card {
      overflow: hidden;
    }

    .table-heading {
      padding: 22px 24px;
      border-bottom: 1px solid #eee;
    }

    .table-heading h5 {
      font-weight: 700;
      margin-bottom: 5px;
    }

    .table-responsive {
      padding: 8px 20px 20px;
    }

    #table-data {
      width: 100% !important;
      margin-top: 10px !important;
    }

    #table-data thead th {
      background: #f8f9fb;
      color: #495057;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 16px 12px;
      border-bottom: 1px solid #dee2e6;
      white-space: nowrap;
    }

    #table-data tbody td {
      padding: 16px 12px;
      vertical-align: middle;
      font-size: 14px;
    }

    #table-data tbody tr:hover {
      background-color: #fafbff;
    }

    .customer-id {
      color: #6c757d;
      font-size: 12px;
    }

    .customer-name {
      font-weight: 600;
      color: #212529;
    }

    .status-badge {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }

    .status-active {
      background: #e4f7ec;
      color: #198754;
    }

    .status-blocked {
      background: #fde8e8;
      color: #dc3545;
    }

    .action-btn {
      min-width: 95px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
    }

    .empty-state {
      text-align: center;
      padding: 55px 20px;
      color: #6c757d;
    }

    .empty-state-icon {
      font-size: 40px;
      margin-bottom: 12px;
    }

    .alert {
      border-radius: 8px;
    }

    @media (max-width: 991.98px) {
      .page-container {
        width: 100%;
        margin-left: 0;
        padding: 20px 15px;
      }
    }

    @media (max-width: 767px) {
      .page-heading {
        font-size: 23px;
      }

      .table-heading {
        padding: 18px;
      }

      .table-responsive {
        padding: 8px 12px 16px;
      }

      .stat-value {
        font-size: 24px;
      }
    }
  </style>
</head>

<body>

  <%- include('../partials/adminHeader') %>

    <main class="container page-container">

      <% if (typeof adminmessage !=='undefined' && adminmessage) { %>
        <div id="flash-message" hidden data-message="<%= adminmessage.message %>"
          data-type="<%= adminmessage.type || 'success' %>">
        </div>
        <% } %>

          <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

            <div>
              <h2 class="page-heading mb-2">Customer Management</h2>
              <p class="page-subtitle mb-0">
                Manage your customers and their account status.
              </p>
            </div>

            <a href="/admin/adduser" class="btn btn-dark px-4 py-2">
              + Add Customer
            </a>

          </div>

          <% const customerList=Array.isArray(usersdata) ? usersdata : []; const totalCustomers=customerList.length;
            const activeCustomers=customerList.filter(user=> user.status).length;
            const blockedCustomers = totalCustomers - activeCustomers;
            %>

            <div class="row g-3 mb-4">

              <div class="col-12 col-md-4">
                <div class="customer-card stat-card">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <div class="stat-label">Total Customers</div>
                      <div class="stat-value">
                        <%= totalCustomers %>
                      </div>
                    </div>
                    <div class="stat-icon icon-total">👥</div>
                  </div>
                </div>
              </div>

              <div class="col-12 col-md-4">
                <div class="customer-card stat-card">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <div class="stat-label">Active Customers</div>
                      <div class="stat-value">
                        <%= activeCustomers %>
                      </div>
                    </div>
                    <div class="stat-icon icon-active">✓</div>
                  </div>
                </div>
              </div>

              <div class="col-12 col-md-4">
                <div class="customer-card stat-card">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <div class="stat-label">Blocked Customers</div>
                      <div class="stat-value">
                        <%= blockedCustomers %>
                      </div>
                    </div>
                    <div class="stat-icon icon-blocked">!</div>
                  </div>
                </div>
              </div>

            </div>

            <section class="customer-card table-card">

              <div class="table-heading">
                <h5>All Customers</h5>
                <p class="page-subtitle mb-0">
                  View customer details and manage access to their accounts.
                </p>
              </div>

              <% if (customerList.length> 0) { %>

                <div class="table-responsive">

                  <table class="table table-hover align-middle" id="table-data">

                    <thead>
                      <tr>
                        <th>#</th>
                        <th>Customer</th>
                        <th>Email Address</th>
                        <th>Phone Number</th>
                        <th>Account Status</th>
                        <th>Action</th>
                      </tr>
                    </thead>

                    <tbody>

                      <% customerList.forEach((element, index)=> { %>

                        <tr>

                          <td>
                            <%= index + 1 %>
                          </td>

                          <td>
                            <div class="customer-name">
                              <%= element.username || 'N/A' %>
                            </div>
                            <div class="customer-id">
                              ID: <%= element._id %>
                            </div>
                          </td>

                          <td>
                            <%= element.email || 'N/A' %>
                          </td>

                          <td>
                            <%= element.phoneno || 'N/A' %>
                          </td>

                          <td>
                            <% if (element.status) { %>
                              <span class="status-badge status-active">
                                Active
                              </span>
                              <% } else { %>
                                <span class="status-badge status-blocked">
                                  Blocked
                                </span>
                                <% } %>
                          </td>

                          <td>
                            <% if (element.status) { %>

                              <button type="button" class="btn btn-outline-danger btn-sm action-btn customer-action-btn"
                                data-user-id="<%= element._id %>" data-action="block"
                                data-user-name="<%= element.username || 'this customer' %>">
                                Block Customer
                              </button>

                              <% } else { %>

                                <button type="button"
                                  class="btn btn-outline-success btn-sm action-btn customer-action-btn"
                                  data-user-id="<%= element._id %>" data-action="unblock"
                                  data-user-name="<%= element.username || 'this customer' %>">
                                  Unblock
                                </button>

                                <% } %>
                          </td>

                        </tr>

                        <% }) %>

                    </tbody>

                  </table>

                </div>

                <% } else { %>

                  <div class="empty-state">
                    <div class="empty-state-icon">👥</div>
                    <h5 class="text-dark">No Customers Found</h5>
                    <p class="mb-3">
                      There are currently no customers to display.
                    </p>
                    <a href="/admin/adduser" class="btn btn-dark">
                      Add Your First Customer
                    </a>
                  </div>

                  <% } %>

            </section>

    </main>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.min.js"></script>

    <script>
      document.addEventListener('DOMContentLoaded', function () {

        if (document.querySelector('#table-data') && window.DataTable) {
          if (!DataTable.isDataTable('#table-data')) {
            new DataTable('#table-data', {
              pageLength: 10,
              lengthMenu: [5, 10, 25, 50],
              ordering: true,
              searching: true,
              language: {
                search: 'Search customers:',
                emptyTable: 'No customers available',
                zeroRecords: 'No matching customers found',
                lengthMenu: 'Show _MENU_ customers',
                info: 'Showing _START_ to _END_ of _TOTAL_ customers',
                infoEmpty: 'No customers available',
                paginate: {
                  previous: 'Previous',
                  next: 'Next'
                }
              },
              columnDefs: [
                {
                  targets: 5,
                  orderable: false,
                  searchable: false
                }
              ]
            });
          }
        }

        document.querySelectorAll('.customer-action-btn').forEach(function (button) {

          button.addEventListener('click', async function () {

            const userId = this.dataset.userId;
            const action = this.dataset.action;
            const userName = this.dataset.userName;

            const isBlocking = action === 'block';

            const result = await Swal.fire({
              title: isBlocking
                ? 'Block this customer?'
                : 'Unblock this customer?',

              text: isBlocking
                ? `Are you sure you want to block ${userName}? They may lose access to their account.`
                : `Are you sure you want to restore access for ${userName}?`,

              icon: 'warning',

              showCancelButton: true,

              confirmButtonColor: isBlocking ? '#dc3545' : '#198754',
              cancelButtonColor: '#6c757d',

              confirmButtonText: isBlocking
                ? 'Yes, block customer'
                : 'Yes, unblock customer',

              cancelButtonText: 'Cancel',
              reverseButtons: true
            });

            if (!result.isConfirmed) {
              return;
            }

            const url = isBlocking
              ? `/admin/block/${encodeURIComponent(userId)}`
              : `/admin/unblock/${encodeURIComponent(userId)}`;

            try {
              window.location.href = url;
            } catch (error) {

              Swal.fire({
                icon: 'error',
                title: 'Something went wrong',
                text: 'Unable to process this action.'
              });
            }

          });

        });

      });


      const flashMessage = document.getElementById('flash-message');

      if (flashMessage && typeof Swal !== 'undefined') {
        const message = flashMessage.dataset.message;
        const type = flashMessage.dataset.type;

        const icon = type === 'danger'
          ? 'error'
          : ['success', 'error', 'warning', 'info', 'question'].includes(type)
            ? type
            : 'info';

        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: icon,
          title: message,
          showConfirmButton: false,
          timer: 2500,
          timerProgressBar: true
        });
      }
    </script>

    <%- include('../partials/adminfooter') %>

</body>

</html>