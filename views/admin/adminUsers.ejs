<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel</title>
  <link rel="stylesheet" href="path/to/your/css/styles.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
      .dataTables_wrapper .dataTables_paginate .paginate_button {
      padding: 0 !important; 
      margin: 0 2px; 
    }

    .dataTables_wrapper .dataTables_filter input {
      margin-left: 0.5rem; 
    }

     table.dataTable td, table.dataTable th {
      text-align: center !important;
      vertical-align: middle !important;
    }
  </style>
</head>
<body>
<%- include('../partials/adminHeader') %>
<main>
<div class="container">
  <% if (adminmessage) { %>
    <div class="alert m-4 alert-dismissible fade show alert-<%= adminmessage.type %>" role="alert">
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      <strong><%= adminmessage.message %></strong>
    </div>
  <% } %>
  <div class="d-flex justify-content-end m-5">
    <h3 class="me-auto">User Management</h3>
    <a href="/admin/adduser" class="btn btn-dark">Add User</a>
  </div>
  <div class="row m-4">
    <div class="col-lg-12">
 <% if (usersdata) { %>
    <div class="table-responsive">
        <table class="table table-stripped text-center" id="table-data">
          <thead>
            <tr class="table-dark">
              <th >Id</th>
              <th >Name</th>
              <th >Email</th>
              <th >Phone</th>
              <th >Status</th>
              <th >Action</th>
            </tr>
          </thead>
          <tbody>
            <% usersdata.forEach((element,index) => { %>
              <tr>
              <td ><%=index%></td>
              <td ><%= element.username %></td>
              <td ><%= element.email %></td>
              <td ><%= element.phoneno %></td>
              <td >
                <% if (element.status) { %>
                  Active
                <% } else { %>
                  Blocked
                <% } %>
              </td>
              <td>
                <% if (element.status) { %>
                  <a href="#" class="btn btn-dark btn-sm block-btn" data-user="<%= element._id %>" onclick="confirmBlock('<%= element._id %>', 'block')">Block</a>
                <% } else { %>
                  <a href="#" class="btn btn-warning btn-sm unblock-btn" data-user="<%= element._id %>" onclick="confirmBlock('<%= element._id %>', 'unblock')">Unblock</a>
                <% } %>
              </td>
               <% }) %>
          </tbody>
        </table>
      </div>
 <% } else { %>
  <h1 class="text-center text-secondary mt-5">No Users Found!</h1>
  <% } %>
</div>
</div>
</div>
</main>
<script>
  function confirmBlock(userId, action) {
    const url = action === 'block' ? `/admin/block/${userId}` : `/admin/unblock/${userId}`;
    const actionText = action === 'block' ? 'block' : 'unblock';
    
    Swal.fire({
      title: `Are you sure you want to ${actionText} this user?`,
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#3085d6',
      cancelButtonColor: '#d33',
      confirmButtonText: 'Yes, do it!'
    }).then((result) => {
      if (result.isConfirmed) {
        window.location.href = url;
      }
    });
  }
  </script>
</body>
<%- include('../partials/adminfooter') %>
</html>
