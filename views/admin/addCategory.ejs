<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Coupon - Admin Panel</title>
  <style>
    .couponDiv {
      background-color: #f8f9fa;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      width: 450px;
      margin-top: 80px;
    }
    .coupon-header {
      border-bottom: 1px solid #dee2e6;
      padding-bottom: 8px;
      margin-bottom: 15px;
    }
    .form-label {
      font-size: 0.9rem; 
    }
    .form-control, .form-select {
      font-size: 0.9rem; 
    }
    .btn {
      font-size: 0.9rem; 
    }
  </style>
</head>
<body>

  <%- include('../partials/adminHeader') %>
  
  <main>
    <div class="container mt-4">
      <div class="row">
        <div class="col-lg-6 mx-auto">
          <div class="couponDiv">
            <div class="coupon-header text-center">
              <h5 class="fw-bold"><i class="fa-solid fa-layer-group"></i> Add Category</h5>
            </div>
            <form action="/admin/addcategory" method="post" enctype="multipart/form-data">
              <div class="mb-3">
                <label for="categoryname" class="form-label">Category Name</label>
                <input type="string" class="form-control" id="categoryname" placeholder="Name" name="categoryname">
              </div>
              <div class="mb-3">
                <label for="categorydescription" class="form-label">Description</label>
                <input type="String" class="form-control" id="categorydescription" placeholder="Description" name="categorydescription">
              </div>
              <div class="mb-3">
                <label for="image" class="form-label">Category Image</label>
                <input type="file" class="form-control" id="image" placeholder="file not chosen" name="image" >
              </div>
              <% if (adminmessage) { %>
                <p class="text-white"id="change" ><%= adminmessage.message %></p>
               <% } %>
            <div class="d-grid mt-3">
              <button type="submit" class="btn btn-dark btn-sm"><i class="fa-solid fa-layer-group"></i> Add Category</button>
            </div>
            </form>
          </div>
        </div>
      </div>
      </div>
</main>
<%- include('../partials/adminfooter') %>