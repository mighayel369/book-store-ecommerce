<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Category Management | Shoe Rack</title>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    :root {
      --primary: #222222;
      --secondary: #6b7280;
      --background: #f5f6f8;
      --border: #e5e7eb;
      --white: #ffffff;
      --danger: #dc3545;
      --success: #198754;
    }

    main,
    .admin-main {
      margin-left: var(--sidebar-width);
      margin-top: var(--navbar-height);
      padding: 28px;
      min-height: calc(100vh - var(--navbar-height));
      min-width: 0;
      box-sizing: border-box;
    }


    body {
      background: var(--background);
      color: #252525;
      font-family: Arial, Helvetica, sans-serif;
    }

    .category-page {
      padding: 32px 0 50px;
      min-height: 75vh;
    }

    .page-heading {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
      margin-bottom: 26px;
    }

    .page-heading h2 {
      font-size: 27px;
      font-weight: 700;
      margin: 0 0 6px;
    }

    .page-heading p {
      color: var(--secondary);
      margin: 0;
      font-size: 14px;
    }

    .add-category-btn {
      background: var(--primary);
      color: white;
      border: 1px solid var(--primary);
      border-radius: 8px;
      padding: 11px 18px;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      transition: 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .add-category-btn:hover {
      background: #444;
      color: white;
    }

    .category-summary {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px 22px;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .summary-icon {
      width: 48px;
      height: 48px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f0f0f0;
      color: #333;
      font-size: 20px;
    }

    .summary-label {
      color: var(--secondary);
      font-size: 13px;
      margin-bottom: 5px;
    }

    .summary-value {
      font-size: 25px;
      font-weight: 700;
      margin: 0;
    }

    .category-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
    }

    .table-header {
      padding: 20px 22px;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .table-header h5 {
      font-size: 16px;
      font-weight: 700;
      margin: 0;
    }

    .category-count {
      font-size: 12px;
      color: var(--secondary);
      background: #f3f4f6;
      border-radius: 20px;
      padding: 6px 10px;
    }

    .category-table {
      margin: 0;
      min-width: 600px;
    }

    .category-table thead th {
      background: #f8f9fa;
      color: #6b7280;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }

    .category-table tbody td {
      padding: 16px 20px;
      vertical-align: middle;
      border-bottom: 1px solid #f0f0f0;
      font-size: 14px;
    }

    .category-table tbody tr:last-child td {
      border-bottom: none;
    }

    .category-table tbody tr:hover {
      background: #fafafa;
    }

    .category-id {
      color: var(--secondary);
      font-size: 12px;
      font-family: monospace;
    }

    .category-name {
      font-weight: 600;
      color: #292929;
    }

    .category-image {
      width: 58px;
      height: 58px;
      object-fit: cover;
      border: 1px solid var(--border);
      border-radius: 9px;
      background: #f8f8f8;
      padding: 3px;
    }

    .image-placeholder {
      width: 58px;
      height: 58px;
      border-radius: 9px;
      background: #f3f4f6;
      color: #9ca3af;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }

    .action-buttons {
      display: flex;
      align-items: center;
      justify-content: left;
      gap: 9px;
    }

    .action-btn {
      width: 36px;
      height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: white;
      text-decoration: none;
      transition: 0.2s ease;
      cursor: pointer;
    }

    .edit-btn {
      color: #374151;
    }

    .edit-btn:hover {
      background: #f3f4f6;
      color: #111827;
    }

    .delete-btn {
      color: var(--danger);
    }

    .delete-btn:hover {
      background: #fff1f2;
      border-color: #fecdd3;
      color: #b91c1c;
    }

    .empty-state {
      text-align: center;
      padding: 55px 20px !important;
    }

    .empty-state i {
      color: #9ca3af;
      font-size: 36px;
      margin-bottom: 15px;
    }

    .empty-state h6 {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 7px;
    }

    .empty-state p {
      color: var(--secondary);
      font-size: 14px;
      margin-bottom: 18px;
    }

    @media (max-width: 576px) {
      .category-page {
        padding-top: 22px;
      }

      .page-heading h2 {
        font-size: 22px;
      }

      .add-category-btn {
        width: 100%;
        justify-content: center;
      }

      .category-summary {
        padding: 16px;
      }

      .table-header {
        padding: 16px;
      }
    }
  </style>
</head>

<body>
  <%- include('../partials/adminHeader') %>

    <main class="category-page">
      <div class="container">

        <% if (typeof adminmessage !=='undefined' && adminmessage) { %>
          <div id="flash-message" hidden data-message="<%= adminmessage.message %>"
            data-type="<%= adminmessage.type || 'success' %>">
          </div>
          <% } %>

            <div class="page-heading">
              <div>
                <h2>Category Management</h2>
                <p>Manage the shoe categories available in your store.</p>
              </div>

              <a href="/admin/addcategory" class="add-category-btn">
                <i class="fa-solid fa-plus"></i>
                Add Category
              </a>
            </div>

            <div class="category-summary">
              <div class="summary-icon">
                <i class="fa-solid fa-layer-group"></i>
              </div>

              <div>
                <div class="summary-label">Total Categories</div>
                <p class="summary-value">
                  <%= category.length %>
                </p>
              </div>
            </div>

            <section class="category-card">
              <div class="table-header">
                <h5>All Categories</h5>
                <span class="category-count">
                  <%= category.length %> categories
                </span>
              </div>

              <div class="table-responsive">
                <table class="table category-table text-center" id="table-data">
                  <thead>
                    <tr>
                      <th scope="col">No.</th>
                      <th scope="col">Category</th>
                      <th scope="col">Image</th>
                      <th scope="col">Actions</th>
                    </tr>
                  </thead>

                  <tbody>
                    <% if (category.length> 0) { %>

                      <% category.forEach((element, index)=> { %>
                        <tr>
                          <td>
                            <span class="category-id">
                              <%= index + 1 %>
                            </span>
                          </td>

                          <td>
                            <div class="category-name">
                              <%= element.categoryname %>
                            </div>
                          </td>

                          <td>
                            <% if (element.image) { %>
                              <img src="<%= element.image %>" alt="<%= element.categoryname %>" class="category-image"
                                loading="lazy"
                                onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';">

                              <span class="image-placeholder" style="display:none;">
                                <i class="fa-solid fa-image"></i>
                              </span>
                              <% } else { %>
                                <span class="image-placeholder">
                                  <i class="fa-solid fa-image"></i>
                                </span>
                                <% } %>
                          </td>

                          <td>
                            <div class="action-buttons">
                              <a href="/admin/editcategory/<%= element._id %>" class="action-btn edit-btn"
                                title="Edit category" aria-label="Edit <%= element.categoryname %>">
                                <i class="fa-solid fa-pen-to-square"></i>
                              </a>
                              <button type="button" class="action-btn delete-btn" title="Delete category"
                                aria-label="Delete category"
                                onclick="deleteCategory('<%= element._id %>','<%= element.categoryname %>')">
                                <i class="fa-solid fa-trash"></i>
                              </button>
                            </div>
                          </td>
                        </tr>
                        <% }) %>

                          <% } else { %>
                            <tr>
                              <td colspan="4" class="empty-state">
                                <i class="fa-solid fa-folder-open d-block"></i>
                                <h6>No categories found</h6>
                                <p>Start by adding your first shoe category.</p>
                                <a href="/admin/addcategory" class="add-category-btn">
                                  <i class="fa-solid fa-plus"></i>
                                  Add Category
                                </a>
                              </td>
                            </tr>
                            <% } %>
                  </tbody>
                </table>
              </div>
            </section>

      </div>
    </main>

    <script>
      function deleteCategory(categoryId, categoryName) {
        Swal.fire({
          title: 'Delete this category?',
          text: `Are you sure you want to delete "${categoryName}"?`,
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#dc3545',
          cancelButtonColor: '#6b7280',
          confirmButtonText: 'Yes, delete it',
          cancelButtonText: 'Cancel',
          reverseButtons: true,
          focusCancel: true
        }).then((result) => {
          if (result.isConfirmed) {
            window.location.href = `/admin/deletecategory/${categoryId}`;
          }
        });
      }

      const flashMessage = document.getElementById('flash-message');

      if (flashMessage && typeof Swal !== 'undefined') {
        const message = flashMessage.dataset.message;
        const type = flashMessage.dataset.type;

        const icon = type === 'danger'
          ? 'error'
          : ['success', 'error', 'warning', 'info', 'question'].includes(type)
            ? type
            : 'info';

        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: icon,
          title: message,
          showConfirmButton: false,
          timer: 2500,
          timerProgressBar: true
        });
      }
    </script>

    <%- include('../partials/adminfooter') %>
</body>

</html>