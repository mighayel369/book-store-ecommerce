<%- include('../partials/adminHeader') %>

  <style>
    main,
    .admin-main {
      margin-left: var(--sidebar-width);
      margin-top: var(--navbar-height);
      padding: 28px;
      min-height: calc(100vh - var(--navbar-height));
      min-width: 0;
      box-sizing: border-box;
    }


    .dashboard-page {
      max-width: 1500px;
      margin: 0 auto;
    }

    .dashboard-title {
      font-size: 27px;
      font-weight: 750;
      color: #212529;
      margin-bottom: 7px;
    }

    .dashboard-subtitle {
      color: #7a838d;
      font-size: 14px;
      margin: 0;
    }

    .dashboard-label {
      color: #198754;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 9px;
    }

    .dashboard-heading {
      margin-bottom: 30px;
    }

    .stat-card {
      height: 100%;
      min-height: 155px;
      padding: 23px;
      border: 1px solid #e9ecef;
      background: #ffffff;
      border-radius: 13px;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.025);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
    }

    .stat-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
    }

    .stat-title {
      font-size: 13px;
      color: #727b85;
      font-weight: 600;
    }

    .stat-icon {
      width: 44px;
      height: 44px;
      border-radius: 11px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      flex-shrink: 0;
    }

    .icon-green {
      background: #e5f5eb;
      color: #198754;
    }

    .icon-blue {
      background: #e8f0ff;
      color: #3975db;
    }

    .icon-orange {
      background: #fff1df;
      color: #dc8a19;
    }

    .icon-purple {
      background: #f0eaff;
      color: #7654c9;
    }

    .stat-value {
      color: #212529;
      font-size: 27px;
      font-weight: 750;
      line-height: 1.2;
      margin: 0;
      overflow-wrap: anywhere;
    }

    .stat-description {
      color: #8a929b;
      font-size: 12px;
      margin-top: 8px;
      margin-bottom: 0;
    }

    .clickable-stat {
      cursor: pointer;
    }


    .dashboard-panel {
      background: #ffffff;
      border: 1px solid #e9ecef;
      border-radius: 13px;
      padding: 25px;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.025);
    }

    .panel-title {
      font-size: 17px;
      font-weight: 750;
      margin: 0;
      color: #212529;
    }

    .panel-description {
      color: #89919b;
      font-size: 12px;
      margin-top: 6px;
      margin-bottom: 0;
    }

    .chart-filter {
      width: 145px;
      border-color: #e0e5e9;
      border-radius: 8px;
      font-size: 13px;
      box-shadow: none !important;
    }

    .chart-filter:focus {
      border-color: #198754;
    }

    .chart-area {
      position: relative;
      height: 330px;
      margin-top: 28px;
    }

    .chart-status {
      display: none;
      text-align: center;
      color: #7a838d;
      font-size: 13px;
      padding: 15px;
    }


    .detail-modal .modal-content {
      border: none;
      border-radius: 15px;
      overflow: hidden;
    }

    .detail-modal .modal-header {
      padding: 22px 25px;
      border-bottom: 1px solid #edf0f2;
    }

    .detail-modal .modal-body {
      padding: 15px 25px 25px;
      max-height: 65vh;
      overflow-y: auto;
    }

    .detail-modal .modal-title {
      font-size: 18px;
      font-weight: 750;
    }

    .detail-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 15px 0;
      border-bottom: 1px solid #edf0f2;
    }

    .detail-item:last-child {
      border-bottom: none;
    }

    .detail-icon {
      width: 43px;
      height: 43px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      border-radius: 10px;
      background: #e8f5ec;
      color: #198754;
      font-size: 16px;
    }

    .detail-info {
      flex: 1;
      min-width: 0;
    }

    .detail-name {
      color: #343a40;
      font-size: 14px;
      font-weight: 650;
      overflow-wrap: anywhere;
      margin-bottom: 5px;
    }

    .detail-meta {
      color: #89919b;
      font-size: 12px;
      margin: 0;
      overflow-wrap: anywhere;
    }

    .detail-rank {
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f2f4f6;
      border-radius: 7px;
      font-size: 12px;
      font-weight: 700;
      color: #59616b;
      flex-shrink: 0;
    }

    .empty-state {
      text-align: center;
      padding: 45px 15px;
      color: #89919b;
    }

    .empty-state i {
      font-size: 32px;
      margin-bottom: 15px;
      color: #c5cbd1;
    }

    .empty-state p {
      font-size: 13px;
      margin: 0;
    }

    .dashboard-footer-note {
      font-size: 12px;
      color: #89919b;
      text-align: center;
      margin: 25px 0 5px;
    }

    @media (max-width: 575.98px) {
      .dashboard-heading {
        margin-bottom: 22px;
      }

      .dashboard-title {
        font-size: 23px;
      }

      .stat-card {
        padding: 17px;
        min-height: 140px;
      }

      .stat-value {
        font-size: 23px;
      }

      .stat-icon {
        width: 38px;
        height: 38px;
        font-size: 16px;
      }

      .dashboard-panel {
        padding: 18px;
      }

      .chart-area {
        height: 270px;
      }

      .chart-filter {
        width: 115px;
      }
    }
  </style>

  <main>
    <div class="dashboard-page">

      <div class="dashboard-heading d-flex justify-content-between
                    align-items-center flex-wrap gap-3">

        <div>
          <div class="dashboard-label">Store overview</div>
          <h1 class="dashboard-title">Dashboard</h1>
          <p class="dashboard-subtitle">
            Welcome back! Here's what's happening with your store.
          </p>
        </div>

        <div class="text-secondary small">
          <i class="fa-regular fa-calendar me-2"></i>
          <span id="dashboardDate"></span>
        </div>
      </div>

      <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
          <div class="stat-card">
            <div class="stat-top">
              <span class="stat-title">Total Sales</span>
              <div class="stat-icon icon-green">
                <i class="fa-solid fa-indian-rupee-sign"></i>
              </div>
            </div>

            <h2 class="stat-value" id="totalRevenue">₹0.00</h2>

            <p class="stat-description" id="revenueDescription">
              Sales for the selected period
            </p>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
          <div class="stat-card clickable-stat" role="button" tabindex="0" data-bs-toggle="modal"
            data-bs-target="#productsModal">

            <div class="stat-top">
              <span class="stat-title">Top Products</span>
              <div class="stat-icon icon-blue">
                <i class="fa-solid fa-box-open"></i>
              </div>
            </div>

            <h2 class="stat-value">
              <%= products.length %>
            </h2>

            <p class="stat-description">
              <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>
              View popular products
            </p>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
          <div class="stat-card clickable-stat" role="button" tabindex="0" data-bs-toggle="modal"
            data-bs-target="#categoriesModal">

            <div class="stat-top">
              <span class="stat-title">Top Categories</span>
              <div class="stat-icon icon-orange">
                <i class="fa-solid fa-layer-group"></i>
              </div>
            </div>

            <h2 class="stat-value">
              <%= categories.length %>
            </h2>

            <p class="stat-description">
              <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>
              View best-selling categories
            </p>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
          <div class="stat-card clickable-stat" role="button" tabindex="0" data-bs-toggle="modal"
            data-bs-target="#usersModal">

            <div class="stat-top">
              <span class="stat-title">Registered Users</span>
              <div class="stat-icon icon-purple">
                <i class="fa-solid fa-users"></i>
              </div>
            </div>

            <h2 class="stat-value">
              <%= users.length %>
            </h2>

            <p class="stat-description">
              <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>
              View registered customers
            </p>
          </div>
        </div>

      </div>

      <section class="dashboard-panel">

        <div class="d-flex justify-content-between align-items-center
                        flex-wrap gap-3">

          <div>
            <h2 class="panel-title">Sales Overview</h2>
            <p class="panel-description">
              Review sales performance over time.
            </p>
          </div>

          <select id="chart-filter" class="form-select chart-filter" aria-label="Sales period">
            <option value="monthly">Monthly</option>
            <option value="yearly">Yearly</option>
          </select>
        </div>

        <div id="chartLoading" class="chart-status">
          <i class="fa-solid fa-spinner fa-spin me-2"></i>
          Loading sales data...
        </div>

        <div id="chartError" class="alert alert-danger mt-3 d-none" role="alert"></div>

        <div class="chart-area" id="chartArea">
          <canvas id="myChart" aria-label="Sales overview chart" role="img"></canvas>
        </div>

        <div id="chartEmpty" class="empty-state d-none">
          <i class="fa-solid fa-chart-column d-block"></i>
          <p>No sales data is available for this period.</p>
        </div>

      </section>

      <p class="dashboard-footer-note">
        Shoe Rack Admin Dashboard &mdash; Store performance at a glance.
      </p>
    </div>
  </main>

  <div class="modal fade detail-modal" id="productsModal" tabindex="-1" aria-labelledby="productsModalLabel"
    aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">

        <div class="modal-header">
          <div>
            <h2 class="modal-title" id="productsModalLabel">
              <i class="fa-solid fa-box-open text-success me-2"></i>
              Top Products
            </h2>
            <p class="panel-description">Your popular shoe products.</p>
          </div>

          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">

          <% if (products.length> 0) { %>

            <% products.forEach((product, index)=> { %>
              <div class="detail-item">

                <div class="detail-rank">
                  <%= index + 1 %>
                </div>

                <div class="detail-icon">
                  <i class="fa-solid fa-shoe-prints"></i>
                </div>

                <div class="detail-info">
                  <div class="detail-name">
                    <%= product.productname %>
                  </div>

                  <p class="detail-meta">
                    Price: ₹<%= Number(product.productprice || 0).toFixed(2) %>
                      &nbsp;|&nbsp;
                      Popularity: <%= product.popularityScore || 0 %>
                  </p>
                </div>

              </div>
              <% }) %>

                <% } else { %>

                  <div class="empty-state">
                    <i class="fa-solid fa-box-open d-block"></i>
                    <p>No products found.</p>
                  </div>

                  <% } %>

        </div>
      </div>
    </div>
  </div>

  <div class="modal fade detail-modal" id="categoriesModal" tabindex="-1" aria-labelledby="categoriesModalLabel"
    aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">

        <div class="modal-header">
          <div>
            <h2 class="modal-title" id="categoriesModalLabel">
              <i class="fa-solid fa-layer-group text-success me-2"></i>
              Top Categories
            </h2>
            <p class="panel-description">Categories ranked by products sold.</p>
          </div>

          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">

          <% if (categories.length> 0) { %>

            <% categories.forEach((category, index)=> { %>
              <div class="detail-item">

                <div class="detail-rank">
                  <%= index + 1 %>
                </div>

                <div class="detail-icon">
                  <i class="fa-solid fa-tags"></i>
                </div>

                <div class="detail-info">
                  <div class="detail-name">
                    <%= category._id %>
                  </div>

                  <p class="detail-meta">
                    Total products sold:
                    <%= category.totalSold || 0 %>
                  </p>
                </div>

              </div>
              <% }) %>

                <% } else { %>

                  <div class="empty-state">
                    <i class="fa-solid fa-layer-group d-block"></i>
                    <p>No categories found.</p>
                  </div>

                  <% } %>

        </div>
      </div>
    </div>
  </div>

  <div class="modal fade detail-modal" id="usersModal" tabindex="-1" aria-labelledby="usersModalLabel"
    aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">

        <div class="modal-header">
          <div>
            <h2 class="modal-title" id="usersModalLabel">
              <i class="fa-solid fa-users text-success me-2"></i>
              Registered Users
            </h2>
            <p class="panel-description">
              Customers registered with Shoe Rack.
            </p>
          </div>

          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">

          <% if (users.length> 0) { %>

            <% users.forEach((user, index)=> { %>
              <div class="detail-item">

                <div class="detail-rank">
                  <%= index + 1 %>
                </div>

                <div class="detail-icon">
                  <i class="fa-solid fa-user"></i>
                </div>

                <div class="detail-info">
                  <div class="detail-name">
                    <%= user.username %>
                  </div>

                  <p class="detail-meta">Shoe Rack customer</p>
                </div>

              </div>
              <% }) %>

                <% } else { %>

                  <div class="empty-state">
                    <i class="fa-solid fa-users d-block"></i>
                    <p>No registered users found.</p>
                  </div>

                  <% } %>

        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
    let myChart = null;

    const chartFilter = document.getElementById('chart-filter');
    const chartCanvas = document.getElementById('myChart');
    const chartLoading = document.getElementById('chartLoading');
    const chartError = document.getElementById('chartError');
    const chartEmpty = document.getElementById('chartEmpty');
    const chartArea = document.getElementById('chartArea');
    const totalRevenue = document.getElementById('totalRevenue');
    const revenueDescription = document.getElementById('revenueDescription');

    document.getElementById('dashboardDate').textContent =
      new Date().toLocaleDateString('en-IN', {
        day: 'numeric',
        month: 'short',
        year: 'numeric'
      });

    function formatCurrency(amount) {
      return Number(amount || 0).toLocaleString('en-IN', {
        style: 'currency',
        currency: 'INR',
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    async function fetchSalesData(filter) {
      const response = await fetch(
        `/admin/sales-data?filter=${encodeURIComponent(filter)}`,
        {
          headers: {
            'Accept': 'application/json'
          }
        }
      );

      if (!response.ok) {
        throw new Error('Unable to retrieve sales data.');
      }

      const data = await response.json();

      if (!Array.isArray(data)) {
        throw new Error('The sales API returned an unexpected response.');
      }

      return data;
    }

    async function updateChart() {
      const filter = chartFilter.value;

      chartLoading.style.display = 'block';
      chartError.classList.add('d-none');
      chartEmpty.classList.add('d-none');
      chartArea.classList.add('d-none');

      try {
        const salesData = await fetchSalesData(filter);


        const labels = salesData.map(item => {
          if (filter === 'monthly') {
            const month = Number(item._id.month);
            const year = item._id.year;

            const date = new Date(year, month - 1, 1);

            return date.toLocaleDateString('en-IN', {
              month: 'short',
              year: 'numeric'
            });
          }

          return String(item._id.year);
        });

        const values = salesData.map(item =>
          Number(item.totalSales) || 0
        );

        const totalAmount = values.reduce(
          (sum, amount) => sum + amount,
          0
        );

        totalRevenue.textContent = formatCurrency(totalAmount);

        revenueDescription.textContent =
          filter === 'monthly'
            ? 'Sales across the returned months'
            : 'Sales across the returned years';

        if (myChart) {
          myChart.destroy();
          myChart = null;
        }

        chartLoading.style.display = 'none';

        if (salesData.length === 0) {
          chartEmpty.classList.remove('d-none');
          return;
        }

        chartArea.classList.remove('d-none');

        myChart = new Chart(chartCanvas, {
          type: 'bar',

          data: {
            labels,

            datasets: [{
              label: 'Sales',
              data: values,
              backgroundColor: 'rgba(25, 135, 84, 0.75)',
              hoverBackgroundColor: '#146c43',
              borderRadius: 6,
              borderSkipped: false,
              maxBarThickness: 48
            }]
          },

          options: {
            responsive: true,
            maintainAspectRatio: false,

            interaction: {
              intersect: false,
              mode: 'index'
            },

            plugins: {
              legend: {
                display: false
              },

              tooltip: {
                backgroundColor: '#202124',
                padding: 12,
                callbacks: {
                  label: context =>
                    'Sales: ' + formatCurrency(context.raw)
                }
              }
            },

            scales: {
              x: {
                grid: {
                  display: false
                },

                border: {
                  display: false
                },

                ticks: {
                  color: '#89919b',
                  maxRotation: 0
                }
              },

              y: {
                beginAtZero: true,

                border: {
                  display: false,
                  dash: [4, 4]
                },

                grid: {
                  color: '#edf0f2'
                },

                ticks: {
                  color: '#89919b',

                  callback: value => {
                    const amount = Number(value);

                    if (amount >= 100000) {
                      return '₹' +
                        (amount / 100000).toFixed(1) + 'L';
                    }

                    if (amount >= 1000) {
                      return '₹' +
                        (amount / 1000).toFixed(1) + 'K';
                    }

                    return '₹' + amount;
                  }
                }
              }
            }
          }
        });

      } catch (error) {
        
        chartLoading.style.display = 'none';
        chartArea.classList.add('d-none');

        totalRevenue.textContent = '—';
        revenueDescription.textContent = 'Sales data unavailable';

        chartError.textContent =
          'Could not load sales data. Please try changing the period or refreshing the page.';

        chartError.classList.remove('d-none');
      }
    }

    chartFilter.addEventListener('change', updateChart);

    updateChart();
  </script>

  <%- include('../partials/adminfooter') %>