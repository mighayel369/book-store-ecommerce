<%- include('../partials/adminHeader') %>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <style>
    .order-details-page {
      box-sizing: border-box;
      width: auto;
      max-width: 100%;
      min-width: 0;
      padding: 24px;
      color: #212529;
    }

    .order-details-page *,
    .order-details-page *::before,
    .order-details-page *::after {
      box-sizing: border-box;
    }

    .order-details-page .container-fluid {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      padding-left: 0;
      padding-right: 0;
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 24px;
    }

    .page-title {
      font-size: 26px;
      font-weight: 700;
      margin: 0;
    }

    .page-subtitle {
      color: #6c757d;
      font-size: 14px;
      margin: 6px 0 0;
    }

    .order-id-card {
      background: #fff;
      border: 1px solid #e9ecef;
      border-radius: 10px;
      padding: 14px 18px;
      max-width: 100%;
    }

    .order-id-card small {
      color: #6c757d;
    }

    .order-id-value {
      font-weight: 700;
      overflow-wrap: anywhere;
    }

    .order-details-page .row {
      min-width: 0;
      max-width: 100%;
    }

    .order-details-page .row>[class*="col-"] {
      min-width: 0;
    }

    .details-card {
      height: 100%;
      min-width: 0;
      background: #fff;
      border: 1px solid #e9ecef;
      border-radius: 12px;
      padding: 22px;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.035);
    }

    .details-card h6 {
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 18px;
    }

    .detail-label {
      font-size: 12px;
      color: #6c757d;
      margin-bottom: 3px;
    }

    .detail-label i {
      margin-right: 4px;
    }

    .detail-value {
      font-size: 14px;
      font-weight: 500;
      overflow-wrap: anywhere;
      margin-bottom: 13px;
    }

    .detail-value:last-child {
      margin-bottom: 0;
    }

    .status-badge {
      display: inline-block;
      border-radius: 20px;
      padding: 6px 12px;
      font-size: 12px;
      font-weight: 700;
      text-transform: capitalize;
      overflow-wrap: anywhere;
    }

    .status-pending {
      color: #856404;
      background: #fff3cd;
    }

    .status-confirmed {
      color: #055160;
      background: #cff4fc;
    }

    .status-shipped {
      color: #084298;
      background: #cfe2ff;
    }

    .status-delivered,
    .status-completed,
    .status-approved {
      color: #146c43;
      background: #d1e7dd;
    }

    .status-canceled,
    .status-cancelled,
    .status-rejected,
    .status-returned {
      color: #842029;
      background: #f8d7da;
    }

    .status-unknown {
      color: #41464b;
      background: #e2e3e5;
    }

    .section-card {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      background: #fff;
      border: 1px solid #e9ecef;
      border-radius: 12px;
      padding: 22px;
      margin-top: 24px;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.035);
    }

    .section-heading {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 4px;
    }

    .section-description {
      font-size: 13px;
      color: #6c757d;
      margin-bottom: 20px;
    }

    .status-update-card {
      border-left: 4px solid #0d6efd;
    }

    .status-icon {
      width: 48px;
      height: 48px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      background: #e7f1ff;
      color: #0d6efd;
      font-size: 23px;
    }

    #orderStatusSelect {
      min-height: 42px;
    }

    #updateOrderStatusBtn {
      min-height: 42px;
      white-space: nowrap;
    }

    #updateOrderStatusBtn:disabled {
      cursor: not-allowed;
      opacity: 0.65;
    }

    .order-details-page .table-responsive {
      display: block;
      width: 100%;
      max-width: 100%;
      min-width: 0;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
    }

    .products-table {
      width: 100%;
      min-width: 720px;
      vertical-align: middle;
      margin-bottom: 0;
      border-collapse: separate;
      border-spacing: 0;
    }

    .products-table thead th {
      background: #f8f9fa;
      color: #495057;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      padding: 14px 12px;
      white-space: nowrap;
      border-bottom: 1px solid #dee2e6;
    }

    .products-table tbody td {
      padding: 16px 12px;
      font-size: 13px;
      border-bottom: 1px solid #f0f0f0;
      vertical-align: middle;
    }

    .product-name {
      min-width: 150px;
      max-width: 240px;
      font-weight: 600;
      overflow-wrap: anywhere;
    }

    .price-cell {
      white-space: nowrap;
    }

    .return-box {
      width: 100%;
      min-width: 180px;
      max-width: 270px;
      padding: 12px;
      border: 1px solid #e9ecef;
      background: #f8f9fa;
      border-radius: 8px;
      text-align: left;
      white-space: normal;
    }

    .return-reason-label {
      font-size: 11px;
      color: #6c757d;
      font-weight: 700;
      text-transform: uppercase;
      margin-bottom: 5px;
    }

    .return-reason {
      font-size: 13px;
      margin: 0;
      overflow-wrap: anywhere;
    }

    .return-status-text {
      font-size: 12px;
      font-weight: 700;
      margin-top: 10px;
    }

    .return-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 12px;
    }

    .return-actions .btn {
      font-size: 12px;
    }

    .no-return {
      display: inline-block;
      padding: 6px 10px;
      border-radius: 6px;
      background: #f1f3f5;
      color: #6c757d;
      font-size: 12px;
      white-space: nowrap;
    }

    .order-summary {
      width: 100%;
      max-width: 360px;
      margin: 22px 0 0 auto;
      padding: 18px;
      border-radius: 10px;
      background: #f8f9fa;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      font-size: 14px;
      margin-bottom: 10px;
    }

    .summary-row span:last-child {
      font-weight: 600;
      text-align: right;
    }

    .summary-total {
      border-top: 1px solid #dee2e6;
      padding-top: 12px;
      margin-top: 12px;
      margin-bottom: 0;
      font-size: 17px;
      font-weight: 700;
    }

    @media (max-width: 767px) {
      .order-details-page {
        padding: 14px;
      }

      .details-card,
      .section-card {
        padding: 16px;
      }

      .page-title {
        font-size: 22px;
      }

      .order-summary {
        max-width: 100%;
      }
    }
  </style>

  <main class="order-details-page">
    <div class="container-fluid">

      <div class="page-header">
        <div>
          <h1 class="page-title">
            <i class="bi bi-receipt-cutoff me-2 text-primary"></i>
            Order Details
          </h1>
          <p class="page-subtitle">
            View order information, customer details, and return requests.
          </p>
        </div>

        <div class="order-id-card">
          <small>
            <i class="bi bi-hash me-1"></i> Order ID
          </small>
          <div class="order-id-value">
            <%= orderDetails.orderId %>
          </div>
        </div>
      </div>

      <div class="row g-3">

        <div class="col-12 col-md-6 col-xl-4">
          <div class="details-card">
            <h6>
              <i class="bi bi-person-vcard me-2 text-primary"></i>
              Customer Information
            </h6>

            <div class="detail-label">
              <i class="bi bi-person"></i> Customer Name
            </div>
            <div class="detail-value">
              <%= users.username || 'N/A' %>
            </div>

            <div class="detail-label">
              <i class="bi bi-envelope"></i> Email Address
            </div>
            <div class="detail-value">
              <%= users.email || 'N/A' %>
            </div>

            <div class="detail-label">
              <i class="bi bi-telephone"></i> Phone Number
            </div>
            <div class="detail-value">
              <%= users.phoneno || 'N/A' %>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
          <div class="details-card">
            <h6>
              <i class="bi bi-bag-check me-2 text-primary"></i>
              Order Information
            </h6>

            <div class="detail-label">
              <i class="bi bi-hash"></i> Order ID
            </div>
            <div class="detail-value">
              <%= orderDetails.orderId %>
            </div>

            <div class="detail-label">
              <i class="bi bi-credit-card"></i> Payment Method
            </div>
            <div class="detail-value">
              <%= orderDetails.paymentMethod || 'N/A' %>
            </div>

            <div class="detail-label">
              <i class="bi bi-box-seam"></i> Order Status
            </div>
            <div class="detail-value">
              <% const orderStatus=String(orderDetails.status || 'Unknown' ).toLowerCase(); %>
                <span class="status-badge <%= [
              'pending',
              'confirmed',
              'shipped',
              'delivered',
              'completed',
              'approved',
              'canceled',
              'cancelled',
              'rejected',
              'returned'
            ].includes(orderStatus) ? 'status-' + orderStatus : 'status-unknown' %>">
                  <%= orderDetails.status || 'Unknown' %>
                </span>
            </div>

            <div class="detail-label">
              <i class="bi bi-wallet2"></i> Payment Status
            </div>
            <div class="detail-value">
              <span
                class="status-badge <%= orderDetails.paymentStatus === 'Completed' ? 'status-completed' : 'status-pending' %>">
                <%= orderDetails.paymentStatus || 'Pending' %>
              </span>
            </div>
          </div>
        </div>

        <div class="col-12 col-xl-4">
          <div class="details-card">
            <h6>
              <i class="bi bi-geo-alt me-2 text-primary"></i>
              Delivery Address
            </h6>

            <div class="detail-label">
              <i class="bi bi-house-door"></i> House / Building
            </div>
            <div class="detail-value">
              <%= orderDetails.shippingAddress?.houseno || 'N/A' %>
            </div>

            <div class="detail-label">
              <i class="bi bi-signpost-2"></i> Area and Landmark
            </div>
            <div class="detail-value">
              <%= orderDetails.shippingAddress?.area || 'N/A' %>
                <% if (orderDetails.shippingAddress?.landmark) { %>
                  , <%= orderDetails.shippingAddress.landmark %>
                    <% } %>
            </div>

            <div class="detail-label">
              <i class="bi bi-buildings"></i> Town / State
            </div>
            <div class="detail-value">
              <%= orderDetails.shippingAddress?.town || 'N/A' %>
                <% if (orderDetails.shippingAddress?.state) { %>
                  , <%= orderDetails.shippingAddress.state %>
                    <% } %>
            </div>

            <div class="detail-label">
              <i class="bi bi-mailbox"></i> PIN Code
            </div>
            <div class="detail-value">
              <%= orderDetails.shippingAddress?.pincode || 'N/A' %>
            </div>
          </div>
        </div>

      </div>

      <div class="section-card status-update-card">
        <div class="d-flex align-items-start gap-3 flex-wrap">

          <div class="status-icon">
            <i class="bi bi-truck"></i>
          </div>

          <div class="flex-grow-1">
            <h5 class="section-heading">Update Order Status</h5>
            <p class="section-description mb-3">
              Change the delivery progress for this order.
            </p>

            <div class="row g-3 align-items-end">
              <div class="col-12 col-md-6 col-lg-4">
                <label for="orderStatusSelect" class="form-label fw-semibold">
                  <i class="bi bi-arrow-repeat me-1"></i>
                  Select Status
                </label>

                <select id="orderStatusSelect" class="form-select">
                  <% const availableStatuses=[ 'Pending' , 'Confirmed' , 'Shipped' , 'Delivered' , 'Canceled' ]; %>

                    <% availableStatuses.forEach(status=> { %>
                      <option value="<%= status %>" <%=orderDetails.status===status ? 'selected' : '' %>>
                        <%= status %>
                      </option>
                      <% }) %>
                </select>
              </div>

              <div class="col-12 col-md-auto">
                <button type="button" id="updateOrderStatusBtn" class="btn btn-primary">
                  <i class="bi bi-check2-circle me-2"></i>
                  Update Status
                </button>
              </div>
            </div>

            <small class="text-muted d-block mt-3">
              <i class="bi bi-info-circle me-1"></i>
              Canceled or returned products should not be changed by a general
              order status update.
            </small>
          </div>
        </div>
      </div>

      <div class="section-card">
        <h5 class="section-heading">
          <i class="bi bi-bag me-2 text-primary"></i>
          Ordered Products
        </h5>

        <p class="section-description">
          Product pricing, quantities, and return request status.
        </p>

        <div class="table-responsive">
          <table class="table products-table text-center">
            <thead>
              <tr>
                <th>Product</th>
                <th>Unit Price</th>
                <th>Quantity</th>
                <th>Subtotal</th>
                <th>Order Status</th>
                <th>Reason</th>
              </tr>
            </thead>

            <tbody>
              <% orderDetails.products.forEach(product=> { %>
                <% const originalPrice=Number(product.productprice || 0); const
                  discountPrice=Number(product.discountPrice || 0); const unitPrice=discountPrice> 0 && discountPrice <
                    originalPrice ? discountPrice : originalPrice; const quantity=Number(product.quantity || 0); const
                    subtotal=unitPrice * quantity; const productStatus=String(product.orderStatus || 'Unknown' ); const
                    isCanceled=productStatus==='Canceled' ; const isReturned=productStatus==='Returned' ; %>

                    <tr>
                      <td class="product-name text-start">
                        <%= product.productName %>
                      </td>

                      <td class="price-cell">
                        <% if (unitPrice < originalPrice) { %>
                          <del class="text-muted">
                            ₹<%= originalPrice.toFixed(2) %>
                          </del>
                          <br>
                          <% } %>
                            ₹<%= unitPrice.toFixed(2) %>
                      </td>

                      <td>
                        <%= quantity %>
                      </td>

                      <td class="price-cell fw-bold">
                        ₹<%= subtotal.toFixed(2) %>
                      </td>

                      <td>
                        <span class="status-badge status-<%= productStatus.toLowerCase() %>">
                          <%= productStatus %>
                        </span>
                      </td>

                      <td>
                        <% if (isCanceled) { %>

                          <div class="return-box">
                            <div class="return-reason-label">
                              <i class="bi bi-x-circle me-1"></i>
                              Cancellation Reason
                            </div>
                            <p class="return-reason">
                              <%= product.reason || 'No cancellation reason provided' %>
                            </p>
                          </div>

                          <% } else if (isReturned || product.returnRequest) { %>

                            <div class="return-box">
                              <div class="return-reason-label">
                                <i class="bi bi-arrow-return-left me-1"></i>
                                Return Reason
                              </div>

                              <p class="return-reason">
                                <%= product.reason || 'No return reason provided' %>
                              </p>

                              <div class="return-status-text">
                                Request: <%= product.returnRequest || 'N/A' %>
                              </div>

                              <% if (product.returnRequest==='Pending' ) { %>
                                <div class="return-actions">
                                  <button type="button" class="btn btn-success btn-sm" onclick="handleReturn(
                    '<%= orderDetails._id %>',
                    '<%= product.productId %>',
                    'approve'
                  )">
                                    <i class="bi bi-check-circle me-1"></i>
                                    Approve
                                  </button>

                                  <button type="button" class="btn btn-outline-danger btn-sm" onclick="handleReturn(
                    '<%= orderDetails._id %>',
                    '<%= product.productId %>',
                    'reject'
                  )">
                                    <i class="bi bi-x-circle me-1"></i>
                                    Reject
                                  </button>
                                </div>
                                <% } %>
                            </div>

                            <% } else { %>

                              <span class="no-return">N/A</span>

                              <% } %>
                      </td>
                    </tr>
                    <% }) %>
            </tbody>
          </table>
        </div>

        <div class="order-summary">
          <div class="summary-row">
            <span>
              <i class="bi bi-box-seam me-1"></i>
              Products
            </span>
            <span>
              <%= orderDetails.products.length %>
            </span>
          </div>

          <div class="summary-row summary-total">
            <span>
              <i class="bi bi-currency-rupee me-1"></i>
              Order Total
            </span>
            <span>
              ₹<%= Number(orderDetails.totalAmount || 0).toLocaleString('en-IN') %>
            </span>
          </div>
        </div>
      </div>

    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const statusSelect = document.getElementById('orderStatusSelect');
      const updateButton = document.getElementById('updateOrderStatusBtn');

      const orderMongoId = '<%= orderDetails._id %>';

      const updateUrl = '/admin/update-order-status';

      const originalStatus = statusSelect.value;

      updateButton.addEventListener('click', async () => {
        const newStatus = statusSelect.value;

        if (newStatus === originalStatus) {
          await Swal.fire({
            icon: 'info',
            title: 'No changes',
            text: 'The selected status is already set for this order.'
          });
          return;
        }



        const result = await Swal.fire({
          title: 'Update order status?',
          text: `Change the order status to ${newStatus}?`,
          icon: 'question',
          showCancelButton: true,
          confirmButtonText: 'Yes, update',
          cancelButtonText: 'Cancel',
          confirmButtonColor: '#0d6efd'
        });

        if (!result.isConfirmed) return;

        updateButton.disabled = true;
        updateButton.innerHTML =
          '<span class="spinner-border spinner-border-sm me-2"></span>Updating...';

        try {
          const response = await fetch(updateUrl, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            credentials: 'same-origin',
            body: JSON.stringify({
              orderId: orderMongoId,
              status: newStatus
            })
          });

          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.message || 'Unable to update order status.');
          }

          await Swal.fire({
            icon: 'success',
            title: 'Status updated',
            text: data.message || 'Order status updated successfully.',
            confirmButtonColor: '#198754'
          });

          window.location.reload();

        } catch (error) {
          await Swal.fire({
            icon: 'error',
            title: 'Update failed',
            text: error.message || 'Something went wrong.'
          });

          updateButton.disabled = false;
          updateButton.innerHTML =
            '<i class="bi bi-check2-circle me-2"></i>Update Status';
        }
      });
    });

    function handleReturn(orderId, productId, action) {
      const isApprove = action === 'approve';

      Swal.fire({
        title: isApprove ? 'Approve return request?' : 'Reject return request?',
        text: isApprove
          ? 'The return request will be approved.'
          : 'The return request will be rejected.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: isApprove ? '#198754' : '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: isApprove ? 'Yes, approve' : 'Yes, reject',
        cancelButtonText: 'Go back'
      }).then((result) => {
        if (result.isConfirmed) {
          const url = isApprove
            ? `/admin/approve/${encodeURIComponent(orderId)}/product/${encodeURIComponent(productId)}`
            : `/admin/reject/${encodeURIComponent(orderId)}/product/${encodeURIComponent(productId)}`;

          window.location.href = url;
        }
      });
    }
  </script>

  <%- include('../partials/adminfooter') %>