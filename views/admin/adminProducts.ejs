<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Product Management | Shoe Rack</title>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    .product-page {
      background: #f5f6f8;
      min-height: 80vh;
      padding: 32px 0 50px;
    }

    .page-heading {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 18px;
      margin-bottom: 25px;
    }

    .page-heading h2 {
      font-size: 26px;
      font-weight: 700;
      color: #202020;
      margin: 0 0 7px;
    }

    .page-heading p {
      color: #777;
      font-size: 14px;
      margin: 0;
    }

    .add-product-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 11px 18px;
      background: #222;
      color: #fff;
      border: 1px solid #222;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      transition: 0.2s;
    }

    .add-product-btn:hover {
      background: #444;
      color: #fff;
    }

    .product-summary {
      display: flex;
      align-items: center;
      gap: 15px;
      padding: 20px 22px;
      background: #fff;
      border: 1px solid #e8e8e8;
      border-radius: 12px;
      margin-bottom: 24px;
    }

    .summary-icon {
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f0f0f0;
      color: #222;
      font-size: 20px;
      border-radius: 10px;
      flex-shrink: 0;
    }

    .summary-label {
      color: #777;
      font-size: 13px;
      margin-bottom: 4px;
    }

    .summary-value {
      color: #222;
      font-size: 25px;
      font-weight: 700;
      margin: 0;
    }

    .product-card {
      background: #fff;
      border: 1px solid #e8e8e8;
      border-radius: 12px;
      overflow: hidden;
    }

    .table-header {
      padding: 20px 22px;
      border-bottom: 1px solid #eee;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    .table-header h5 {
      font-size: 16px;
      font-weight: 700;
      margin: 0 0 5px;
    }

    .table-header p {
      color: #888;
      font-size: 12px;
      margin: 0;
    }

    .product-search {
      max-width: 280px;
      width: 100%;
      position: relative;
    }

    .product-search i {
      position: absolute;
      left: 13px;
      top: 50%;
      transform: translateY(-50%);
      color: #888;
      font-size: 13px;
    }

    .product-search input {
      width: 100%;
      padding: 10px 12px 10px 35px;
      border: 1px solid #ddd;
      border-radius: 8px;
      outline: none;
      font-size: 13px;
    }

    .product-search input:focus {
      border-color: #777;
      box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.04);
    }

    .product-table {
      margin: 0;
      min-width: 850px;
    }

    .product-table thead th {
      padding: 15px 17px;
      background: #f8f9fa;
      color: #777;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      white-space: nowrap;
      border-bottom: 1px solid #eee;
    }

    .product-table tbody td {
      padding: 15px 17px;
      vertical-align: middle;
      border-bottom: 1px solid #f0f0f0;
      font-size: 13px;
    }

    .product-table tbody tr:last-child td {
      border-bottom: none;
    }

    .product-table tbody tr:hover {
      background: #fafafa;
    }

    .product-number {
      color: #888;
      font-size: 12px;
    }

    .product-image {
      width: 62px;
      height: 62px;
      object-fit: contain;
      padding: 4px;
      background: #fff;
      border: 1px solid #eee;
      border-radius: 9px;
    }

    .product-image-placeholder {
      width: 62px;
      height: 62px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #f3f4f6;
      color: #999;
      border-radius: 9px;
      font-size: 20px;
    }

    .product-name {
      font-size: 13px;
      font-weight: 700;
      color: #222;
      min-width: 130px;
      overflow-wrap: anywhere;
    }

    .product-id {
      color: #999;
      font-family: monospace;
      font-size: 11px;
      margin-top: 5px;
    }

    .category-badge {
      display: inline-block;
      padding: 6px 10px;
      border-radius: 6px;
      background: #f0f0f0;
      color: #444;
      font-size: 11px;
      font-weight: 600;
      white-space: nowrap;
    }

    .product-price {
      font-weight: 700;
      color: #222;
      white-space: nowrap;
    }

    .stock-badge {
      display: inline-block;
      padding: 6px 9px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 700;
      white-space: nowrap;
    }

    .stock-in {
      background: #e8f7ee;
      color: #187744;
    }

    .stock-low {
      background: #fff4dc;
      color: #936200;
    }

    .stock-out {
      background: #fdeaea;
      color: #b42318;
    }

    .action-buttons {
      display: flex;
      justify-content: left;
      align-items: center;
      gap: 8px;
    }

    .action-btn {
      width: 35px;
      height: 35px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #e5e5e5;
      border-radius: 8px;
      background: #fff;
      cursor: pointer;
      text-decoration: none;
      transition: 0.2s;
    }

    .edit-btn {
      color: #444;
    }

    .edit-btn:hover {
      background: #f3f4f6;
      color: #111;
    }

    .delete-btn {
      color: #dc3545;
    }

    .delete-btn:hover {
      background: #fff1f2;
      border-color: #fecdd3;
      color: #b91c1c;
    }

    .empty-state {
      text-align: center;
      padding: 55px 20px !important;
    }

    .empty-state i {
      font-size: 38px;
      color: #aaa;
      margin-bottom: 14px;
    }

    .empty-state h6 {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 7px;
    }

    .empty-state p {
      color: #888;
      font-size: 13px;
      margin-bottom: 18px;
    }

    .no-results {
      display: none;
      text-align: center;
      color: #777;
      font-size: 13px;
      padding: 28px 15px;
    }

    @media (max-width: 576px) {
      .product-page {
        padding-top: 22px;
      }

      .page-heading h2 {
        font-size: 22px;
      }

      .add-product-btn {
        width: 100%;
      }

      .product-search {
        max-width: 100%;
      }

      .table-header {
        padding: 17px;
      }
    }
  </style>
</head>

<body>

  <%- include('../partials/adminHeader') %>

    <main class="product-page">
      <div class="container">

        <% if (adminmessage) { %>
          <div id="flash-message" hidden data-message="<%= adminmessage.message %>"
            data-type="<%= adminmessage.type || 'success' %>">
          </div>
          <% } %>

            <div class="page-heading">
              <div>
                <h2>Product Management</h2>
                <p>Manage your shoe inventory, prices, and stock levels.</p>
              </div>

              <a href="/admin/addproduct" class="add-product-btn">
                <i class="fa-solid fa-plus"></i>
                Add Product
              </a>
            </div>

            <div class="product-summary">
              <div class="summary-icon">
                <i class="fa-solid fa-shoe-prints"></i>
              </div>

              <div>
                <div class="summary-label">Total Products</div>
                <p class="summary-value">
                  <%= products.length %>
                </p>
              </div>
            </div>

            <section class="product-card">

              <div class="table-header">
                <div>
                  <h5>All Products</h5>
                  <p>View and manage products in your store.</p>
                </div>

              </div>

              <div class="table-responsive">
                <table class="table product-table text-center" id="table-data">
                  <thead>
                    <tr>
                      <th>No.</th>
                      <th>Product</th>
                      <th>Image</th>
                      <th>Category</th>
                      <th>Price</th>
                      <th>Stock</th>
                      <th>Actions</th>
                    </tr>
                  </thead>

                  <tbody id="productTableBody">

                    <% if (products.length> 0) { %>

                      <% products.forEach((element, index)=> { %>
                        <tr class="product-row">

                          <td>
                            <span class="product-number">
                              <%= index + 1 %>
                            </span>
                          </td>

                          <td>
                            <div class="product-name">
                              <%= element.productname %>
                            </div>
                            <div class="product-id">
                              ID: <%= String(element._id).slice(-8) %>
                            </div>
                          </td>

                          <td>
                            <% if (element.image && element.image.length> 0 && element.image[0]) { %>
                              <img src="<%= element.image[0] %>" alt="<%= element.productname %>" class="product-image"
                                loading="lazy"
                                onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';">

                              <span class="product-image-placeholder" style="display:none;">
                                <i class="fa-solid fa-image"></i>
                              </span>
                              <% } else { %>
                                <span class="product-image-placeholder">
                                  <i class="fa-solid fa-image"></i>
                                </span>
                                <% } %>
                          </td>

                          <td>
                            <% if (element.productcategory && element.productcategory.categoryname) { %>
                              <span class="category-badge">
                                <%= element.productcategory.categoryname %>
                              </span>
                              <% } else { %>
                                <span class="text-muted">Uncategorized</span>
                                <% } %>
                          </td>

                          <td>
                            <span class="product-price">
                              <%= new Intl.NumberFormat('en-IN', { style: 'currency' , currency: 'INR' ,
                                maximumFractionDigits: 2 }).format(element.productprice) %>
                            </span>
                          </td>

                          <td>
                            <% if (element.stockqty <=0) { %>
                              <span class="stock-badge stock-out">Out of stock</span>
                              <% } else if (element.stockqty <=5) { %>
                                <span class="stock-badge stock-low">
                                  Low stock: <%= element.stockqty %>
                                </span>
                                <% } else { %>
                                  <span class="stock-badge stock-in">
                                    In stock: <%= element.stockqty %>
                                  </span>
                                  <% } %>
                          </td>

                          <td>
                            <div class="action-buttons">
                              <a href="/admin/editproduct/<%= element._id %>" class="action-btn edit-btn"
                                title="Edit product" aria-label="Edit product">
                                <i class="fa-solid fa-pen-to-square"></i>
                              </a>

                              <button type="button" class="action-btn delete-btn" title="Delete product"
                                aria-label="Delete product" onclick="deleteProduct('<%= element._id %>')">
                                <i class="fa-solid fa-trash"></i>
                              </button>
                            </div>
                          </td>

                        </tr>
                        <% }) %>

                          <% } else { %>
                            <tr>
                              <td colspan="7" class="empty-state">
                                <i class="fa-solid fa-box-open d-block"></i>
                                <h6>No products found</h6>
                                <p>Add your first shoe product to get started.</p>
                                <a href="/admin/addproduct" class="add-product-btn">
                                  <i class="fa-solid fa-plus"></i>
                                  Add Product
                                </a>
                              </td>
                            </tr>
                            <% } %>

                  </tbody>
                </table>

                <div class="no-results" id="noResults">
                  <i class="fa-solid fa-magnifying-glass me-2"></i>
                  No products match your search.
                </div>
              </div>
            </section>

      </div>
    </main>

    <script>

      const flashMessage = document.getElementById('flash-message');

      if (flashMessage && typeof Swal !== 'undefined') {
        const message = flashMessage.dataset.message;
        const type = flashMessage.dataset.type;

        const icon = type === 'danger'
          ? 'error'
          : ['success', 'error', 'warning', 'info', 'question'].includes(type)
            ? type
            : 'info';

        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: icon,
          title: message,
          showConfirmButton: false,
          timer: 2500,
          timerProgressBar: true
        });
      }


      function deleteProduct(productId) {
        Swal.fire({
          title: 'Delete this product?',
          text: 'This action may permanently remove the product from your store.',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#dc3545',
          cancelButtonColor: '#6b7280',
          confirmButtonText: 'Yes, delete it',
          cancelButtonText: 'Cancel',
          reverseButtons: true,
          focusCancel: true
        }).then((result) => {
          if (result.isConfirmed) {
            window.location.href =
              `/admin/deleteproduct/${encodeURIComponent(productId)}`;
          }
        });
      }


      const productRows = document.querySelectorAll('.product-row');
      const noResults = document.getElementById('noResults');
    </script>

    <%- include('../partials/adminfooter') %>

</body>

</html>