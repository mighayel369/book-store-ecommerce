<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shoe Rack</title>
  <link rel="stylesheet" href="path/to/your/css/styles.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
</head>

<body>

  <%- include('../partials/adminHeader') %>
    <main>
      <div class="container">
        <% if (adminmessage) { %>
          <div class="alert m-4 alert-dismissible fade show alert-<%= adminmessage.type %>" role="alert">
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            <strong>
              <%= adminmessage.message %>
            </strong>
          </div>
          <% } %>
            <div class="d-flex justify-content-end m-5">
              <h3 class="me-auto">Product Management</h3>
              <a href="/admin/addproduct" class="btn btn-dark">Add Product</a>
            </div>
            <div class="row m-4">
              <div class="col-lg-12">
                <div class="table-responsive">
                  <table class="table table-striped text-center" id="table-data">
                    <thead>
                      <tr class="table-dark">
                        <th class="text-center">Id</th>
                        <th class="text-center">Name</th>
                        <th class="text-center">Image</th>
                        <th class="text-center">Category</th>
                        <th class="text-center">Price</th>
                        <th class="text-center">Stock Qty</th>
                        <th class="text-center">Action</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% products.forEach((element,index)=> { %>
                        <tr>
                          <td class="text-center">
                            <%= index %>
                          </td>
                          <td class="text-center">
                            <%= element.productname %>
                          </td>
                          <td class="text-center"><img src="<%= element.image[0] %>" width="50px" height="50px"
                              class="img-thumbnail"></td>
                          <td class="text-center">
                            <%= element.productcategory?.categoryname %>
                          </td>
                          <td class="text-center">
                            <%= element.productprice %>
                          </td>
                          <td class="text-center">
                            <%= element.stockqty %>
                          </td>
                          <td class="text-center">
                            <a href="/admin/editproduct/<%= element._id %>" class="text-muted m-2"><i
                                class="fa-solid fa-pen-to-square"></i></a>
                            <a href='#' class="text-muted" onclick="deleteProduct('<%= element._id %>')"><i
                                class="fa-solid fa-trash"></i></a>
                          </td>
                        </tr>
                        <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
      </div>
    </main>
    <script>
      function deleteProduct(userid) {
        let url = `/admin/deleteproduct/${userid}`
        Swal.fire({
          title: `Are you sure you want to delete`,
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#3085d6',
          cancelButtonColor: '#d33',
          confirmButtonText: 'Yes'
        }).then((result) => {
          if (result.isConfirmed) {
            window.location.href = url;
          }
        });
      }
    </script>
</body>
<%- include('../partials/adminfooter') %>

</html>