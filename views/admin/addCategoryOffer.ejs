<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Shoe Rack | Category Offer</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    body {
      background-color: #f7f8fa;
    }

    .offer-page {
      padding: 35px 15px 60px;
    }

    .page-heading {
      margin-bottom: 25px;
    }

    .page-heading h3 {
      font-size: 27px;
      font-weight: 700;
      color: #212529;
      margin-bottom: 6px;
    }

    .page-heading p {
      color: #777;
      margin-bottom: 0;
      font-size: 14px;
    }

    .offer-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 25px;
      align-items: start;
    }

    .offer-panel {
      background-color: #fff;
      border: 1px solid #e9ecef;
      border-radius: 10px;
      padding: 28px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
      min-width: 0;
    }

    .panel-heading {
      font-size: 20px;
      font-weight: 700;
      color: #212529;
      margin-bottom: 8px;
    }

    .panel-subtitle {
      color: #777;
      font-size: 13px;
      margin-bottom: 24px;
    }

    .category-summary {
      background-color: #f8f9fa;
      border-radius: 8px;
      padding: 15px;
      margin-bottom: 25px;
    }

    .summary-label {
      display: block;
      color: #777;
      font-size: 12px;
      margin-bottom: 5px;
    }

    .summary-value {
      font-weight: 700;
      color: #212529;
      font-size: 16px;
      overflow-wrap: anywhere;
    }

    .current-banner {
      width: 100%;
      height: 210px;
      object-fit: contain;
      background-color: #f4f5f6;
      border-radius: 8px;
      margin-bottom: 22px;
    }

    .no-banner {
      height: 150px;
      display: flex;
      justify-content: center;
      align-items: center;
      background-color: #f4f5f6;
      border-radius: 8px;
      margin-bottom: 22px;
      color: #777;
      font-size: 14px;
    }

    .offer-description {
      color: #555;
      line-height: 1.6;
      overflow-wrap: anywhere;
      margin-bottom: 20px;
    }

    .status-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 18px;
      padding-bottom: 14px;
      border-bottom: 1px solid #eee;
    }

    .status-row:last-child {
      border-bottom: none;
      margin-bottom: 0;
    }

    .status-label {
      color: #777;
      font-size: 13px;
    }

    .status-value {
      font-size: 13px;
      font-weight: 700;
      text-align: right;
      overflow-wrap: anywhere;
    }

    .badge-active {
      color: #166534;
      background-color: #dcfce7;
      padding: 6px 11px;
      border-radius: 20px;
    }

    .badge-inactive {
      color: #991b1b;
      background-color: #fee2e2;
      padding: 6px 11px;
      border-radius: 20px;
    }

    .form-label {
      font-size: 13px;
      font-weight: 600;
      color: #343a40;
    }

    .form-control,
    .form-select {
      border-radius: 6px;
      min-height: 45px;
    }

    textarea.form-control {
      min-height: 110px;
      resize: vertical;
    }

    .form-control:focus,
    .form-select:focus {
      border-color: #6c757d;
      box-shadow: 0 0 0 0.15rem rgba(33, 37, 41, 0.12);
    }

    .form-text {
      font-size: 12px;
      color: #777;
    }

    .offer-value-help {
      font-size: 12px;
      color: #777;
      margin-top: 6px;
    }

    .submit-button {
      width: 100%;
      padding: 13px 15px;
      background-color: #212529;
      color: #fff;
      border: 1px solid #212529;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 700;
      transition: 0.2s ease;
    }

    .submit-button:hover {
      background-color: #fff;
      color: #212529;
    }

    .back-button {
      display: inline-block;
      text-decoration: none;
      color: #212529;
      border: 1px solid #dee2e6;
      border-radius: 6px;
      padding: 9px 14px;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 20px;
      background-color: #fff;
    }

    .back-button:hover {
      background-color: #f1f3f5;
      color: #212529;
    }

    .message-text {
      color: #dc3545;
      font-size: 13px;
      margin-bottom: 15px;
    }

    @media (max-width: 900px) {
      .offer-layout {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    @media (max-width: 576px) {
      .offer-page {
        padding: 20px 12px 35px;
      }

      .page-heading h3 {
        font-size: 23px;
      }

      .offer-panel {
        padding: 20px 16px;
      }

      .current-banner {
        height: 170px;
      }

      .status-row {
        align-items: flex-start;
      }
    }
  </style>
</head>

<body>

  <%- include('../partials/adminHeader') %>

    <main>
      <div class="container-fluid offer-page">

        <a href="/admin/offers" class="back-button">
          &larr; Back to Category Offers
        </a>

        <div class="page-heading">
          <h3>Category Offer Management</h3>
          <p>View the current offer and create a discount for this category.</p>
        </div>

        <% if (typeof adminmessage !=='undefined' && adminmessage) { %>
          <div id="flash-message" hidden data-message="<%= adminmessage.message %>"
            data-type="<%= adminmessage.type || 'success' %>">
          </div>
          <% } %>

            <div class="offer-layout">

              <section class="offer-panel">

                <h4 class="panel-heading">Current Category Offer</h4>

                <p class="panel-subtitle">
                  Details of the offer currently saved for this category.
                </p>

                <div class="category-summary">
                  <span class="summary-label">Category Name</span>

                  <span class="summary-value">
                    <%= category.categoryname %>
                  </span>
                </div>

                <% if ( category.offer && ( category.offer.isOfferActive || category.offer.discountType ||
                  category.offer.discountValue ) ) { %>

                  <% if (category.offer.bannerImage) { %>

                    <img src="/offerBannerImages/<%= category.offer.bannerImage %>" alt="Current category offer banner"
                      class="current-banner" onerror="this.style.display='none';">

                    <% } else { %>

                      <div class="no-banner">
                        No offer banner available
                      </div>

                      <% } %>

                        <h5 class="fw-bold mb-3">Offer Information</h5>

                        <p class="offer-description">
                          <%= category.offer.offerDescription || 'No description provided.' %>
                        </p>

                        <div class="status-row">
                          <span class="status-label">Offer Status</span>

                          <span class="status-value">
                            <span class="<%= category.offer.isOfferActive ? 'badge-active' : 'badge-inactive' %>">
                              <%= category.offer.isOfferActive ? 'Active' : 'Inactive' %>
                            </span>
                          </span>
                        </div>

                        <div class="status-row">
                          <span class="status-label">Discount Type</span>

                          <span class="status-value">
                            <%= category.offer.discountType==='percentage' ? 'Percentage' :
                              category.offer.discountType==='fixed' ? 'Fixed Amount' : 'Not specified' %>
                          </span>
                        </div>

                        <div class="status-row">
                          <span class="status-label">Discount Value</span>

                          <span class="status-value text-danger">
                            <% if (category.offer.discountValue !==undefined && category.offer.discountValue !==null) {
                              %>

                              <%= category.offer.discountType==='percentage' ? category.offer.discountValue + '%' :
                                category.offer.discountType==='fixed' ? '₹' + category.offer.discountValue :
                                category.offer.discountValue %>

                                <% } else { %>
                                  Not specified
                                  <% } %>
                          </span>
                        </div>

                        <div class="status-row">
                          <span class="status-label">Start Date</span>

                          <span class="status-value">
                            <%= category.offer.startDate ? new
                              Date(category.offer.startDate).toISOString().split('T')[0] : 'Not specified' %>
                          </span>
                        </div>

                        <div class="status-row">
                          <span class="status-label">End Date</span>

                          <span class="status-value">
                            <%= category.offer.endDate ? new Date(category.offer.endDate).toISOString().split('T')[0]
                              : 'Not specified' %>
                          </span>
                        </div>

                        <% } else { %>

                          <div class="no-banner">
                            No offer has been created for this category yet.
                          </div>

                          <p class="text-muted mb-0" style="font-size: 13px;">
                            Use the form to create the first offer for this category.
                          </p>

                          <% } %>

              </section>

              <section class="offer-panel">

                <h4 class="panel-heading">
                  <%= category.offer && category.offer.isOfferActive ? 'Create Replacement Offer' : 'Create New Offer'
                    %>
                </h4>

                <p class="panel-subtitle">
                  Enter the discount details and upload an optional offer banner.
                </p>

                <form action="/admin/offers/addoffer" method="POST" enctype="multipart/form-data" id="formOffer"
                  data-has-active-offer="<%= Boolean(category.offer && category.offer.isOfferActive) %>">

                  <div class="mb-3">
                    <label for="offerType" class="form-label">
                      Offer Type
                    </label>

                    <select class="form-select" id="offerType" name="offerType" required>

                      <option value="percentage">Percentage Discount</option>
                      <option value="fixed">Fixed Amount Discount</option>

                    </select>
                  </div>

                  <div class="mb-3">
                    <label for="offerValue" class="form-label">
                      Discount Value
                    </label>

                    <input type="number" class="form-control" id="offerValue" name="offerValue"
                      placeholder="Enter discount value" min="0.01" step="0.01" required>

                    <div class="offer-value-help" id="offerValueHelp">
                      Enter a percentage between 0 and 100.
                    </div>
                  </div>

                  <div class="mb-3">
                    <label for="startDate" class="form-label">
                      Offer Start Date
                    </label>

                    <input type="date" class="form-control" id="startDate" name="startDate" required>
                  </div>

                  <div class="mb-3">
                    <label for="endDate" class="form-label">
                      Offer End Date
                    </label>

                    <input type="date" class="form-control" id="endDate" name="endDate" required>
                  </div>

                  <div class="mb-3">
                    <label for="offerDescription" class="form-label">
                      Offer Description
                    </label>

                    <textarea class="form-control" id="offerDescription" name="offerDescription"
                      placeholder="Describe the category offer" maxlength="500" required></textarea>
                  </div>

                  <div class="mb-4">
                    <label for="image" class="form-label">
                      Offer Banner Image
                    </label>

                    <input type="file" class="form-control" id="image" name="image"
                      accept="image/jpeg,image/png,image/webp">

                    <div class="form-text">
                      Optional. Supported formats: JPG, PNG and WebP.
                    </div>
                  </div>

                  <input type="hidden" name="categoryId" value="<%= category._id %>">

                  <button type="submit" class="submit-button">
                    <%= category.offer && category.offer.isOfferActive ? 'Create Replacement Offer'
                      : 'Create Category Offer' %>
                  </button>

                </form>

              </section>

            </div>
      </div>
    </main>

    <%- include('../partials/adminfooter') %>

      <script>
        $(document).ready(function () {

          const form = document.getElementById('formOffer');
          const isOfferActive = form.dataset.hasActiveOffer === 'true';

          const offerType = document.getElementById('offerType');
          const offerValue = document.getElementById('offerValue');
          const offerValueHelp = document.getElementById('offerValueHelp');
          const startDate = document.getElementById('startDate');
          const endDate = document.getElementById('endDate');
          const imageInput = document.getElementById('image');

          const today = new Date();
          const localToday = [
            today.getFullYear(),
            String(today.getMonth() + 1).padStart(2, '0'),
            String(today.getDate()).padStart(2, '0')
          ].join('-');

          startDate.min = localToday;
          endDate.min = localToday;

          startDate.addEventListener('change', function () {
            endDate.min = this.value || localToday;

            if (endDate.value && endDate.value < this.value) {
              endDate.value = '';
            }
          });

          function updateOfferValueRules() {
            if (offerType.value === 'percentage') {
              offerValue.min = '0.01';
              offerValue.max = '100';
              offerValue.step = '0.01';

              offerValueHelp.textContent =
                'Enter a percentage greater than 0 and up to 100.';
            } else {
              offerValue.min = '0.01';
              offerValue.removeAttribute('max');
              offerValue.step = '0.01';

              offerValueHelp.textContent =
                'Enter a fixed discount amount in rupees. It cannot exceed the product price when applied.';
            }
          }

          offerType.addEventListener('change', updateOfferValueRules);

          updateOfferValueRules();

          imageInput.addEventListener('change', function () {
            const file = this.files[0];

            if (!file) return;

            const allowedTypes = [
              'image/jpeg',
              'image/png',
              'image/webp'
            ];

            if (!allowedTypes.includes(file.type)) {
              this.value = '';

              Swal.fire({
                title: 'Invalid Image',
                text: 'Please upload a JPG, PNG or WebP image.',
                icon: 'error'
              });
            }
          });

          form.addEventListener('submit', function (event) {
            const value = Number(offerValue.value);

            if (!Number.isFinite(value) || value <= 0) {
              event.preventDefault();

              Swal.fire({
                title: 'Invalid Discount',
                text: 'Please enter a discount value greater than zero.',
                icon: 'error'
              });

              return;
            }

            if (offerType.value === 'percentage' && value > 100) {
              event.preventDefault();

              Swal.fire({
                title: 'Invalid Percentage',
                text: 'A percentage discount cannot exceed 100%.',
                icon: 'error'
              });

              return;
            }

            if (startDate.value < localToday) {
              event.preventDefault();

              Swal.fire({
                title: 'Invalid Start Date',
                text: 'The start date cannot be in the past.',
                icon: 'error'
              });

              return;
            }

            if (endDate.value < startDate.value) {
              event.preventDefault();

              Swal.fire({
                title: 'Invalid Date Range',
                text: 'The end date must be on or after the start date.',
                icon: 'error'
              });

              return;
            }

            if (isOfferActive) {
              event.preventDefault();

              Swal.fire({
                title: 'Replace Existing Offer?',
                text: 'This category already has an active offer. Are you sure you want to replace it?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#212529',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, Replace Offer',
                cancelButtonText: 'Cancel'
              }).then(function (result) {
                if (result.isConfirmed) {
                  HTMLFormElement.prototype.submit.call(form);
                }
              });
            }
          });

        });


        const flashMessage = document.getElementById('flash-message');

        if (flashMessage && typeof Swal !== 'undefined') {
          const message = flashMessage.dataset.message;
          const type = flashMessage.dataset.type;

          const icon = type === 'danger'
            ? 'error'
            : ['success', 'error', 'warning', 'info', 'question'].includes(type)
              ? type
              : 'info';

          Swal.fire({
            toast: true,
            position: 'top-end',
            icon: icon,
            title: message,
            showConfirmButton: false,
            timer: 2500,
            timerProgressBar: true
          });
        }
      </script>

</body>

</html>