<style>
  .store-footer {
    --footer-orange: #f4512c;
    --footer-dark: #171717;
    margin-top: 75px;
    background: var(--footer-dark);
    color: #bcbcbc;
  }

  .store-footer-main {
    padding: 55px 0 38px;
  }

  .store-footer .container {
    max-width: 1320px;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    color: #fff;
    font-size: 1.6rem;
    font-weight: 900;
    letter-spacing: -0.6px;
  }

  .footer-brand:hover {
    color: #fff;
  }

  .footer-brand-icon {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 12px;
    background: var(--footer-orange);
    color: #fff;
  }

  .footer-brand-accent {
    color: var(--footer-orange);
  }

  .footer-about {
    max-width: 340px;
    margin-bottom: 22px;
    color: #aaa;
    font-size: 0.9rem;
    line-height: 1.9;
  }

  .footer-heading {
    position: relative;
    margin-bottom: 24px;
    padding-bottom: 12px;
    color: #fff;
    font-size: 1rem;
    font-weight: 800;
  }

  .footer-heading::after {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 38px;
    height: 3px;
    border-radius: 3px;
    background: var(--footer-orange);
    content: "";
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 13px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: #bcbcbc;
    font-size: 0.9rem;
    transition: color 0.2s ease, padding-left 0.2s ease;
  }

  .footer-links a:hover {
    padding-left: 4px;
    color: var(--footer-orange);
  }

  .footer-links a i {
    width: 16px;
    color: var(--footer-orange);
    font-size: 0.85rem;
  }

  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .footer-socials a {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid #414141;
    border-radius: 10px;
    color: #fff;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .footer-socials a:hover {
    border-color: var(--footer-orange);
    background: var(--footer-orange);
    color: #fff;
  }

  .footer-contact-note {
    color: #aaa;
    font-size: 0.9rem;
    line-height: 1.8;
  }

  .footer-contact-note i {
    width: 21px;
    color: var(--footer-orange);
  }

  .store-footer-bottom {
    border-top: 1px solid #333;
    padding: 20px 0;
  }

  .footer-copyright {
    margin: 0;
    color: #999;
    font-size: 0.83rem;
    line-height: 1.8;
  }

  .footer-copyright strong {
    color: #fff;
  }

  .footer-back-top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #ddd;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }

  .footer-back-top:hover {
    color: var(--footer-orange);
  }

  @media (max-width: 767px) {
    .store-footer {
      margin-top: 48px;
    }

    .store-footer-main {
      padding: 40px 0 25px;
    }

    .footer-column {
      margin-bottom: 30px;
    }

    .footer-heading {
      margin-bottom: 18px;
    }

    .footer-about {
      max-width: none;
    }
  }
</style>

<footer class="store-footer">
  <div class="store-footer-main">
    <div class="container">
      <div class="row g-4">

        <div class="col-12 col-md-6 col-lg-4 footer-column">
          <a href="/" class="footer-brand">
            <span class="footer-brand-icon">
              <i class="fa-solid fa-shoe-prints"></i>
            </span>
            <span>Shoe<span class="footer-brand-accent">Rack</span></span>
          </a>

          <p class="footer-about">
            Find your perfect pair at Shoe Rack. Explore footwear for
            sports, casual outings, and formal occasions, all in one place.
          </p>

          <div class="footer-socials">
            <a href="#" aria-label="Instagram" title="Instagram">
              <i class="fa-brands fa-instagram"></i>
            </a>
            <a href="#" aria-label="Facebook" title="Facebook">
              <i class="fa-brands fa-facebook-f"></i>
            </a>
            <a href="#" aria-label="YouTube" title="YouTube">
              <i class="fa-brands fa-youtube"></i>
            </a>
            <a href="#" aria-label="X" title="X">
              <i class="fa-brands fa-x-twitter"></i>
            </a>
          </div>
        </div>

        <div class="col-6 col-md-6 col-lg-2 footer-column">
          <h3 class="footer-heading">Shop</h3>

          <ul class="footer-links">
            <li>
              <a href="/products">
                <i class="fa-solid fa-chevron-right"></i> All Products
              </a>
            </li>
            <li>
              <a href="/brands">
                <i class="fa-solid fa-chevron-right"></i> Brands
              </a>
            </li>
            <li>
              <a href="/products">
                <i class="fa-solid fa-chevron-right"></i> Best Sellers
              </a>
            </li>
            <li>
              <a href="/cart">
                <i class="fa-solid fa-chevron-right"></i> Shopping Cart
              </a>
            </li>
            <li>
              <a href="/wishlist">
                <i class="fa-solid fa-chevron-right"></i> Wishlist
              </a>
            </li>
          </ul>
        </div>

        <div class="col-6 col-md-6 col-lg-2 footer-column">
          <h3 class="footer-heading">Account</h3>

          <ul class="footer-links">
            <li>
              <a href="/login">
                <i class="fa-solid fa-chevron-right"></i> Login
              </a>
            </li>
            <li>
              <a href="/signup">
                <i class="fa-solid fa-chevron-right"></i> Create Account
              </a>
            </li>
            <li>
              <a href="/profile">
                <i class="fa-solid fa-chevron-right"></i> My Profile
              </a>
            </li>
            <li>
              <a href="/about">
                <i class="fa-solid fa-chevron-right"></i> About Us
              </a>
            </li>
          </ul>
        </div>

        <div class="col-12 col-md-6 col-lg-4 footer-column">
          <h3 class="footer-heading">Customer Support</h3>

          <ul class="footer-links">
            <li>
              <a href="/contact">
                <i class="fa-regular fa-envelope"></i> Contact Us
              </a>
            </li>
            <li>
              <a href="/contact">
                <i class="fa-regular fa-circle-question"></i> Need Help?
              </a>
            </li>
          </ul>

          <p class="footer-contact-note mt-4">
            <i class="fa-solid fa-shoe-prints"></i>
            Your next favourite pair is waiting for you.
          </p>
        </div>

      </div>
    </div>
  </div>

  <div class="store-footer-bottom">
    <div class="container">
      <div class="row align-items-center gy-3">
        <div class="col-12 col-md-8">
          <p class="footer-copyright">
            &copy; <%= new Date().getFullYear() %>
              <strong>Shoe Rack</strong>. All rights reserved.
          </p>
        </div>

        <div class="col-12 col-md-4 text-md-end">
          <a href="#" class="footer-back-top" onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;">
            Back to top <i class="fa-solid fa-arrow-up"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>