<div class="account">
    <span class="fw-bold fs-4">My Account</span>
    <div class="account-nav mt-4">
        <p style="font-size: 1.2em; color: #333; font-weight: bold;">
            Welcome <span style="color: #dc3545; font-weight: normal;">
                <%= users.username %>
            </span>
        </p>

        <ul class="navbar-nav mb-2">
            <li class="nav-item account-navitem">
                <a class="nav-link" href="/profile">
                    <span><i class="fa-solid fa-user"></i></span>
