<style>
  .store-header {
    --orange: #f4512c;
    background: #171717;
    color: #fff;
    font-family: Arial, Helvetica, sans-serif;
  }

  .store-header .topbar {
    display: grid;
    grid-template-columns: auto minmax(180px, 1fr) auto;
    align-items: center;
    gap: 28px;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .store-header .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #fff;
    font-size: 1.5rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .store-header .brand-icon {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 11px;
    background: var(--orange);
  }

  .store-header .brand-accent {
    color: var(--orange);
  }

  .store-header .search-form {
    width: 100%;
    max-width: 560px;
    justify-self: center;
  }

  .store-header .search-group {
    display: flex;
    overflow: hidden;
    border: 1px solid #444;
    border-radius: 9px;
    background: #252525;
  }

  .store-header .search-group input {
    width: 100%;
    min-width: 0;
    padding: 12px 14px;
    border: 0;
    outline: 0;
    background: transparent;
    color: white;
  }

  .store-header .search-group input::placeholder {
    color: #aaa;
  }

  .store-header .search-group button {
    padding: 0 17px;
    border: 0;
    background: var(--orange);
    color: white;
  }

  .store-header .header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
  }

  .store-header .action-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    padding: 9px 12px;
    border: 1px solid #414141;
    border-radius: 8px;
    color: white;
    font-size: 0.88rem;
    white-space: nowrap;
  }

  .store-header .action-link i {
    color: var(--orange);
  }

  .store-header .action-link:hover {
    border-color: var(--orange);
    background: #252525;
    color: white;
  }

  .store-header .dropdown-menu {
    z-index: 1100;
    margin-top: 8px;
    padding: 8px;
    border-radius: 10px;
  }

  .store-header .dropdown-item {
    padding: 10px;
    border-radius: 6px;
  }

  .store-header .dropdown-item:hover {
    background: #fff0ed;
    color: var(--orange);
  }

  .store-header .navigation {
    border-top: 1px solid #303030;
    background: #202020;
  }

  .store-header .navigation-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .store-header .nav-link {
    display: block;
    padding: 14px 17px;
    color: #ddd;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .store-header .nav-link:hover {
    color: var(--orange);
  }

  .store-header .mobile-search {
    display: none;
  }

  @media (max-width: 991px) {
    .store-header .topbar {
      grid-template-columns: 1fr auto;
      gap: 14px;
    }

    .store-header .search-form {
      display: none;
    }

    .store-header .mobile-search {
      display: block;
      padding-bottom: 14px;
    }

    .store-header .navigation-inner {
      gap: 0;
    }

    .store-header .nav-link {
      padding: 12px;
    }
  }

  @media (max-width: 575px) {
    .store-header .topbar {
      gap: 8px;
      padding-top: 12px;
      padding-bottom: 12px;
    }

    .store-header .brand {
      gap: 7px;
      font-size: 1.2rem;
    }

    .store-header .brand-icon {
      width: 35px;
      height: 35px;
    }

    .store-header .action-link {
      min-height: 38px;
      padding: 8px 10px;
    }

    .store-header .header-actions {
      gap: 6px;
    }

    .store-header .navigation-inner {
      justify-content: flex-start;
    }

    .store-header .nav-link {
      padding: 10px;
      font-size: 0.82rem;
    }
  }
</style>

<header class="store-header">
  <div class="container-fluid px-3 px-lg-4">
    <div class="topbar">

      <a href="/" class="brand">
        <span class="brand-icon">
          <i class="fa-solid fa-shoe-prints"></i>
        </span>
        <span>Shoe<span class="brand-accent">Rack</span></span>
      </a>

      <form class="search-form" action="/products" method="GET" role="search">
        <div class="search-group">
          <input type="search" name="allsearch" placeholder="Search shoes, styles..." aria-label="Search products"
            value="<%= typeof search !== 'undefined' && search ? search : '' %>">
          <button type="submit" aria-label="Search">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
        </div>
      </form>

      <div class="header-actions">
        <div class="dropdown">
          <a href="#" class="action-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fa-regular fa-user"></i>
            <span class="d-none d-sm-inline">
              <%= (typeof users !=='undefined' && users) ? users.username : 'Account' %>
            </span>
          </a>

          <ul class="dropdown-menu dropdown-menu-end">
            <% if (typeof users !=='undefined' && users) { %>
              <li><a class="dropdown-item" href="/profile">My Account</a></li>
              <li><a class="dropdown-item" href="/wishlist">My Wishlist</a></li>
              <li>
                <hr class="dropdown-divider">
              </li>
              <li><a class="dropdown-item" href="/logout">Logout</a></li>
              <% } else { %>
                <li><a class="dropdown-item" href="/login">Login</a></li>
                <li><a class="dropdown-item" href="/signup">Create Account</a></li>
                <% } %>
          </ul>
        </div>

        <a href="/cart" class="action-link" aria-label="Shopping cart">
          <i class="fa-solid fa-bag-shopping"></i>
          <span class="d-none d-sm-inline">Cart</span>
        </a>
      </div>

    </div>

    <div class="mobile-search">
      <form action="/products" method="GET" role="search">
        <div class="search-group">
          <input type="search" name="allsearch" placeholder="Search shoes, styles..." aria-label="Search products"
            value="<%= typeof search !== 'undefined' && search ? search : '' %>">
          <button type="submit" aria-label="Search">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
        </div>
      </form>
    </div>
  </div>

  <nav class="navigation" aria-label="Main navigation">
    <div class="container-fluid px-3 px-lg-4">
      <div class="navigation-inner">
        <a class="nav-link" href="/">Home</a>
        <a class="nav-link" href="/products">Shop All</a>
        <a class="nav-link" href="/brands">Brands</a>
        <a class="nav-link" href="/wishlist">Wishlist</a>
        <a class="nav-link" href="/about">About Us</a>
        <a class="nav-link" href="/contact">Contact</a>
      </div>
    </div>
  </nav>
</header>