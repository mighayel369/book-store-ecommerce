<!doctype html>
<html lang="en">

<head>
  <!-- Required meta tags -->
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
    integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
    crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link href="https://cdn.datatables.net/v/bs5/dt-2.1.2/datatables.min.css" rel="stylesheet">
  <style>
    :root {
      --offcanvas-width: 240px;
      --topNavbarHeight: 62px
    }

    .sidebar-nav {
      width: var(--offcanvas-width) !important;
    }

    @media (min-width: 992px) {
      body {
        overflow: auto !important;
      }

      .offcanvas-backdrop {
        display: none !important;
      }

      .sidebar-nav {
        transform: none !important;
        visibility: visible !important;
        /* top: var(--topNavbarHeight) !important; */
        /* height: calc(100% - var(--topNavbarHeight)) !important; */
      }
    }

    .header {
      font-weight: bold;
      font-size: 25px;
    }

    .logo {
      margin-left: 260px;
    }

    .nav-link {
      color: black !important;
      font-size: 13px;
    }

    .active {
      background-color: black;
      color: white !important;
    }

    .nav-item {
      text-align: left;
    }

    .nav-link span {
      position: absolute;
      margin-left: 25px;
    }

    .nav-link {
      display: flex;
      align-items: center;
      padding: 10px 15px;
    }

    main {
      margin-left: var(--offcanvas-width);
    }

    .offcanvas-header {
      background-color: yellowgreen;
    }
  </style>
  <title>Hello, world!</title>
</head>

<body>
  <!-- navbar -->
  <nav class="navbar navbar-expand-lg  bg-success" style="--bs-bg-opacity: .3;">
    <div class="logo">
      <a class="text-white mx-2" data-bs-toggle="offcanvas" href="#offcanvasExample" role="button"
        aria-controls="offcanvasExample">
        <i class="fa-solid fa-list text-dark"></i>
      </a>
      <a class="navbar-brand fw-bold" href="#">Admin Panel</a>
    </div>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent"
      aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav  mb-2 mb-lg-0 d-flex ms-auto">
        <li class="nav-item">
          <a class="nav-link" href="#"><i class="fa-solid fa-bell"></i></a>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fa-solid fa-circle-user"></i>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="#">Account</a></li>
            <li><a class="dropdown-item" href="/admin/logout">Logout</a></li>
          </ul>
        </li>
      </ul>
    </div>
  </nav>
  <!-- navbar -->
  <!-- offcanvas -->
  <div class="offcanvas offcanvas-start sidebar-nav" tabindex="-1" id="offcanvasExample"
    aria-labelledby="offcanvasExampleLabel">
    <div class="offcanvas-header">
      <a class="navbar-brand d-flex align-items-center fw-bold fs-3" href="#">
        <img
          src="https://media.istockphoto.com/id/1199509219/vector/running-shoes-icon-in-line-style.jpg?s=612x612&w=0&k=20&c=QgRq_L_-2wHTm2ORbeHfpU6JHjQVFEm2OC007fy5JOI="
          alt="Shoe Rack Logo" style="width: 40px; height: 40px; margin-right: 10px; border-radius: 50%;">
        <span
          style="letter-spacing: 2px; font-weight: 700; color: #f0f0f0; text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);">
          Shoe <span style="color: rgb(168, 216, 35);">Rack</span>
        </span>
      </a>
    </div>
    <div class="offcanvas-body p-0">
      <nav class="navbar-light">
        <ul class="nav flex-column">
          <li class="nav-item ">
            <a class="nav-link" href="/admin/dashboard"><i class="fa-solid fa-house "></i><span>Dashboard</span></a>
          </li>
          <li class="nav-item">
            <a class="nav-link " href="/admin/category"><i class="fa-solid fa-layer-group"></i><span>Category
                Management</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/users"><i class="fa-solid fa-user"></i><span>User Management</span></a>
          </li>
          <li class="nav-item">
            <a class="nav-link " href="/admin/products"><i class="fa-solid fa-book"></i><span>Product
                Management</span></a>
          </li>
          <li class="nav-item">
            <a class="nav-link " href="/admin/orders"><i class="fa-solid fa-truck"></i></i><span>Order
                Management</span></a>
          </li>
          <li class="nav-item">
            <a class="nav-link " href="/admin/coupon"><i class="fa-solid fa-ticket-simple"></i><span>Coupon
                Management</span></a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/offer" id="offerManagementToggle">
              <i class="fa-solid fa-clipboard"></i>
              <span>Offer Management</span>
              <i class="fa-solid fa-caret-down" style="margin-left: auto;"></i>
            </a>
          </li>
          <div id="offerManagementMenu" class="ms-3 d-none">
            <li class="nav-item">
              <a class="nav-link" href="/admin/offer/category">
                <i class="fa-solid fa-tag"></i>
                <span>Category Offer</span>
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin/offer/product">
                <i class="fa-solid fa-gift"></i>
                <span>Product Offer</span>
              </a>
            </li>
          </div>
          <li class="nav-item">
            <a class="nav-link" href="/admin/sales"><i class="fa-solid fa-money-bill"></i><span>Completed
                Transactions</span></a>
          </li>
        </ul>
      </nav>
    </div>
  </div>


  <script>
    document.getElementById('offerManagementToggle').addEventListener('click', function (event) {
      event.preventDefault();
      event.stopPropagation()
      var menu = document.getElementById('offerManagementMenu');
      menu.classList.toggle('d-none');
    });

    document.getElementById('offerManagementMenu').addEventListener('click', function (event) {
      event.stopPropagation();
    });
  </script>