        <%- include('../partials/userfooter') %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

            <script>
                $(document).ready(function () {

                    function updateSavings() {
                        const $checked = $('.coupon-checkbox:checked').first();

                        if ($checked.length) {
                            const saving = Number($checked.attr('data-couponvalue')) || 0;
                            $('#savings').text(
                                '₹' + saving.toLocaleString('en-IN')
                            );
                        } else {
                            $('#savings').text('₹0');
                        }
                    }

                    $('.coupon-checkbox').on('change', function () {
                        if ($(this).is(':checked')) {
                            $('.coupon-checkbox').not(this).prop('checked', false);
                        }

                        updateSavings();
                    });

                    updateSavings();

                    $('#checkCouponCode').on('click', function () {
                        const enteredCode = ($('#couponCodeInput').val() || '')
                            .trim()
                            .toUpperCase();

                        if (!enteredCode) {
                            Swal.fire({
                                icon: 'info',
                                title: 'Enter a coupon code',
                                text: 'Type a coupon code before checking.'
                            });
                            return;
                        }

                        const $match = $('.coupon-checkbox').filter(function () {
                            return String($(this).attr('data-code')).toUpperCase() === enteredCode;
                        }).first();

                        if (!$match.length) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Coupon not found',
                                text: 'Please check the code or select an available coupon.'
                            });
                            return;
                        }

                        $('.coupon-checkbox').prop('checked', false);
                        $match.prop('checked', true);
                        updateSavings();

                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: 'Coupon selected',
                            showConfirmButton: false,
                            timer: 1500
                        });
                    });


                    $('#orderForm').on('submit', function (event) {
                        event.preventDefault();

                        const $button = $('#placeOrderButton');
                        const formData = $(this).serialize();

                        if (!$('input[name="paymentMethod"]:checked').length) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Select a payment method',
                                text: 'Choose how you want to pay for this order.'
                            });
                            return;
                        }

                        Swal.fire({
                            title: 'Confirm your order',
                            text: 'Are you sure you want to place this order?',
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonColor: '#f4512c',
                            cancelButtonColor: '#777',
                            confirmButtonText: 'Yes, place order',
                            cancelButtonText: 'Review order'
                        }).then(function (result) {
                            if (!result.isConfirmed) return;

                            $button.prop('disabled', true)
                                .html('<span class="spinner-border spinner-border-sm me-2"></span>Processing...');

                            $.ajax({
                                type: 'POST',
                                url: '/place-order',
                                data: formData,

                                success: function (response) {

                                    if (response.message === 'Razorpay order created') {

                                        const options = {
                                            key: 'rzp_test_x7mcrmmJeFQpUZ',
                                            amount: response.amount * 100,
                                            currency: 'INR',
                                            name: 'Shoe Rack',
                                            description: 'Shoe Rack purchase',
                                            order_id: response.razorpayOrderId,

                                            handler: function (razorpayResponse) {
                                                $.ajax({
                                                    type: 'POST',
                                                    url: '/verify-payment',
                                                    data: {
                                                        orderId: response.orderId,
                                                        razorpay_payment_id: razorpayResponse.razorpay_payment_id,
                                                        razorpay_order_id: razorpayResponse.razorpay_order_id,
                                                        razorpay_signature: razorpayResponse.razorpay_signature,
                                                        totalPrice: response.totalPrice,
                                                        finalPrice: response.finalPrice
                                                    },

                                                    success: function () {
                                                        Swal.fire({
                                                            icon: 'success',
                                                            title: 'Payment successful!',
                                                            text: 'Your payment has been verified.',
                                                            confirmButtonColor: '#f4512c'
                                                        }).then(function () {
                                                            window.location.href = '/ordersuccess';
                                                        });
                                                    },

                                                    error: function (xhr) {
                                                        const message = xhr.responseJSON?.message ||
                                                            'Your payment could not be verified. Please contact support if money was deducted.';

                                                        Swal.fire({
                                                            icon: 'error',
                                                            title: 'Payment verification failed',
                                                            text: message,
                                                            confirmButtonColor: '#f4512c'
                                                        });

                                                        $button.prop('disabled', false)
                                                            .html('Place Order <i class="fa-solid fa-arrow-right ms-2"></i>');
                                                    }
                                                });
                                            },

                                            modal: {
                                                ondismiss: function () {
                                                    Swal.fire({
                                                        icon: 'warning',
                                                        title: 'Payment cancelled',
                                                        text: 'Your payment window was closed.',
                                                        confirmButtonColor: '#f4512c'
                                                    });

                                                    $button.prop('disabled', false)
                                                        .html('Place Order <i class="fa-solid fa-arrow-right ms-2"></i>');
                                                }
                                            },

                                            prefill: {
                                                name: 'Customer Name',
                                                email: 'customer@example.com',
                                                contact: '9999999999'
                                            },

                                            theme: {
                                                color: '#f4512c'
                                            }
                                        };

                                        const razorpay = new Razorpay(options);

                                        razorpay.on('payment.failed', function (failure) {
                                            Swal.fire({
                                                icon: 'error',
                                                title: 'Payment failed',
                                                text: failure.error?.description ||
                                                    'The payment could not be completed.',
                                                confirmButtonColor: '#f4512c'
                                            });

                                            $button.prop('disabled', false)
                                                .html('Place Order <i class="fa-solid fa-arrow-right ms-2"></i>');
                                        });

                                        razorpay.open();

                                    } else {
                                        Swal.fire({
                                            icon: 'success',
                                            title: 'Order placed successfully!',
                                            text: 'Your order has been placed.',
                                            confirmButtonColor: '#f4512c'
                                        }).then(function () {
                                            window.location.href = '/ordersuccess';
                                        });
                                    }
                                },

                                error: function (xhr) {
                                    const errorMessage = xhr.responseJSON?.message ||
                                        'Something went wrong. Please try again.';

                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Unable to place order',
                                        text: errorMessage,
                                        confirmButtonColor: '#f4512c'
                                    });

                                    $button.prop('disabled', false)
                                        .html('Place Order <i class="fa-solid fa-arrow-right ms-2"></i>');
                                }
                            });
                        });
                    });
                });

                function populateEditForm(button) {
                    const addressId = button.getAttribute('data-id');

                    document.getElementById('edit-fullname').value =
                        button.getAttribute('data-fullname') || '';

                    document.getElementById('edit-houseno').value =
                        button.getAttribute('data-houseno') || '';

                    document.getElementById('edit-area').value =
                        button.getAttribute('data-area') || '';

                    document.getElementById('edit-landmark').value =
                        button.getAttribute('data-landmark') || '';

                    document.getElementById('edit-town').value =
                        button.getAttribute('data-town') || '';

                    document.getElementById('edit-state').value =
                        button.getAttribute('data-state') || 'Kerala';

                    document.getElementById('edit-pincode').value =
                        button.getAttribute('data-pincode') || '';

                    document.getElementById('edit-phoneno').value =
                        button.getAttribute('data-phoneno') || '';

                    document.getElementById('flexCheckDefault').checked =
                        String(button.getAttribute('data-default')).trim() === 'true';

                    document.getElementById('edit-address-form').action =
                        '/edit-address/' + encodeURIComponent(addressId);
                }

                function deleteAddress(addressId) {
                    Swal.fire({
                        title: 'Delete this address?',
                        text: 'This address will be removed from your saved addresses.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#f4512c',
                        cancelButtonColor: '#777',
                        confirmButtonText: 'Yes, delete it',
                        cancelButtonText: 'Keep address'
                    }).then(function (result) {
                        if (result.isConfirmed) {
                            window.location.href =
                                '/delete-address/' + encodeURIComponent(addressId);
                        }
                    });
                }

                function applyCoupon() {
                    const $selected = $('.coupon-checkbox:checked').first();
                    const couponId = $selected.val();

                    if (!couponId) {
                        Swal.fire({
                            icon: 'info',
                            title: 'Choose a coupon',
                            text: 'Select a coupon before applying it.',
                            confirmButtonColor: '#f4512c'
                        });
                        return;
                    }

                    window.location.href =
                        '/checkout/applycoupon/' + encodeURIComponent(couponId);
                }


                function removeCoupon() {
                    Swal.fire({
                        title: 'Remove applied coupon?',
                        text: 'The discount will be removed from this checkout.',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#f4512c',
                        cancelButtonColor: '#777',
                        confirmButtonText: 'Remove coupon'
                    }).then(function (result) {
                        if (result.isConfirmed) {
                            window.location.href = '/checkout/removeCoupon';
                        }
                    });
                }
            </script>
</body>

</html>