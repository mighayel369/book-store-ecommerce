                });
            }
        });
    });

    $(window).on('beforeunload', function() {
        $.ajax({
            type: 'GET',
            url: '/checkout/removeCoupon',
            success: function(response) {
                console.log('Coupon removed successfully.');
            },
            error: function(xhr) {
                console.log('Failed to remove the coupon.');
            }
        });
    });

    function initialSavings() {
        let checkboxes = $('.checkboxes input[type="checkbox"]:checked');
        if (checkboxes.length > 0) {
            let couponValue = checkboxes.data('couponvalue');
            $('#savings').text('₹' + couponValue);
        } else {
            $('#savings').text('0');
        }
    }

    initialSavings();

    $(document).on('change', '.checkboxes input[type="checkbox"]', function() {
        if ($(this).is(':checked')) {
            let couponValue = $(this).data('couponvalue');
            console.log(couponValue);
            $('#savings').text('₹' + couponValue);

            $('.checkboxes input[type="checkbox"]').not(this).prop('checked', false);
        } else {
            $('#savings').text('0');
        }
    });
});

function populateEditForm(button) {
    console.log('triggered');
    let addressId = button.getAttribute('data-id');
    const fullname = button.getAttribute('data-fullname');
    const houseno = button.getAttribute('data-houseno');
    const area = button.getAttribute('data-area');
    const landmark = button.getAttribute('data-landmark');
    const town = button.getAttribute('data-town');
    const state = button.getAttribute('data-state');
    const pincode = button.getAttribute('data-pincode');
    const phoneno = button.getAttribute('data-phoneno');
    const Isdefault = button.getAttribute('data-default');
    console.log(Isdefault);
    console.log('Type of Isdefault:', typeof Isdefault);

    document.getElementById('edit-fullname').value = fullname;
    document.getElementById('edit-houseno').value = houseno;
    document.getElementById('edit-area').value = area;
    document.getElementById('edit-landmark').value = landmark;
    document.getElementById('edit-town').value = town;
    document.getElementById('edit-state').value = state;
    document.getElementById('edit-pincode').value = pincode;
    document.getElementById('edit-phoneno').value = phoneno;

    if (String(Isdefault).trim() === 'true') {
        document.getElementById('flexCheckDefault').checked = true;
    } else {
        document.getElementById('flexCheckDefault').checked = false;
    }

    let url = `/edit-address/${addressId}`;
    document.getElementById('edit-address-form').action = url;
}

function deleteAddress(addressId) {
    let url = `/delete-address/${addressId}`;
    const isConfirmed = window.confirm('Do you really want to delete the address?');
    if (isConfirmed) {
        window.location.href = url;
    } else {
        console.log("canceled");
    }
}

function applyCoupon() {
    let checkedCheckboxes = $('.coupondetails .form-check-input:checked');
    let couponId = checkedCheckboxes.val();
    if (!couponId) { 
        window.location.href = `/checkout/removeCoupon`; 
    } else {
        window.location.href = `/checkout/applycoupon/${couponId}`;
    }
}

