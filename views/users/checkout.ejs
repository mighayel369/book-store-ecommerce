        <div class="offcanvas offcanvas-center" data-bs-scroll="true" tabindex="-1" id="offcanvasapplycoupon"
            aria-labelledby="applyCouponLabel">
            <div class="offcanvas-header">
                <div>
                    <h5 class="offcanvas-title" id="applyCouponLabel">
                        <i class="fa-solid fa-ticket-simple me-2" style="color: var(--brand);"></i>Available Coupons
                    </h5>
                    <p class="text-muted small mb-0">Choose a coupon to save on your order.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>

            <div class="offcanvas-body d-flex flex-column">
                <div class="coupon-code-box">
                    <input type="text" class="form-control" id="couponCodeInput" placeholder="Enter coupon code"
                        aria-label="Enter coupon code">
