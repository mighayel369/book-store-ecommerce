                                confirmButtonText: 'OK'
                            }).then((result) => {
                                let orderId = response.orderId;
                                if (result.isConfirmed) {
                                    window.location.href=`/ordersuccess`
                                }
                            });
                        }
                    },
                    error: function(xhr) {
                        let errorMessage = xhr.responseJSON.message || 'Something went wrong. Please try again.';
                        Swal.fire({
                            icon: 'error',
                            title: 'Order Failed',
                            text: errorMessage,
                            confirmButtonText: 'OK'
                        });
