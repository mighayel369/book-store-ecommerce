<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | Shoe Rack</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --brand: #f4512c;
            --brand-dark: #d83c1b;
            --brand-light: #fff2ed;
            --text: #252525;
            --muted: #747474;
            --border: #e9e9e9;
            --surface: #ffffff;
            --page-bg: #f7f7f8;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--page-bg);
            color: var(--text);
            font-family: Arial, Helvetica, sans-serif;
        }

        .checkout-page {
            min-height: 75vh;
            padding: 28px 0 60px;
        }

        .checkout-container {
            max-width: 1250px;
            margin: auto;
            padding: 0 20px;
        }

        .breadcrumb-line {
            color: var(--muted);
            font-size: 14px;
            margin-bottom: 26px;
        }

        .breadcrumb-line a {
            color: var(--muted);
            text-decoration: none;
        }

        .breadcrumb-line a:hover {
            color: var(--brand);
        }

        .breadcrumb-line .current {
            color: var(--brand);
            font-weight: 700;
        }

        .checkout-heading {
            margin-bottom: 25px;
        }

        .checkout-heading h1 {
            font-size: clamp(25px, 3vw, 34px);
            font-weight: 800;
            letter-spacing: -0.8px;
            margin-bottom: 8px;
        }

        .checkout-heading p {
            margin: 0;
            color: var(--muted);
            font-size: 14px;
        }

        .checkout-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 25px;
            margin-bottom: 22px;
            box-shadow: 0 5px 24px rgba(0, 0, 0, 0.035);
        }

        .section-heading {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 22px;
        }

        .section-icon {
            width: 43px;
            height: 43px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--brand);
            background: var(--brand-light);
            font-size: 17px;
            flex-shrink: 0;
        }

        .section-heading h2 {
            font-size: 19px;
            font-weight: 750;
            margin: 0 0 4px;
        }

        .section-heading p {
            margin: 0;
            color: var(--muted);
            font-size: 13px;
        }

        .address-list {
            display: flex;
            align-items: flex-start;
            gap: 13px;
            padding: 17px;
            margin-bottom: 13px;
            border: 1px solid var(--border);
            border-radius: 13px;
            background: #fff;
            transition: border-color 0.2s, background 0.2s;
        }

        .address-list:has(input[type="radio"]:checked) {
            border-color: var(--brand);
            background: #fffaf8;
        }

        .address-radio {
            width: 17px;
            height: 17px;
            margin-top: 4px;
            flex-shrink: 0;
            accent-color: var(--brand);
            cursor: pointer;
        }

        .address-content {
            flex: 1;
            min-width: 0;
        }

        .address-name {
            font-size: 15px;
            font-weight: 750;
            margin-bottom: 7px;
        }

        .address-content p {
            font-size: 13px;
            line-height: 1.65;
            color: #5f5f5f;
            margin: 0;
            overflow-wrap: anywhere;
        }

        .default-label {
            display: inline-block;
            color: #237847;
            background: #eaf8ef;
            border-radius: 5px;
            padding: 3px 7px;
            margin-left: 6px;
            font-size: 10px;
            font-weight: 700;
            vertical-align: middle;
        }

        .address-actions {
            display: flex;
            gap: 10px;
            flex-shrink: 0;
        }

        .icon-button {
            width: 34px;
            height: 34px;
            border: 1px solid var(--border);
            background: white;
            color: #555;
            border-radius: 9px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s;
        }

        .icon-button:hover {
            color: var(--brand);
            border-color: var(--brand);
            background: var(--brand-light);
        }

        .icon-button.delete:hover {
            color: #dc3545;
            border-color: #dc3545;
            background: #fff1f1;
        }

        .address-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 18px;
        }

        .btn-brand {
            background: var(--brand);
            border: 1px solid var(--brand);
            color: white;
            font-weight: 700;
            border-radius: 10px;
            padding: 11px 17px;
            transition: all 0.2s;
        }

        .btn-brand:hover,
        .btn-brand:focus {
            background: var(--brand-dark);
            border-color: var(--brand-dark);
            color: white;
        }

        .btn-outline-brand {
            background: white;
            color: var(--brand);
            border: 1px solid var(--brand);
            border-radius: 10px;
            padding: 10px 15px;
            font-weight: 700;
        }

        .btn-outline-brand:hover {
            color: white;
            background: var(--brand);
        }

        .btn-dark-custom {
            color: white;
            background: #222;
            border: 1px solid #222;
            border-radius: 10px;
            padding: 11px 16px;
            font-weight: 700;
        }

        .btn-dark-custom:hover {
            color: white;
            background: #444;
        }

        .payment-option {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px;
            margin-bottom: 12px;
            border: 1px solid var(--border);
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .payment-option:has(input:checked) {
            border-color: var(--brand);
            background: #fffaf8;
        }

        .payment-option input {
            accent-color: var(--brand);
            width: 17px;
            height: 17px;
            flex-shrink: 0;
        }

        .payment-option .payment-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: #f4f4f4;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #383838;
            flex-shrink: 0;
        }

        .payment-option strong {
            display: block;
            font-size: 14px;
            margin-bottom: 3px;
        }

        .payment-option small {
            color: var(--muted);
            font-size: 12px;
        }

        .payment-option .payment-check {
            margin-left: auto;
            color: var(--brand);
        }

        .order-summary {
            position: sticky;
            top: 20px;
        }

        .delivery-note {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 13px;
            background: #f2fbf5;
            color: #277448;
            border-radius: 11px;
            font-size: 12px;
            margin-bottom: 22px;
        }

        .order-product {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 16px 0;
            border-bottom: 1px solid #f0f0f0;
        }

        .product-image-wrap {
            width: 86px;
            height: 100px;
            border-radius: 12px;
            background: #f7f7f7;
            overflow: hidden;
            flex-shrink: 0;
        }

        .product-image-wrap img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            mix-blend-mode: multiply;
        }

        .product-info {
            flex: 1;
            min-width: 0;
        }

        .product-name {
            font-size: 14px;
            font-weight: 750;
            line-height: 1.45;
            margin-bottom: 6px;
            overflow-wrap: anywhere;
            color: #242424;
        }

        .product-price {
            font-size: 14px;
            font-weight: 750;
            margin-bottom: 5px;
        }

        .old-price {
            color: #888;
            font-size: 12px;
            text-decoration: line-through;
            margin-left: 5px;
            font-weight: 400;
        }

        .offer-label {
            display: inline-block;
            margin-top: 4px;
            color: #198754;
            font-size: 11px;
            font-weight: 700;
        }

        .product-quantity {
            color: var(--muted);
            font-size: 12px;
            margin: 0;
        }

        .product-line-total {
            font-size: 14px;
            font-weight: 750;
            white-space: nowrap;
        }

        .summary-divider {
            border: 0;
            border-top: 1px solid var(--border);
            margin: 20px 0;
        }

        .summary-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            font-size: 13px;
            margin-bottom: 17px;
        }

        .summary-row .summary-label {
            color: #666;
        }

        .summary-row .summary-value {
            font-weight: 650;
            text-align: right;
        }

        .coupon-trigger {
            color: var(--brand);
            background: transparent;
            border: none;
            padding: 0;
            font-weight: 750;
            cursor: pointer;
            text-align: right;
        }

        .coupon-trigger:hover {
            color: var(--brand-dark);
            text-decoration: underline;
        }

        .coupon-applied {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            color: #198754;
            font-size: 12px;
        }

        .grand-total {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            font-size: 17px;
            font-weight: 800;
            margin-top: 20px;
        }

        .grand-total .amount {
            font-size: 23px;
            color: var(--brand);
            white-space: nowrap;
        }

        .place-order-btn {
            width: 100%;
            border: 0;
            border-radius: 12px;
            background: var(--brand);
            color: #fff;
            font-weight: 800;
            padding: 15px;
            margin-top: 23px;
            transition: all 0.2s;
        }

        .place-order-btn:hover {
            background: var(--brand-dark);
            transform: translateY(-1px);
        }

        .place-order-btn:disabled {
            opacity: 0.65;
            cursor: not-allowed;
            transform: none;
        }

        .secure-note {
            text-align: center;
            color: var(--muted);
            font-size: 11px;
            margin-top: 13px;
        }

        .coupon-promo {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 15px;
            margin-top: 20px;
            background: #fffaf8;
            border: 1px dashed #f4b09f;
            border-radius: 12px;
        }

        .coupon-promo-icon {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-light);
            color: var(--brand);
            border-radius: 10px;
            flex-shrink: 0;
        }

        .coupon-promo-text {
            flex: 1;
            min-width: 0;
        }

        .coupon-promo-text strong {
            display: block;
            font-size: 13px;
        }

        .coupon-promo-text small {
            display: block;
            color: var(--muted);
            font-size: 11px;
            margin-top: 4px;
        }

        .offcanvas-center {
            width: min(480px, 100%);
            height: min(90vh, 780px);
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) !important;
            border-radius: 18px;
            overflow: hidden;
            border: none;
            box-shadow: 0 20px 70px rgba(0, 0, 0, 0.18);
        }

        .offcanvas-center .offcanvas-header {
            padding: 22px;
            border-bottom: 1px solid var(--border);
        }

        .offcanvas-center .offcanvas-body {
            padding: 22px;
            overflow-y: auto;
        }

        .offcanvas-title {
            font-size: 18px;
            font-weight: 800;
        }

        .form-control,
        .form-select {
            border-color: #dedede;
            border-radius: 10px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--brand);
            box-shadow: 0 0 0 0.2rem rgba(244, 81, 44, 0.12);
        }

        .form-floating>label {
            color: #777;
        }

        .form-check-input:checked {
            background-color: var(--brand);
            border-color: var(--brand);
        }

        .coupon-code-box {
            display: flex;
            gap: 8px;
            margin-bottom: 20px;
        }

        .coupon-code-box .form-control {
            min-width: 0;
        }

        .coupon-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 16px;
            border: 1px solid var(--border);
            border-radius: 13px;
            margin-bottom: 13px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .coupon-item:has(input:checked) {
            border-color: var(--brand);
            background: #fffaf8;
        }

        .coupon-item input {
            margin-top: 4px;
            flex-shrink: 0;
        }

        .coupon-item-content {
            flex: 1;
            min-width: 0;
        }

        .coupon-code {
            display: inline-block;
            border: 1px dashed var(--brand);
            color: var(--brand);
            background: white;
            border-radius: 6px;
            padding: 5px 10px;
            font-weight: 800;
            font-size: 12px;
            margin-bottom: 9px;
        }

        .coupon-saving {
            font-size: 14px;
            font-weight: 800;
            color: #198754;
            margin-bottom: 5px;
        }

        .coupon-description {
            font-size: 12px;
            color: #666;
            line-height: 1.5;
        }

        .coupon-expiry {
            font-size: 11px;
            color: #888;
            margin-top: 6px;
        }

        .coupon-bottom {
            padding-top: 18px;
            border-top: 1px solid var(--border);
        }

        .coupon-max-saving {
            text-align: center;
            font-size: 12px;
            color: var(--muted);
        }

        .coupon-max-saving strong {
            display: block;
            font-size: 21px;
            color: var(--brand);
            margin-top: 5px;
        }

        .empty-address {
            text-align: center;
            padding: 28px 15px;
            border: 1px dashed #ddd;
            border-radius: 13px;
            color: var(--muted);
        }

        .empty-address i {
            font-size: 28px;
            color: #aaa;
            margin-bottom: 12px;
        }

        .colored-toast {
            background: #262626 !important;
            color: white !important;
        }

        @media (max-width: 991px) {
            .order-summary {
                position: static;
            }

            .checkout-page {
                padding-top: 20px;
            }
        }

        @media (max-width: 575px) {
            .checkout-container {
                padding: 0 12px;
            }

            .checkout-card {
                padding: 17px;
                border-radius: 14px;
            }

            .checkout-heading h1 {
                font-size: 27px;
            }

            .address-list {
                padding: 12px;
                gap: 9px;
            }

            .address-actions {
                gap: 5px;
            }

            .icon-button {
                width: 30px;
                height: 30px;
            }

            .address-footer {
                align-items: stretch;
                flex-direction: column;
            }

            .address-footer button {
                width: 100%;
            }

            .product-image-wrap {
                width: 68px;
                height: 82px;
            }

            .order-product {
                gap: 10px;
            }

            .product-name {
                font-size: 12px;
            }

            .product-line-total {
                font-size: 12px;
            }

            .grand-total .amount {
                font-size: 21px;
            }

            .offcanvas-center {
                width: calc(100% - 20px);
                height: 92vh;
                border-radius: 14px;
            }

            .offcanvas-center .offcanvas-header,
            .offcanvas-center .offcanvas-body {
                padding: 16px;
            }
        }
    </style>
</head>

<body>
    <%- include('../partials/userHeader') %>

        <main class="checkout-page">
            <div class="checkout-container">

                <nav class="breadcrumb-line" aria-label="Breadcrumb">
                    <a href="/">Home</a>
                    <span class="mx-2">/</span>
                    <a href="/cart">Cart</a>
                    <span class="mx-2">/</span>
                    <span class="current">Checkout</span>
                </nav>

                <div class="checkout-heading">
                    <h1>Checkout</h1>
                    <p>Almost there! Confirm your delivery details and complete your order.</p>
                </div>

                <% if (message && message.message) { %>
                    <div id="flash-message" hidden>
                        <%= message.message %>
                    </div>

                    <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            const messageElement = document.getElementById('flash-message');

                            if (messageElement) {
                                Swal.fire({
                                    toast: true,
                                    position: 'top-end',
                                    title: messageElement.textContent.trim(),
                                    showConfirmButton: false,
                                    timer: 2500,
                                    timerProgressBar: true,
                                    background: '#218838',
                                    color: '#fff',
                                    customClass: {
                                        popup: 'colored-toast'
                                    }
                                });
                            }
                        });
                    </script>
                    <% } %>

                        <div class="row g-4">

                            <div class="col-lg-7">

                                <section class="checkout-card">
                                    <div class="section-heading">
                                        <div class="section-icon">
                                            <i class="fa-solid fa-location-dot"></i>
                                        </div>
                                        <div>
                                            <h2>Delivery Address</h2>
                                            <p>Choose where you want your order delivered.</p>
                                        </div>
                                    </div>

                                    <form action="/updateDefaultaddress" method="post" id="defaultAddressForm">
                                        <% if (users.address && users.address.length> 0) { %>

                                            <% users.address.forEach(element=> { %>
                                                <div class="address-list">
                                                    <input type="radio" name="selectedAddress"
                                                        value="<%= element._id %>" <%=element.default ? 'checked' : ''
                                                        %>
                                                    class="address-radio"
                                                    aria-label="Select address for <%= element.fullname %>"
                                                        >

                                                        <div class="address-content">
                                                            <div class="address-name">
                                                                <%= element.fullname %>
                                                                    <% if (element.default) { %>
                                                                        <span class="default-label">DEFAULT</span>
                                                                        <% } %>
                                                            </div>

                                                            <p>
                                                                <%= element.houseno %>, <%= element.area %>
                                                            </p>
                                                            <p>
                                                                <%= element.landmark %>
                                                            </p>
                                                            <p>
                                                                <%= element.town %>, <%= element.state %> - <%=
                                                                            element.pincode %>
                                                            </p>
                                                            <p>
                                                                <i class="fa-solid fa-phone me-1"></i>
                                                                <%= element.phoneno %>
                                                            </p>
                                                        </div>

                                                        <div class="address-actions">
                                                            <button type="button" class="icon-button"
                                                                title="Edit address" aria-label="Edit address"
                                                                data-bs-toggle="offcanvas"
                                                                data-bs-target="#offcanvasEditAddress"
                                                                data-id="<%= element._id %>"
                                                                data-fullname="<%= element.fullname %>"
                                                                data-houseno="<%= element.houseno %>"
                                                                data-area="<%= element.area %>"
                                                                data-landmark="<%= element.landmark %>"
                                                                data-town="<%= element.town %>"
                                                                data-state="<%= element.state %>"
                                                                data-pincode="<%= element.pincode %>"
                                                                data-phoneno="<%= element.phoneno %>"
                                                                data-default="<%= element.default %>"
                                                                onclick="populateEditForm(this)">
                                                                <i class="fa-solid fa-pen"></i>
                                                            </button>

                                                            <button type="button" class="icon-button delete"
                                                                title="Delete address" aria-label="Delete address"
                                                                onclick="deleteAddress('<%= element._id %>')">
                                                                <i class="fa-solid fa-trash"></i>
                                                            </button>
                                                        </div>
                                                </div>
                                                <% }) %>

                                                    <div class="address-footer">
                                                        <button type="button" class="btn btn-outline-brand"
                                                            data-bs-toggle="offcanvas"
                                                            data-bs-target="#offcanvasWithBothOptions">
                                                            <i class="fa-solid fa-plus me-2"></i>Add New Address
                                                        </button>

                                                        <button type="submit" class="btn btn-dark-custom">
                                                            <i class="fa-solid fa-check me-2"></i>Save Default Address
                                                        </button>
                                                    </div>

                                                    <% } else { %>

                                                        <div class="empty-address">
                                                            <i class="fa-solid fa-map-location-dot d-block"></i>
                                                            <h6 class="fw-bold text-dark">No delivery address yet</h6>
                                                            <p class="small mb-3">Add an address to continue with
                                                                checkout.</p>
                                                            <button type="button" class="btn btn-brand"
                                                                data-bs-toggle="offcanvas"
                                                                data-bs-target="#offcanvasWithBothOptions">
                                                                <i class="fa-solid fa-plus me-2"></i>Add Address
                                                            </button>
                                                        </div>

                                                        <% } %>
                                    </form>
                                </section>

                                <section class="checkout-card">
                                    <div class="section-heading">
                                        <div class="section-icon">
                                            <i class="fa-solid fa-wallet"></i>
                                        </div>
                                        <div>
                                            <h2>Payment Method</h2>
                                            <p>Choose your preferred payment option.</p>
                                        </div>
                                    </div>

                                    <form id="orderForm">
                                        <label class="payment-option" for="cod">
                                            <input class="form-check-input" type="radio" name="paymentMethod" id="cod"
                                                value="cod" checked>
                                            <span class="payment-icon">
                                                <i class="fa-solid fa-money-bill-wave"></i>
                                            </span>
                                            <span>
                                                <strong>Cash on Delivery</strong>
                                                <small>Pay when your order arrives.</small>
                                            </span>
                                            <i class="fa-solid fa-circle-check payment-check"></i>
                                        </label>

                                        <label class="payment-option" for="wallet">
                                            <input class="form-check-input" type="radio" name="paymentMethod"
                                                id="wallet" value="wallet">
                                            <span class="payment-icon">
                                                <i class="fa-solid fa-wallet"></i>
                                            </span>
                                            <span>
                                                <strong>Wallet</strong>
                                                <small>Pay using your available wallet balance.</small>
                                            </span>
                                            <i class="fa-solid fa-circle-check payment-check"></i>
                                        </label>

                                        <label class="payment-option mb-0" for="razorpay">
                                            <input class="form-check-input" type="radio" name="paymentMethod"
                                                id="razorpay" value="razorpay">
                                            <span class="payment-icon">
                                                <i class="fa-solid fa-credit-card"></i>
                                            </span>
                                            <span>
                                                <strong>Online Payment</strong>
                                                <small>Pay securely using Razorpay.</small>
                                            </span>
                                            <i class="fa-solid fa-circle-check payment-check"></i>
                                        </label>

                                        <% let subtotal=0; cartData.forEach(element=> {
                                            const activeOffer = element.discountSource === 'category'
                                            ? element.offer
                                            : element.productoffer;

                                            const hasActiveOffer = Boolean(
                                            activeOffer &&
                                            activeOffer.isOfferActive &&
                                            element.discountPrice != null &&
                                            Number.isFinite(Number(element.discountPrice))
                                            );

                                            const itemPrice = hasActiveOffer
                                            ? Number(element.discountPrice)
                                            : Number(element.productprice);

                                            subtotal += itemPrice * Number(element.quantity);
                                            });


                                            const couponDiscount = Math.min(
                                            Math.max(0, Number(deductedValue) || 0),
                                            subtotal
                                            );


                                            const finalTotal = Math.max(0, subtotal - couponDiscount);
                                            %>

                                            <input type="hidden" name="totalPrice" value="<%= subtotal %>">
                                            <input type="hidden" name="couponDiscount" value="<%= couponDiscount %>">
                                            <input type="hidden" name="finalPrice" value="<%= finalTotal %>">
                                    </form>
                                </section>

                            </div>


                            <div class="col-lg-5">
                                <section class="checkout-card order-summary">
                                    <div class="section-heading">
                                        <div class="section-icon">
                                            <i class="fa-solid fa-bag-shopping"></i>
                                        </div>
                                        <div>
                                            <h2>Order Summary</h2>
                                            <p>Review your items before placing the order.</p>
                                        </div>
                                    </div>

                                    <div class="delivery-note">
                                        <i class="fa-solid fa-truck-fast fs-5"></i>
                                        <div>
                                            <strong>Free shipping</strong>
                                            <div>Estimated delivery in 4–7 days.</div>
                                        </div>
                                    </div>

                                    <% cartData.forEach(element=> {
                                        const activeOffer = element.discountSource === 'category'
                                        ? element.offer
                                        : element.productoffer;
                                        const hasActiveOffer = Boolean(
                                        activeOffer &&
                                        activeOffer.isOfferActive &&
                                        element.discountPrice !== undefined &&
                                        element.discountPrice !== null
                                        );
                                        const itemPrice = hasActiveOffer
                                        ? Number(element.discountPrice)
                                        : Number(element.productprice);
                                        %>

                                        <div class="order-product">
                                            <div class="product-image-wrap">
                                                <img src="<%= element.image && element.image.length ? element.image[0] : '' %>"
                                                    alt="<%= element.productname %>" loading="lazy">
                                            </div>

                                            <div class="product-info">
                                                <div class="product-name">
                                                    <%= element.productname %>
                                                </div>

                                                <div class="product-price">
                                                    ₹<%= itemPrice.toLocaleString('en-IN', { minimumFractionDigits: 2,
                                                        maximumFractionDigits: 2 }) %>

                                                        <% if (hasActiveOffer) { %>
                                                            <span class="old-price">
                                                                ₹<%= Number(element.productprice).toLocaleString('en-IN')
                                                                    %>
                                                            </span>

                                                            <div class="offer-label">
                                                                <% if (activeOffer.discountType==='percentage' ) { %>
                                                                    <i class="fa-solid fa-tag me-1"></i>
                                                                    <%= activeOffer.discountValue %>% OFF
                                                                        <% } else if (activeOffer.discountType==='fixed'
                                                                            ) { %>
                                                                            <i class="fa-solid fa-tag me-1"></i>
                                                                            ₹<%= activeOffer.discountValue %> OFF
                                                                                <% } else { %>
                                                                                    <i
                                                                                        class="fa-solid fa-tag me-1"></i>Offer
                                                                                    applied
                                                                                    <% } %>
                                                            </div>
                                                            <% } %>
                                                </div>

                                                <p class="product-quantity">
                                                    Quantity: <%= element.quantity %>
                                                </p>
                                            </div>

                                            <div class="product-line-total">
                                                ₹<%= (itemPrice * Number(element.quantity)).toLocaleString('en-IN', {
                                                    minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                            </div>
                                        </div>

                                        <% }) %>

                                            <hr class="summary-divider">

                                            <div class="summary-row">
                                                <span class="summary-label">Subtotal</span>
                                                <span class="summary-value">
                                                    ₹<%= subtotal.toLocaleString('en-IN', { minimumFractionDigits: 2,
                                                        maximumFractionDigits: 2 }) %>
                                                </span>
                                            </div>

                                            <div class="summary-row">
                                                <span class="summary-label">Coupon discount</span>

                                                <button type="button" class="coupon-trigger" data-bs-toggle="offcanvas"
                                                    data-bs-target="#offcanvasapplycoupon"
                                                    aria-controls="offcanvasapplycoupon">
                                                    <% if (deductedValue) { %>
                                                        <span class="coupon-applied">
                                                            <i class="fa-solid fa-circle-check"></i>
                                                            −₹<%= Number(deductedValue).toLocaleString('en-IN') %>
                                                                <span class="text-muted">Edit</span>
                                                        </span>
                                                        <% } else { %>
                                                            <i class="fa-solid fa-ticket me-1"></i>Apply Coupon
                                                            <% } %>
                                                </button>
                                            </div>

                                            <div class="summary-row">
                                                <span class="summary-label">Shipping fee</span>
                                                <span class="summary-value text-success">FREE</span>
                                            </div>

                                            <hr class="summary-divider">

                                            <div class="grand-total">
                                                <span>Total Payable</span>
                                                <span class="amount">
                                                    ₹<%= Number(finalTotal || subtotal).toLocaleString('en-IN', {
                                                        minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                                </span>
                                            </div>

                                            <button type="submit" form="orderForm" id="placeOrderButton"
                                                class="place-order-btn" <%=!users.address || users.address.length===0
                                                ? 'disabled' : '' %>
                                                >
                                                Place Order <i class="fa-solid fa-arrow-right ms-2"></i>
                                            </button>

                                            <% if (!users.address || users.address.length===0) { %>
                                                <p class="text-danger small text-center mt-2 mb-0">
                                                    Add a delivery address before placing your order.
                                                </p>
                                                <% } %>

                                                    <p class="secure-note">
                                                        <i class="fa-solid fa-shield-halved me-1"></i>
                                                        Your checkout is protected.
                                                    </p>

                                                    <div class="coupon-promo">
                                                        <div class="coupon-promo-icon">
                                                            <i class="fa-solid fa-ticket-simple"></i>
                                                        </div>

                                                        <div class="coupon-promo-text">
                                                            <% if (deductedValue) { %>
                                                                <strong>Coupon applied successfully</strong>
                                                                <small>You saved ₹<%=
                                                                        Number(deductedValue).toLocaleString('en-IN') %>
                                                                        on this order.</small>
                                                                <% } else { %>
                                                                    <strong>Have a coupon code?</strong>
                                                                    <small>Apply an eligible coupon to save on your
                                                                        purchase.</small>
                                                                    <% } %>
                                                        </div>

                                                        <button type="button" class="btn btn-outline-brand btn-sm"
                                                            data-bs-toggle="offcanvas"
                                                            data-bs-target="#offcanvasapplycoupon"
                                                            aria-controls="offcanvasapplycoupon">
                                                            <%= deductedValue ? 'EDIT' : 'APPLY' %>
                                                        </button>
                                                    </div>
                                </section>
                            </div>
                        </div>
            </div>
        </main>

