                <div class="coupon-details flex-grow-1">
                    <% if (coupons && coupons.length> 0) { %>

                        <% coupons.forEach(coupon=> {
                            const couponSaving = coupon.discountType === 'percentage'
                            ? Math.floor(subtotal * coupon.discountValue / 100)
                            : Number(coupon.discountValue);
                            %>

                            <label class="coupon-item" for="coupon-<%= coupon._id %>">
                                <input class="form-check-input coupon-checkbox" type="checkbox"
                                    value="<%= coupon._id %>" id="coupon-<%= coupon._id %>"
                                    data-code="<%= coupon.code %>" data-couponvalue="<%= couponSaving %>"
                                    <%=users.coupon?.couponId?.toString()===coupon._id.toString() ? 'checked' : '' %>
                                >

                                <div class="coupon-item-content">
                                    <span class="coupon-code">
                                        <%= coupon.code %>
                                    </span>

                                    <div class="coupon-saving">
                                        Save ₹<%= couponSaving.toLocaleString('en-IN') %>
                                            <% if (coupon.discountType==='percentage' ) { %>
                                                (<%= coupon.discountValue %>% OFF)
                                                    <% } %>
                                    </div>

                                    <div class="coupon-description">
                                        <%= coupon.description %>
                                    </div>

                                    <div class="coupon-expiry">
                                        <i class="fa-regular fa-clock me-1"></i>
                                        Expires:
                                        <%= new Date(coupon.endDate).toLocaleDateString('en-IN', { day: 'numeric' ,
                                            month: 'short' , year: 'numeric' }) %>
                                            at
                                            <%= new Date(coupon.endDate).toLocaleTimeString('en-IN', { hour: '2-digit' ,
                                                minute: '2-digit' , hour12: true }) %>
                                    </div>
                                </div>
                            </label>

                            <% }) %>

                                <% } else { %>

                                    <div class="text-center py-5">
                                        <i class="fa-solid fa-ticket-simple fs-1 text-secondary mb-3"></i>
                                        <h6 class="fw-bold">No coupons available</h6>
                                        <p class="text-muted small">Please check back later for offers.</p>
                                    </div>

                                    <% } %>
                </div>

                <div class="coupon-bottom mt-auto">
                    <div class="coupon-max-saving">
                        Potential savings
                        <strong id="savings">₹0</strong>
                    </div>

                    <button class="btn btn-brand w-100 mt-3" type="button" onclick="applyCoupon()" <%=!coupons ||
                        coupons.length===0 ? 'disabled' : '' %>
                        >
                        APPLY COUPON
                    </button>

                    <% if (deductedValue) { %>
                        <button class="btn btn-outline-secondary w-100 mt-2" type="button" onclick="removeCoupon()">
