<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Addresses | Shoe Rack</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --address-primary: #f4512c;
            --address-primary-dark: #d83d1b;
            --address-text: #202124;
            --address-muted: #737780;
            --address-border: #e8e9ed;
            --address-background: #f7f8fa;
            --address-white: #ffffff;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: var(--address-background);
            color: var(--address-text);
        }

        .address-page {
            min-height: 65vh;
            padding: 22px 0 60px;
        }

        .address-page .breadcrumb-text {
            color: var(--address-muted);
            font-size: 14px;
            margin-bottom: 26px;
        }

        .address-page .breadcrumb-text a {
            color: var(--address-muted);
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .address-page .breadcrumb-text a:hover {
            color: var(--address-primary);
        }

        .address-page .breadcrumb-current {
            color: var(--address-primary);
            font-weight: 600;
        }

        .address-layout {
            align-items: flex-start;
            row-gap: 24px;
        }

        .address-main-card {
            background: var(--address-white);
            border: 1px solid var(--address-border);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 5px 24px rgba(30, 35, 50, 0.045);
        }

        .address-header {
            padding: 26px 28px;
            border-bottom: 1px solid var(--address-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 18px;
            flex-wrap: wrap;
        }

        .address-header .eyebrow {
            display: block;
            color: var(--address-primary);
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .address-header h1 {
            font-size: 25px;
            font-weight: 700;
            margin: 0 0 7px;
            letter-spacing: -0.5px;
        }

        .address-header p {
            color: var(--address-muted);
            font-size: 13px;
            margin: 0;
            line-height: 1.6;
        }

        .address-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 28px;
            height: 25px;
            padding: 0 8px;
            margin-left: 5px;
            background: #fff0eb;
            color: var(--address-primary);
            border-radius: 7px;
            font-size: 12px;
            font-weight: 700;
            vertical-align: middle;
        }

        .address-add-btn {
            background: var(--address-primary);
            border: 1px solid var(--address-primary);
            color: #fff;
            padding: 11px 17px;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            white-space: nowrap;
            transition: background 0.2s ease, transform 0.2s ease;
        }

        .address-add-btn:hover,
        .address-add-btn:focus {
            background: var(--address-primary-dark);
            border-color: var(--address-primary-dark);
            color: #fff;
            transform: translateY(-1px);
        }

        .address-content {
            padding: 26px 28px 30px;
        }

        .address-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .address-card {
            position: relative;
            padding: 22px;
            border: 1px solid var(--address-border);
            border-radius: 13px;
            background: #fff;
            transition: border-color 0.2s ease, box-shadow 0.2s ease,
                transform 0.2s ease;
            min-width: 0;
        }

        .address-card:hover {
            border-color: #f5b5a5;
            box-shadow: 0 7px 22px rgba(40, 40, 50, 0.06);
            transform: translateY(-2px);
        }

        .address-card-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            padding-right: 2px;
            margin-bottom: 17px;
        }

        .address-recipient {
            font-size: 15px;
            font-weight: 700;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

        .address-type-icon {
            width: 39px;
            height: 39px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff0eb;
            color: var(--address-primary);
            border-radius: 11px;
            font-size: 16px;
        }

        .default-address-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-top: 7px;
            padding: 5px 8px;
            border-radius: 6px;
            background: #eaf8ef;
            color: #218447;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.2px;
        }

        .address-details {
            color: #60646d;
            font-size: 13px;
            line-height: 1.8;
            overflow-wrap: anywhere;
        }

        .address-details p {
            margin: 0 0 5px;
        }

        .address-details .address-phone {
            margin-top: 13px;
            padding-top: 12px;
            border-top: 1px solid #f0f0f2;
            color: #30333a;
            font-weight: 600;
        }

        .address-actions {
            display: flex;
            gap: 10px;
            border-top: 1px solid #f0f0f2;
            padding-top: 15px;
            margin-top: 15px;
        }

        .address-action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            border: 1px solid var(--address-border);
            background: #fff;
            color: #51545d;
            border-radius: 7px;
            padding: 8px 12px;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .address-action-btn:hover {
            color: var(--address-primary);
            border-color: #f5b5a5;
            background: #fff8f5;
        }

        .address-action-btn.delete:hover {
            color: #dc3545;
            border-color: #f1b0b7;
            background: #fff5f5;
        }

        .address-empty {
            text-align: center;
            padding: 65px 20px;
        }

        .address-empty-icon {
            width: 76px;
            height: 76px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            margin: 0 auto 20px;
            background: #fff0eb;
            color: var(--address-primary);
            font-size: 29px;
        }

        .address-empty h3 {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 9px;
        }

        .address-empty p {
            max-width: 350px;
            margin: 0 auto 22px;
            color: var(--address-muted);
            font-size: 13px;
            line-height: 1.7;
        }


        .address-offcanvas {
            --bs-offcanvas-width: min(520px, 100vw);
            border: none;
            box-shadow: -10px 0 35px rgba(0, 0, 0, 0.08);
        }

        .address-offcanvas .offcanvas-header {
            padding: 24px 26px;
            border-bottom: 1px solid var(--address-border);
        }

        .address-offcanvas .offcanvas-header h2 {
            font-size: 20px;
            font-weight: 700;
            margin: 0 0 6px;
        }

        .address-offcanvas .offcanvas-header p {
            color: var(--address-muted);
            font-size: 12px;
            margin: 0;
        }

        .address-offcanvas .offcanvas-body {
            padding: 24px 26px 30px;
        }

        .address-form-label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            color: #454851;
            margin-bottom: 8px;
        }

        .address-form-control {
            min-height: 47px;
            border: 1px solid #dedfe4;
            border-radius: 8px;
            font-size: 13px;
            box-shadow: none !important;
        }

        .address-form-control:focus {
            border-color: var(--address-primary);
        }

        .address-form-control::placeholder {
            color: #a1a3aa;
        }

        .address-form-help {
            color: var(--address-muted);
            font-size: 11px;
            margin-top: 6px;
        }

        .address-default-option {
            display: flex;
            align-items: flex-start;
            gap: 11px;
            padding: 15px;
            border: 1px solid var(--address-border);
            border-radius: 9px;
            margin: 5px 0 22px;
            background: #fcfcfd;
        }

        .address-default-option .form-check-input {
            margin-top: 3px;
            cursor: pointer;
        }

        .address-default-option .form-check-input:checked {
            background-color: var(--address-primary);
            border-color: var(--address-primary);
        }

        .address-default-option label {
            cursor: pointer;
        }

        .address-default-option strong {
            display: block;
            font-size: 12px;
            margin-bottom: 4px;
        }

        .address-default-option small {
            display: block;
            color: var(--address-muted);
            font-size: 11px;
            line-height: 1.5;
        }

        .address-submit-btn {
            width: 100%;
            min-height: 48px;
            border: none;
            border-radius: 9px;
            background: var(--address-primary);
            color: #fff;
            font-size: 13px;
            font-weight: 700;
            transition: background 0.2s ease;
        }

        .address-submit-btn:hover {
            background: var(--address-primary-dark);
            color: #fff;
        }

        .colored-toast {
            color: #fff !important;
        }

        .colored-toast .swal2-title {
            color: #fff !important;
            font-size: 14px !important;
        }

        @media (max-width: 991.98px) {
            .address-content {
                padding: 22px;
            }

            .address-header {
                padding: 23px 22px;
            }

            .address-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 575.98px) {
            .address-page {
                padding-top: 16px;
                padding-bottom: 35px;
            }

            .address-page .breadcrumb-text {
                margin-bottom: 18px;
                font-size: 12px;
            }

            .address-header {
                padding: 21px 17px;
                align-items: stretch;
            }

            .address-header h1 {
                font-size: 21px;
            }

            .address-add-btn {
                width: 100%;
            }

            .address-content {
                padding: 17px;
            }

            .address-card {
                padding: 17px;
            }

            .address-offcanvas .offcanvas-header,
            .address-offcanvas .offcanvas-body {
                padding-left: 18px;
                padding-right: 18px;
            }
        }
    </style>
</head>

<body>
    <%- include('../partials/userHeader') %>

        <main class="address-page">
            <div class="container">
                <nav class="breadcrumb-text" aria-label="Breadcrumb">
                    <a href="/">Home</a>
                    <span class="mx-2">/</span>
                    <a href="/account">Account</a>
                    <span class="mx-2">/</span>
                    <span class="breadcrumb-current">Addresses</span>
                </nav>


                <% if (message && message.message) { %>
                    <div id="flash-message" hidden>
                        <%= message.message %>
                    </div>

                    <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            const messageElement = document.getElementById('flash-message');

                            if (messageElement) {
                                Swal.fire({
                                    toast: true,
                                    position: 'top-end',
                                    title: messageElement.textContent.trim(),
                                    showConfirmButton: false,
                                    timer: 2500,
                                    timerProgressBar: true,
                                    background: '#218838',
                                    color: '#fff',
                                    customClass: {
                                        popup: 'colored-toast'
                                    }
                                });
                            }
                        });
                    </script>
                    <% } %>

                        <div class="row address-layout">
                            <aside class="col-lg-3 col-md-4">
                                <%- include('../partials/account-nav') %>
                            </aside>

                            <section class="col-lg-9 col-md-8">
                                <div class="address-main-card">
                                    <div class="address-header">
                                        <div>
                                            <span class="eyebrow">Your account</span>
                                            <h1>
                                                Shipping addresses
                                                <% if (users && users.address) { %>
                                                    <span class="address-count">
                                                        <%= users.address.length %>
                                                    </span>
                                                    <% } %>
                                            </h1>
                                            <p>Manage your delivery addresses for a smoother checkout.</p>
                                        </div>

                                        <button class="btn address-add-btn" type="button" data-bs-toggle="offcanvas"
                                            data-bs-target="#offcanvasWithBothOptions"
                                            aria-controls="offcanvasWithBothOptions">
                                            <i class="fa-solid fa-plus"></i>
                                            Add address
                                        </button>
                                    </div>

                                    <div class="address-content">
                                        <% if (users && users.address && users.address.length> 0) { %>
                                            <div class="address-grid">
                                                <% users.address.forEach(element=> { %>
                                                    <article class="address-card">
                                                        <div class="address-card-top">
                                                            <div>
                                                                <div class="address-recipient">
                                                                    <%= element.fullname %>
                                                                </div>

                                                                <% if (element.default===true ||
                                                                    String(element.default).trim()==='true' ) { %>
                                                                    <span class="default-address-badge">
                                                                        <i class="fa-solid fa-circle-check"></i>
                                                                        DEFAULT ADDRESS
                                                                    </span>
                                                                    <% } %>
                                                            </div>

                                                            <div class="address-type-icon">
                                                                <i class="fa-solid fa-house"></i>
                                                            </div>
                                                        </div>

                                                        <div class="address-details">
                                                            <p>
                                                                <%= element.houseno %>, <%= element.area %>
                                                            </p>

                                                            <% if (element.landmark) { %>
                                                                <p>
                                                                    <%= element.landmark %>
                                                                </p>
                                                                <% } %>

                                                                    <p>
                                                                        <%= element.town %>, <%= element.state %>
                                                                    </p>

                                                                    <p>PIN: <%= element.pincode %>
                                                                    </p>

                                                                    <p class="address-phone">
                                                                        <i class="fa-solid fa-phone me-2"></i>
                                                                        <%= element.phoneno %>
                                                                    </p>
                                                        </div>

                                                        <div class="address-actions">
                                                            <button type="button" class="address-action-btn"
                                                                data-bs-toggle="offcanvas"
                                                                data-bs-target="#offcanvasEditAddress"
                                                                aria-controls="offcanvasEditAddress"
                                                                data-id="<%= element._id %>"
                                                                data-fullname="<%= element.fullname %>"
                                                                data-houseno="<%= element.houseno %>"
                                                                data-area="<%= element.area %>"
                                                                data-landmark="<%= element.landmark || '' %>"
                                                                data-town="<%= element.town %>"
                                                                data-state="<%= element.state %>"
                                                                data-pincode="<%= element.pincode %>"
                                                                data-phoneno="<%= element.phoneno %>"
                                                                data-default="<%= element.default %>"
                                                                onclick="populateEditForm(this)">
                                                                <i class="fa-solid fa-pen"></i>
                                                                Edit
                                                            </button>

                                                            <button type="button" class="address-action-btn delete"
                                                                onclick="deleteAddress('<%= element._id %>')">
                                                                <i class="fa-regular fa-trash-can"></i>
                                                                Delete
                                                            </button>
                                                        </div>
                                                    </article>
                                                    <% }) %>
                                            </div>
                                            <% } else { %>
                                                <div class="address-empty">
                                                    <div class="address-empty-icon">
                                                        <i class="fa-solid fa-location-dot"></i>
                                                    </div>

                                                    <h3>No addresses yet</h3>

                                                    <p>
                                                        You haven't added a delivery address.
                                                        Add one to make your next Shoe Rack purchase easier.
                                                    </p>

                                                    <button class="btn address-add-btn mx-auto" type="button"
                                                        data-bs-toggle="offcanvas"
                                                        data-bs-target="#offcanvasWithBothOptions"
                                                        aria-controls="offcanvasWithBothOptions">
                                                        <i class="fa-solid fa-plus"></i>
                                                        Add your first address
                                                    </button>
                                                </div>
                                                <% } %>
                                    </div>
                                </div>
                            </section>
                        </div>
            </div>
        </main>

        <div class="offcanvas offcanvas-end address-offcanvas" tabindex="-1" id="offcanvasWithBothOptions"
            aria-labelledby="addAddressTitle" data-bs-scroll="true">

            <div class="offcanvas-header">
                <div>
                    <h2 id="addAddressTitle">Add new address</h2>
                    <p>Enter the details for your delivery location.</p>
                </div>

                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close">
                </button>
            </div>

            <div class="offcanvas-body">
                <form action="/addaddress" method="post" id="add-address-form">
                    <div class="mb-3">
                        <label class="address-form-label" for="fullname">Full name</label>
                        <input type="text" class="form-control address-form-control" id="fullname" name="fullname"
                            placeholder="Enter recipient's full name" autocomplete="name" maxlength="100" required>
                    </div>

                    <div class="mb-3">
                        <label class="address-form-label" for="phoneno">Phone number</label>
                        <input type="tel" class="form-control address-form-control" id="phoneno" name="phoneno"
                            placeholder="10-digit mobile number" inputmode="numeric" pattern="[0-9]{10}" maxlength="10"
                            autocomplete="tel" required>
                    </div>

                    <div class="mb-3">
                        <label class="address-form-label" for="houseno">House / building</label>
                        <input type="text" class="form-control address-form-control" id="houseno" name="houseno"
                            placeholder="House number, apartment, building" maxlength="200" autocomplete="address-line1"
                            required>
                    </div>

                    <div class="mb-3">
                        <label class="address-form-label" for="area">Area / street</label>
                        <input type="text" class="form-control address-form-control" id="area" name="area"
                            placeholder="Area, street, sector or village" maxlength="200" autocomplete="address-line2"
                            required>
                    </div>

                    <div class="mb-3">
                        <label class="address-form-label" for="landmark">Landmark</label>
                        <input type="text" class="form-control address-form-control" id="landmark" name="landmark"
                            placeholder="Nearby landmark" maxlength="200">
                        <div class="address-form-help">Optional — helps the delivery person find you.</div>
                    </div>

                    <div class="mb-3">
                        <label class="address-form-label" for="town">Town / city</label>
                        <input type="text" class="form-control address-form-control" id="town" name="town"
                            placeholder="Enter town or city" maxlength="100" autocomplete="address-level2" required>
                    </div>

                    <div class="row">
                        <div class="col-sm-7 mb-3">
                            <label class="address-form-label" for="state">State</label>
                            <select class="form-select address-form-control" id="state" name="state"
                                autocomplete="address-level1" required>
                                <option value="Kerala">Kerala</option>
                                <option value="Tamil Nadu">Tamil Nadu</option>
                                <option value="Karnataka">Karnataka</option>
                                <option value="Andhra Pradesh">Andhra Pradesh</option>
                                <option value="Telangana">Telangana</option>
                                <option value="Maharashtra">Maharashtra</option>
                                <option value="Goa">Goa</option>
                                <option value="Delhi">Delhi</option>
                                <option value="Gujarat">Gujarat</option>
                                <option value="Rajasthan">Rajasthan</option>
                                <option value="Uttar Pradesh">Uttar Pradesh</option>
                                <option value="West Bengal">West Bengal</option>
                                <option value="Punjab">Punjab</option>
                                <option value="Haryana">Haryana</option>
                                <option value="Bihar">Bihar</option>
                                <option value="Odisha">Odisha</option>
                                <option value="Madhya Pradesh">Madhya Pradesh</option>
                                <option value="Chhattisgarh">Chhattisgarh</option>
                                <option value="Jharkhand">Jharkhand</option>
                                <option value="Assam">Assam</option>
                                <option value="Himachal Pradesh">Himachal Pradesh</option>
                                <option value="Uttarakhand">Uttarakhand</option>
                                <option value="Jammu and Kashmir">Jammu and Kashmir</option>
                                <option value="Ladakh">Ladakh</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="col-sm-5 mb-3">
                            <label class="address-form-label" for="pincode">PIN code</label>
                            <input type="text" class="form-control address-form-control" id="pincode" name="pincode"
                                placeholder="6-digit PIN" inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
                                autocomplete="postal-code" required>
                        </div>
                    </div>

                    <div class="address-default-option">
                        <input class="form-check-input" type="checkbox" value="true" id="checkadd" name="default">

                        <label for="checkadd">
                            <strong>Set as default address</strong>
                            <small>Use this address as your preferred delivery address.</small>
                        </label>
                    </div>

                    <button class="btn address-submit-btn" type="submit">
                        <i class="fa-solid fa-plus me-2"></i>
                        Save address
                    </button>
                </form>
            </div>
        </div>

        <div class="offcanvas offcanvas-end address-offcanvas" tabindex="-1" id="offcanvasEditAddress"
            aria-labelledby="editAddressTitle" data-bs-scroll="true">

            <div class="offcanvas-header">
                <div>
                    <h2 id="editAddressTitle">Edit address</h2>
                    <p>Update your delivery information below.</p>
                </div>

                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close">
                </button>
            </div>

            <div class="offcanvas-body">
                <form method="post" action="#" id="edit-address-form">
                    <div class="mb-3">
                        <label class="address-form-label" for="edit-fullname">Full name</label>
                        <input type="text" class="form-control address-form-control" id="edit-fullname" name="fullname"
                            maxlength="100" autocomplete="name" required>
                    </div>

                    <div class="mb-3">
                        <label class="address-form-label" for="edit-phoneno">Phone number</label>
                        <input type="tel" class="form-control address-form-control" id="edit-phoneno" name="phoneno"
                            inputmode="numeric" pattern="[0-9]{10}" maxlength="10" autocomplete="tel" required>
                    </div>

                    <div class="mb-3">
                        <label class="address-form-label" for="edit-houseno">House / building</label>
                        <input type="text" class="form-control address-form-control" id="edit-houseno" name="houseno"
                            maxlength="200" autocomplete="address-line1" required>
                    </div>

                    <div class="mb-3">
                        <label class="address-form-label" for="edit-area">Area / street</label>
                        <input type="text" class="form-control address-form-control" id="edit-area" name="area"
                            maxlength="200" autocomplete="address-line2" required>
                    </div>

                    <div class="mb-3">
                        <label class="address-form-label" for="edit-landmark">Landmark</label>
                        <input type="text" class="form-control address-form-control" id="edit-landmark" name="landmark"
                            maxlength="200">
                    </div>

                    <div class="mb-3">
                        <label class="address-form-label" for="edit-town">Town / city</label>
                        <input type="text" class="form-control address-form-control" id="edit-town" name="town"
                            maxlength="100" autocomplete="address-level2" required>
                    </div>

                    <div class="row">
                        <div class="col-sm-7 mb-3">
                            <label class="address-form-label" for="edit-state">State</label>
                            <select class="form-select address-form-control" id="edit-state" name="state"
                                autocomplete="address-level1" required>
                                <option value="Kerala">Kerala</option>
                                <option value="Tamil Nadu">Tamil Nadu</option>
                                <option value="Karnataka">Karnataka</option>
                                <option value="Andhra Pradesh">Andhra Pradesh</option>
                                <option value="Telangana">Telangana</option>
                                <option value="Maharashtra">Maharashtra</option>
                                <option value="Goa">Goa</option>
                                <option value="Delhi">Delhi</option>
                                <option value="Gujarat">Gujarat</option>
                                <option value="Rajasthan">Rajasthan</option>
                                <option value="Uttar Pradesh">Uttar Pradesh</option>
                                <option value="West Bengal">West Bengal</option>
                                <option value="Punjab">Punjab</option>
                                <option value="Haryana">Haryana</option>
                                <option value="Bihar">Bihar</option>
                                <option value="Odisha">Odisha</option>
                                <option value="Madhya Pradesh">Madhya Pradesh</option>
                                <option value="Chhattisgarh">Chhattisgarh</option>
                                <option value="Jharkhand">Jharkhand</option>
                                <option value="Assam">Assam</option>
                                <option value="Himachal Pradesh">Himachal Pradesh</option>
                                <option value="Uttarakhand">Uttarakhand</option>
                                <option value="Jammu and Kashmir">Jammu and Kashmir</option>
                                <option value="Ladakh">Ladakh</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="col-sm-5 mb-3">
                            <label class="address-form-label" for="edit-pincode">PIN code</label>
                            <input type="text" class="form-control address-form-control" id="edit-pincode"
                                name="pincode" inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
                                autocomplete="postal-code" required>
                        </div>
                    </div>

                    <div class="address-default-option">
                        <input class="form-check-input" type="checkbox" value="true" id="flexCheckDefault"
                            name="default">

                        <label for="flexCheckDefault">
                            <strong>Set as default address</strong>
                            <small>Use this address as your preferred delivery address.</small>
                        </label>
                    </div>

                    <button class="btn address-submit-btn" type="submit">
                        <i class="fa-solid fa-check me-2"></i>
                        Update address
                    </button>
                </form>
            </div>
        </div>

        <%- include('../partials/userfooter') %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

            <script>
                $(document).ready(function () {
                    const navItems = $('.account-navitem a');

                    navItems.each(function () {
                        const href = $(this).attr('href');

                        if (href && window.location.pathname === href) {
                            $(this).parent().addClass('active');
                        }
                    });
                });

                function deleteAddress(addressId) {
                    const confirmed = window.confirm(
                        'Are you sure you want to delete this address?'
                    );

                    if (confirmed) {
                        window.location.href =
                            `/delete-address/${encodeURIComponent(addressId)}`;
                    }
                }

                function populateEditForm(button) {
                    const addressId = button.dataset.id;

                    const fields = {
                        'edit-fullname': button.dataset.fullname,
                        'edit-houseno': button.dataset.houseno,
                        'edit-area': button.dataset.area,
                        'edit-landmark': button.dataset.landmark,
                        'edit-town': button.dataset.town,
                        'edit-state': button.dataset.state,
                        'edit-pincode': button.dataset.pincode,
                        'edit-phoneno': button.dataset.phoneno
                    };

                    Object.entries(fields).forEach(([fieldId, value]) => {
                        const field = document.getElementById(fieldId);

                        if (field) {
                            field.value = value || '';
                        }
                    });

                    const defaultCheckbox =
                        document.getElementById('flexCheckDefault');

                    defaultCheckbox.checked =
                        String(button.dataset.default).trim().toLowerCase() === 'true';

                    document.getElementById('edit-address-form').action =
                        `/edit-address/${encodeURIComponent(addressId)}`;
                }


                document.querySelectorAll('#add-address-form, #edit-address-form')
                    .forEach(form => {
                        form.addEventListener('submit', function (event) {
                            if (!form.checkValidity()) {
                                event.preventDefault();
                                event.stopPropagation();
                            }

                            form.classList.add('was-validated');
                        });
                    });
            </script>
</body>

</html>