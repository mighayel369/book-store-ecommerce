<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Details | Shoe Rack</title>
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet">
  <style>
    body {
      background: #f5f6fa;
      color: #242424;
    }

    .order-container {
      max-width: 1100px;
      margin: 35px auto;
      padding: 0 15px;
    }

    .order-card {
      background: #fff;
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 22px;
      box-shadow: 0 3px 15px rgba(0, 0, 0, 0.05);
    }

    .section-title {
      font-size: 19px;
      font-weight: 600;
      margin-bottom: 18px;
    }

    .detail-label {
      color: #777;
      font-size: 13px;
      margin-bottom: 5px;
    }

    .detail-value {
      font-weight: 500;
      overflow-wrap: anywhere;
    }

    .status {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      background: #e9ecef;
      color: #333;
    }

    .status.delivered {
      background: #d1e7dd;
      color: #0f5132;
    }

    .status.cancelled,
    .status.canceled,
    .status.returned {
      background: #f8d7da;
      color: #842029;
    }

    .status.pending,
    .status.confirmed,
    .status.shipped {
      background: #fff3cd;
      color: #664d03;
    }

    .product-name {
      font-weight: 600;
    }

    .price-summary {
      max-width: 450px;
      margin-left: auto;
    }

    .price-row {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      padding: 9px 0;
    }

    .grand-total {
      font-size: 19px;
      font-weight: 700;
      border-top: 1px solid #ddd;
      margin-top: 8px;
      padding-top: 15px;
    }

    .action-btn {
      margin: 3px;
    }

    @media (max-width: 576px) {
      .order-card {
        padding: 16px;
      }

      .order-container {
        margin-top: 20px;
      }
    }
  </style>
</head>

<body>

  <%- include('../partials/userHeader') %>

    <main class="order-container">

      <% if (!orderDetails) { %>
        <div class="alert alert-warning">
          Order details are unavailable.
        </div>
        <% } else { %>

          <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
              <h2 class="mb-1">Order Details</h2>
              <p class="text-muted mb-0">
                Order ID:
                <strong>
                  <%= orderDetails.orderId || orderDetails._id %>
                </strong>
              </p>
            </div>

            <button type="button" class="btn btn-outline-dark" id="downloadInvoiceBtn">
              Download Invoice
            </button>
          </div>

          <section class="order-card">
            <h3 class="section-title">Order Information</h3>

            <div class="row g-4">
              <div class="col-md-4">
                <div class="detail-label">Order Date</div>
                <div class="detail-value">
                  <%= orderDetails.createdAt ? new Date(orderDetails.createdAt).toLocaleDateString('en-IN') : 'N/A' %>
                </div>
              </div>

              <div class="col-md-4">
                <div class="detail-label">Order Status</div>
                <div class="detail-value">
                  <span class="status <%= String(orderDetails.status || 'Pending').toLowerCase() %>">
                    <%= orderDetails.status || 'Pending' %>
                  </span>
                </div>
              </div>

              <div class="col-md-4">
                <div class="detail-label">Payment Method</div>
                <div class="detail-value">
                  <%= orderDetails.paymentMethod || 'N/A' %>
                </div>
              </div>

              <div class="col-md-4">
                <div class="detail-label">Payment Status</div>
                <div class="detail-value">
                  <%= orderDetails.paymentStatus || 'Pending' %>
                </div>
              </div>

              <div class="col-md-4">
                <div class="detail-label">Expected Delivery</div>
                <div class="detail-value">
                  <%= orderDetails.deliveryExpected ? new
                    Date(orderDetails.deliveryExpected).toLocaleDateString('en-IN') : 'Not available' %>
                </div>
              </div>
            </div>
          </section>

          <section class="order-card">
            <h3 class="section-title">Customer Information</h3>

            <div class="row g-4">
              <div class="col-md-6">
                <div class="detail-label">Customer Name</div>
                <div class="detail-value">
                  <%= users?.name || users?.username || 'N/A' %>
                </div>
              </div>

              <div class="col-md-6">
                <div class="detail-label">Email</div>
                <div class="detail-value">
                  <%= users?.email || 'N/A' %>
                </div>
              </div>
            </div>
          </section>

          <section class="order-card">
            <h3 class="section-title">Delivery Address</h3>

            <% if (orderDetails.shippingAddress) { %>
              <% const address=orderDetails.shippingAddress; %>

                <p class="mb-1">
                  <strong>
                    <%= address.name || address.fullName || '' %>
                  </strong>
                </p>

                <p class="mb-1">
                  <%= address.address || address.addressLine || '' %>
                </p>

                <p class="mb-1">
                  <%= [address.city, address.state, address.pincode || address.pinCode] .filter(Boolean) .join(', ') %>
          </p>

          <% if (address.phone) { %>
            <p class="mb-0">Phone: <%= address.phone %></p>
          <% } %>
        <% } else { %>
          <p class="text-muted mb-0">Address information is unavailable.</p>
        <% } %>
      </section>

      <section class="order-card">
        <h3 class="section-title">Ordered Products</h3>

        <% if (orderDetails.products && orderDetails.products.length > 0) { %>

          <div class="table-responsive">
            <table class="table align-middle">
              <thead>
                <tr>
                  <th>Product</th>
                  <th>Unit Price</th>
                  <th>Quantity</th>
                  <th>Total</th>
                  <th>Status</th>
                  <th>Action</th>
                </tr>
              </thead>

              <tbody>
                <% orderDetails.products.forEach((product, index) => { %>

<%
  const productStatus =
    product.orderStatus || orderDetails.status || ' Pending'; const
                    normalizedStatus=String(productStatus).toLowerCase(); const
                    originalPrice=Number(product.productprice || 0); const discountPrice=Number(product.discountPrice ||
                    0); const unitPrice=discountPrice> 0 &&
                    discountPrice < originalPrice ? discountPrice : originalPrice; const
                      quantity=Number(product.quantity || 0); const productTotal=unitPrice * quantity; const
                      isCancelled=['canceled', 'cancelled' ].includes(normalizedStatus); const
                      isReturned=normalizedStatus==='returned' ; const isDelivered=normalizedStatus==='delivered' ;
                      const canCancel=!isCancelled && !isReturned && !isDelivered; const canRequestReturn=isDelivered &&
                      !product.returnRequest; %>
                      <tr>
                        <td>
                          <div class="product-name">
                            <%= product.productName || 'Product' %>
                          </div>

                          <% if (product.productId) { %>
                            <small class="text-muted">
                              Product ID: <%= product.productId %>
                            </small>
                            <% } %>
                        </td>

                        <td>
                          <% if (unitPrice < originalPrice) { %>
                            <del class="text-muted">
                              ₹<%= originalPrice.toFixed(2) %>
                            </del>
                            <br>
                            <% } %>

                              ₹<%= unitPrice.toFixed(2) %>
                        </td>

                        <td>
                          <%= quantity %>
                        </td>

                        <td>₹<%= productTotal.toFixed(2) %>
                        </td>

                        <td>
                          <span class="status <%= normalizedStatus %>">
                            <%= productStatus %>
                          </span>

                          <% if (isDelivered && product.returnRequest) { %>
                            <div class="mt-2">
                              <small>
                                Return: <%= product.returnRequest %>
                              </small>
                            </div>
                            <% } %>
                        </td>

                        <td>
                          <% if (isCancelled) { %>

                            <span class="text-danger">Product canceled</span>

                            <% } else if (isReturned) { %>

                              <span class="text-danger">Product returned</span>

                              <% } else if (canRequestReturn) { %>

                                <button type="button"
                                  class="btn btn-outline-warning btn-sm action-btn return-product-btn"
                                  data-order-id="<%= orderDetails._id %>" data-product-id="<%= product.productId %>">
                                  Return Product
                                </button>

                                <% } else if (canCancel) { %>

                                  <button type="button"
                                    class="btn btn-outline-danger btn-sm action-btn cancel-product-btn"
                                    data-order-id="<%= orderDetails._id %>" data-product-id="<%= product.productId %>">
                                    Cancel Product
                                  </button>

                                  <% } else { %>

                                    <span class="text-muted">No action available</span>

                                    <% } %>
                        </td>
                      </tr>

                      <% }); %>
                        </tbody>
                        </table>
                        </div>

                        <% } else { %>

                          <p class="text-muted mb-0">No products found for this order.</p>

                          <% } %>
          </section>

          <section class="order-card">
            <h3 class="section-title">Price Summary</h3>

            <% const subtotal=Number(orderDetails.totalAmount || 0); const grandTotal=orderDetails.finalPrice !=null ?
              Number(orderDetails.finalPrice) : subtotal; const couponDiscount=Math.max(0, subtotal - grandTotal); %>

              <div class="price-summary">

                <div class="price-row">
                  <span>Subtotal</span>
                  <span>₹<%= subtotal.toFixed(2) %></span>
                </div>

                <div class="price-row">
                  <span>Shipping Fee</span>
                  <span>FREE</span>
                </div>

                <div class="price-row">
                  <span>Coupon Discount</span>
                  <span>- ₹<%= couponDiscount.toFixed(2) %></span>
                </div>

                <div class="price-row grand-total">
                  <span>Grand Total</span>
                  <span>₹<%= grandTotal.toFixed(2) %></span>
                </div>

              </div>
          </section>

          <% } %>

            <div id="orderData" data-order-id="<%= orderDetails._id %>" hidden></div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

      const orderElement = document.getElementById('orderData');
      const orderId = orderElement?.dataset.orderId || '';
      document
        .getElementById('downloadInvoiceBtn')
        ?.addEventListener('click', () => {
          if (!orderId) return;

          window.location.href =
            `/downloadinvoice/${encodeURIComponent(orderId)}`;
        });


      document.querySelectorAll('.cancel-product-btn').forEach(button => {
        button.addEventListener('click', async () => {
          const orderId = button.dataset.orderId;
          const productId = button.dataset.productId;

          const result = await Swal.fire({
            title: 'Cancel Product?',
            text: 'Please provide a reason for cancelling this product.',
            input: 'textarea',
            inputPlaceholder: 'Enter cancellation reason...',
            inputAttributes: {
              'aria-label': 'Cancellation reason',
              maxlength: 500
            },
            showCancelButton: true,
            confirmButtonText: 'Confirm Cancellation',
            cancelButtonText: 'Go Back',
            confirmButtonColor: '#dc3545',
            inputValidator: value => {
              if (!value || !value.trim()) {
                return 'Please enter a cancellation reason.';
              }
            }
          });

          if (!result.isConfirmed) return;

          button.disabled = true;

          try {
            const response = await fetch('/order/cancel', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                orderId: orderId,
                productId: productId,
                reason: result.value.trim()
              })
            });

            const data = await response.json();

            if (!response.ok) {
              throw new Error(
                data.message || 'Unable to cancel this product.'
              );
            }

            await Swal.fire({
              icon: 'success',
              title: 'Product Cancelled',
              text: data.message || 'Product cancelled successfully.',
              confirmButtonText: 'OK'
            });

            window.location.reload();

          } catch (error) {
            await Swal.fire({
              icon: 'error',
              title: 'Cancellation Failed',
              text: error.message || 'Something went wrong.'
            });
          } finally {
            button.disabled = false;
          }
        });
      });


      document.querySelectorAll('.return-product-btn').forEach(button => {
        button.addEventListener('click', async () => {
          const currentOrderId = button.dataset.orderId;
          const productId = button.dataset.productId;

          const result = await Swal.fire({
            title: 'Return Product?',
            text: 'Please provide a reason for returning this product.',
            input: 'textarea',
            inputPlaceholder: 'Enter return reason...',
            showCancelButton: true,
            confirmButtonText: 'Submit Return',
            cancelButtonText: 'Go Back',
            inputValidator: value => {
              if (!value || !value.trim()) {
                return 'Please enter a return reason.';
              }
            }
          });

          if (!result.isConfirmed) return;

          try {
            const response = await fetch('/order/return', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                orderId: currentOrderId,
                productId: productId,
                reason: result.value.trim()
              })
            });

            const data = await response.json();

            if (!response.ok) {
              throw new Error(data.message || 'Unable to submit return request.');
            }

            await Swal.fire({
              icon: 'success',
              title: 'Return Request Submitted',
              text: data.message
            });

            window.location.reload();

          } catch (error) {
            Swal.fire({
              icon: 'error',
              title: 'Return Failed',
              text: error.message || 'Something went wrong.'
            });
          }
        });
      });
    </script>

    <%- include('../partials/userfooter') %>

</body>

</html>