<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Shoe Rack | Find Your Perfect Pair</title>

  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet">
  <style>
    :root {
      --primary: #f4512c;
      --primary-dark: #d93b1b;
      --dark: #171717;
      --text: #555;
      --muted: #888;
      --light: #f7f7f5;
      --border: #ececec;
      --white: #fff;
      --success: #218838;
      --danger: #dc3545;
      --radius: 16px;
      --shadow: 0 8px 28px rgba(0, 0, 0, 0.07);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--white);
      color: var(--dark);
      font-family: Arial, Helvetica, sans-serif;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      max-width: 100%;
    }

    .home-container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 28px 60px;
    }



    .section-heading {
      margin-bottom: 30px;
      text-align: center;
    }

    .section-eyebrow {
      display: block;
      margin-bottom: 8px;
      color: var(--primary);
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    .custom-heading {
      display: inline-block;
      color: var(--dark);
      font-size: clamp(1.7rem, 3vw, 2.5rem);
      font-weight: 800;
      letter-spacing: -1px;
      line-height: 1.2;
    }

    .section-description {
      max-width: 550px;
      margin: 12px auto 0;
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.7;
    }


    .hero-section {
      margin-top: 24px;
    }

    .hero-carousel {
      position: relative;
      overflow: hidden;
      border-radius: 22px;
      background: #f3f1ed;
      box-shadow: var(--shadow);
    }

    .hero-carousel .carousel-inner {
      height: clamp(260px, 42vw, 540px);
    }

    .hero-carousel .carousel-item {
      height: 100%;
    }

    .carousel-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .hero-carousel .carousel-control-prev,
    .hero-carousel .carousel-control-next {
      width: 8%;
    }

    .hero-carousel .carousel-control-prev-icon,
    .hero-carousel .carousel-control-next-icon {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background-color: rgba(0, 0, 0, 0.55);
      background-size: 45%;
    }


    .home-section {
      margin-top: 76px;
    }



    .product-grid {
      row-gap: 26px;
    }

    .product-column {
      display: flex;
    }

    .product-card {
      width: 100%;
      min-width: 0;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--white);
      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease,
        border-color 0.3s ease;
    }

    .product-card:hover {
      transform: translateY(-5px);
      border-color: #dedede;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.09);
    }

    .img-wrapper {
      position: relative;
      overflow: hidden;
      height: 250px;
      background: #f6f6f4;
    }

    .product-image-link {
      display: block;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    .product-image {
      display: block;
      width: 100%;
      height: 100%;
      padding: 12px;
      object-fit: contain;
      transition: transform 0.45s ease;
    }

    .product-card:hover .product-image {
      transform: scale(1.08);
    }


    .wishlist-action {
      position: absolute;
      z-index: 2;
      right: 12px;
      bottom: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      min-width: 44px;
      min-height: 42px;
      padding: 10px 14px;
      border: 1px solid #e4e4e4;
      border-radius: 24px;
      background: var(--white);
      color: var(--dark);
      cursor: pointer;
      opacity: 0;
      visibility: hidden;
      transform: translateY(6px);
      transition:
        opacity 0.25s ease,
        visibility 0.25s ease,
        transform 0.25s ease,
        background 0.25s ease;
    }

    .img-wrapper:hover .wishlist-action,
    .wishlist-action.wishlisted {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .wishlist-action:hover {
      background: #fff0ed;
      color: var(--primary);
    }

    .wishlist-action.wishlisted {
      border-color: var(--danger);
      background: var(--danger);
      color: var(--white);
    }

    .wishlist-action i {
      font-size: 1rem;
    }

    .wishlist-text {
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.4px;
    }


    .product-card .card-body {
      display: flex;
      flex-direction: column;
      padding: 19px;
    }

    .brand-name {
      margin: 0 0 8px;
      color: var(--primary);
      font-size: 0.73rem;
      font-weight: 800;
      letter-spacing: 1.3px;
      text-transform: uppercase;
    }

    .card-title {
      display: -webkit-box;
      min-height: 44px;
      margin: 0 0 15px;
      overflow: hidden;
      color: var(--dark);
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.45;
      text-transform: capitalize;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }

    .allfeatures {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-top: auto;
    }

    .price {
      margin: 0;
      color: var(--dark);
      font-size: 1.08rem;
      font-weight: 800;
      line-height: 1.6;
    }

    .original-price {
      margin-left: 4px;
      color: #999;
      font-size: 0.76rem;
      font-weight: 400;
      text-decoration: line-through;
    }

    .discount-label {
      display: inline-block;
      margin-top: 3px;
      color: #168345;
      font-size: 0.73rem;
      font-weight: 700;
    }

    .addtobag {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      padding: 9px 11px;
      border: 1px solid var(--dark);
      border-radius: 8px;
      background: var(--dark);
      color: var(--white);
      font-size: 0.78rem;
      font-weight: 700;
      white-space: nowrap;
      cursor: pointer;
      transition:
        background 0.25s ease,
        border-color 0.25s ease;
    }

    .addtobag:hover {
      border-color: var(--primary);
      background: var(--primary);
    }

    .addtobag.added {
      border-color: var(--success);
      background: var(--success);
    }

    .out-of-stock {
      margin: 0;
      color: var(--danger);
      font-size: 0.82rem;
      font-weight: 800;
    }



    .category-grid {
      row-gap: 26px;
    }

    .category-card {
      display: block;
      height: 100%;
      color: var(--dark);
      text-align: center;
    }

    .category-image-wrapper {
      height: 210px;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: #f6f6f4;
    }

    .category-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.45s ease;
    }

    .category-card:hover .category-image {
      transform: scale(1.08);
    }

    .category-name {
      margin: 14px 0 0;
      font-size: 1rem;
      font-weight: 800;
      transition: color 0.25s ease;
    }

    .category-card:hover .category-name {
      color: var(--primary);
    }

    .category-link-label {
      display: inline-block;
      margin-top: 5px;
      color: var(--muted);
      font-size: 0.8rem;
    }


    .offer-grid {
      row-gap: 26px;
    }

    .offer-card {
      height: 100%;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--white);
      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
    }

    .offer-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow);
    }

    .offer-image-wrapper {
      height: 220px;
      overflow: hidden;
      background: #f5f5f5;
    }

    .offer-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }

    .offer-card:hover .offer-image {
      transform: scale(1.04);
    }

    .offer-content {
      padding: 22px;
    }

    .offer-tag {
      display: inline-block;
      margin-bottom: 12px;
      padding: 6px 10px;
      border-radius: 6px;
      background: #fff0ed;
      color: var(--primary-dark);
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .offer-title {
      margin: 0 0 12px;
      color: var(--dark);
      font-size: 1.15rem;
      font-weight: 800;
      line-height: 1.45;
    }

    .offer-description {
      margin-bottom: 16px;
      color: var(--text);
      font-size: 0.9rem;
    }

    .offer-code {
      color: var(--success);
      font-weight: 800;
    }

    .redeem-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 5px;
      padding: 11px 18px;
      border: 1px solid var(--primary);
      border-radius: 8px;
      background: var(--primary);
      color: var(--white);
      font-size: 0.85rem;
      font-weight: 700;
      transition: background 0.25s ease;
    }

    .redeem-btn:hover {
      border-color: var(--primary-dark);
      background: var(--primary-dark);
      color: var(--white);
    }

    .countdown {
      margin-top: 14px;
      padding: 12px;
      border-radius: 8px;
      background: var(--light);
      color: var(--primary-dark);
      font-size: 0.87rem;
      font-weight: 800;
      line-height: 1.5;
    }


    .empty-state {
      padding: 35px 15px;
      color: var(--muted);
      text-align: center;
    }

    .empty-state i {
      margin-bottom: 12px;
      color: #ccc;
      font-size: 2rem;
    }

    .colored-toast {
      border-radius: 12px !important;
      color: var(--white) !important;
    }

    .toast-text {
      color: var(--white) !important;
    }


    @media (max-width: 991px) {
      .home-container {
        padding-right: 20px;
        padding-left: 20px;
      }

      .img-wrapper {
        height: 220px;
      }

      .category-image-wrapper {
        height: 190px;
      }

      .home-section {
        margin-top: 60px;
      }
    }

    @media (max-width: 575px) {
      .home-container {
        padding-right: 14px;
        padding-left: 14px;
      }

      .hero-carousel {
        border-radius: 13px;
      }

      .hero-carousel .carousel-inner {
        height: 230px;
      }

      .home-section {
        margin-top: 48px;
      }

      .section-heading {
        margin-bottom: 22px;
      }

      .img-wrapper {
        height: 175px;
      }

      .product-card .card-body {
        padding: 12px;
      }

      .card-title {
        min-height: 42px;
        font-size: 0.9rem;
      }

      .price {
        font-size: 0.95rem;
      }

      .addtobag {
        padding: 8px;
        font-size: 0.72rem;
      }

      .wishlist-action {
        right: 7px;
        bottom: 7px;
        min-width: 36px;
        min-height: 36px;
        padding: 8px;
      }

      .wishlist-text {
        font-size: 0.65rem;
      }

      .category-image-wrapper {
        height: 145px;
      }

      .offer-image-wrapper {
        height: 190px;
      }

      .offer-content {
        padding: 16px;
      }
    }

    .carousel-banner-link {
      position: relative;
      display: block;
      width: 100%;
      height: 100%;
      color: #fff;
    }

    .carousel-banner-link .carousel-image {
      position: absolute;
      inset: 0;
    }

    .carousel-title-overlay {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: flex;
      align-items: center;
      padding: clamp(20px, 6vw, 85px);
      background: linear-gradient(90deg,
          rgba(0, 0, 0, 0.75) 0%,
          rgba(0, 0, 0, 0.42) 45%,
          rgba(0, 0, 0, 0.03) 100%);
      pointer-events: none;
    }

    .carousel-title-content {
      max-width: 650px;
      color: #fff;
    }

    .carousel-subtitle {
      display: block;
      margin-bottom: 14px;
      color: #ff9a7f;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 3px;
    }

    .carousel-title-content h2 {
      margin: 0 0 16px;
      font-size: clamp(1.8rem, 4.5vw, 4rem);
      font-weight: 800;
      line-height: 1.12;
      text-transform: capitalize;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.25);
    }

    .carousel-title-content p {
      max-width: 520px;
      margin: 0;
      font-size: clamp(0.85rem, 1.5vw, 1.1rem);
      line-height: 1.7;
    }

    .carousel-shop-label {
      display: inline-block;
      margin-top: 24px;
      padding: 12px 18px;
      border-radius: 7px;
      background: #f4512c;
      color: #fff;
      font-size: 0.9rem;
      font-weight: 700;
      pointer-events: auto;
    }

    .carousel-shop-label i {
      margin-left: 8px;
    }

    @media (max-width: 575px) {
      .carousel-title-overlay {
        padding: 20px;
        background: linear-gradient(90deg,
            rgba(0, 0, 0, 0.72),
            rgba(0, 0, 0, 0.18));
      }

      .carousel-subtitle {
        margin-bottom: 8px;
        font-size: 0.62rem;
        letter-spacing: 2px;
      }

      .carousel-title-content h2 {
        margin-bottom: 8px;
        font-size: 1.5rem;
      }

      .carousel-title-content p {
        font-size: 0.78rem;
        line-height: 1.45;
      }

      .carousel-shop-label {
        margin-top: 14px;
        padding: 9px 12px;
        font-size: 0.78rem;
      }
    }

    @media (hover: none) {
      .wishlist-action {
        opacity: 1;
        visibility: visible;
        transform: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>

<body>

  <%- include('../partials/userHeader') %>

    <div class="home-container">




      <% if (message && message.message) { %>
        <div id="flash-message" hidden>
          <%= message.message %>
        </div>

        <script>
          document.addEventListener('DOMContentLoaded', function () {
            const messageElement = document.getElementById('flash-message');

            if (messageElement) {
              Swal.fire({
                toast: true,
                position: 'top-end',
                title: messageElement.textContent.trim(),
                showConfirmButton: false,
                timer: 2500,
                timerProgressBar: true,
                background: '#218838',
                color: '#fff',
                customClass: {
                  popup: 'colored-toast'
                }
              });
            }
          });
        </script>
        <% } %>


          <section class="hero-section">
            <% if (carousels && carousels.length> 0) { %>

              <div id="carouselExample" class="carousel slide hero-carousel" data-bs-ride="carousel"
                data-bs-interval="4000">

                <div class="carousel-indicators">
                  <% carousels.forEach((carousel, index)=> { %>
                    <button type="button" data-bs-target="#carouselExample" data-bs-slide-to="<%= index %>"
                      class="<%= index === 0 ? 'active' : '' %>" <%=index===0 ? 'aria-current="true"' : '' %>
                      aria-label="Slide <%= index + 1 %>">
                    </button>
                    <% }) %>
                </div>

                <div class="carousel-inner">
                  <div class="carousel-inner">
                    <% carousels.forEach((carousel, index)=> { %>

                      <div class="carousel-item <%= index === 0 ? 'active' : '' %>">

                        <% if (carousel.link) { %>
                          <a href="<%= carousel.link %>" class="carousel-banner-link"
                            aria-label="<%= carousel.title %>">
                            <% } %>

                              <img src="<%= carousel.image %>" class="carousel-image" alt="<%= carousel.title %>"
                                <%=index===0 ? 'fetchpriority="high"' : 'loading="lazy"' %>
                              >

                              <div class="carousel-title-overlay">
                                <div class="carousel-title-content">
                                  <span class="carousel-subtitle">SHOE RACK COLLECTION</span>
                                  <h2>
                                    <%= carousel.title %>
                                  </h2>

                                  <% if (carousel.description) { %>
                                    <p>
                                      <%= carousel.description %>
                                    </p>
                                    <% } %>

                                      <% if (carousel.link) { %>
                                        <span class="carousel-shop-label">
                                          Explore Collection <i class="fa-solid fa-arrow-right"></i>
                                        </span>
                                        <% } %>
                                </div>
                              </div>

                              <% if (carousel.link) { %>
                          </a>
                          <% } %>

                      </div>

                      <% }) %>
                  </div>
                </div>

                <% if (carousels.length> 1) { %>
                  <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample"
                    data-bs-slide="prev" aria-label="Previous banner">

                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                  </button>

                  <button class="carousel-control-next" type="button" data-bs-target="#carouselExample"
                    data-bs-slide="next" aria-label="Next banner">

                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                  </button>
                  <% } %>

              </div>

              <% } else { %>

                <div class="hero-carousel d-flex align-items-center justify-content-center p-5">
                  <div class="text-center">
                    <h2>Welcome to Shoe Rack</h2>
                    <p class="text-muted mb-0">Find your perfect pair.</p>
                  </div>
                </div>

                <% } %>
          </section>


          <section class="home-section">

            <div class="section-heading">
              <span class="section-eyebrow">Find your style</span>
              <h2 class="custom-heading">Shop By Category</h2>
              <p class="section-description">
                From everyday comfort to special occasions, find the shoes that fit your lifestyle.
              </p>
            </div>

            <div class="row category-grid">

              <% if (category && category.length> 0) { %>

                <% category.forEach(element=> { %>

                  <div class="col-6 col-md-3">

                    <!-- Change /products to your category-filter route if you have one. -->
                    <a href="/products" class="category-card">

                      <div class="category-image-wrapper">

                        <img src="<%= element.image %>" alt="<%= element.categoryname %>" class="category-image"
                          loading="lazy">

                      </div>

                      <h3 class="category-name">
                        <%= element.categoryname %>
                      </h3>

                      <span class="category-link-label">
                        Explore collection
                        <i class="fa-solid fa-arrow-right ms-1"></i>
                      </span>

                    </a>

                  </div>

                  <% }) %>

                    <% } else { %>

                      <div class="col-12">
                        <div class="empty-state">
                          <p>Categories will be available soon.</p>
                        </div>
                      </div>

                      <% } %>

            </div>

          </section>

          <% if (offers && offers.length> 0) { %>
            <section class="home-section">

              <div class="section-heading">
                <span class="section-eyebrow">More style, better prices</span>
                <h2 class="custom-heading">Available Offers</h2>
                <p class="section-description">
                  Discover current deals and save on your next favourite pair.
                </p>
              </div>

              <div class="row offer-grid">


                <% offers.forEach(offer=> { %>

                  <div class="col-12 col-md-6 col-lg-4">

                    <article class="offer-card">

                      <div class="offer-image-wrapper">

                        <img src="<%= offer.offer.bannerImage %>" class="offer-image"
                          alt="<%= offer.offer.offerDescription %>" loading="lazy">

                      </div>

                      <div class="offer-content">

                        <span class="offer-tag">
                          <i class="fa-solid fa-tag me-1"></i>
                          Limited offer
                        </span>

                        <h3 class="offer-title">
                          <%= offer.offer.offerDescription %>
                        </h3>

                        <p class="offer-description">
                          Discount:
                          <strong class="offer-code">
                            <% if (offer.offer.discountType==='percentage' ) { %>
                              <%= offer.offer.discountValue %>% off
                                <% } else if (offer.offer.discountType==='fixed' ) { %>
                                  ₹<%= offer.offer.discountValue %> off
                                    <% } %>
                          </strong>
                        </p>

                        <a href="/products" class="redeem-btn">
                          Shop this offer
                          <i class="fa-solid fa-arrow-right ms-2"></i>
                        </a>

                      </div>

                    </article>

                  </div>

                  <% }) %>
              </div>

            </section>
            <% } %>

              <% if (upcomingOffers && upcomingOffers.length> 0) { %>

                <section class="home-section">

                  <div class="section-heading">
                    <span class="section-eyebrow">Coming soon</span>
                    <h2 class="custom-heading">Upcoming Offers</h2>
                    <p class="section-description">
                      Keep an eye on these deals and get ready to shop.
                    </p>
                  </div>

                  <div class="row offer-grid">

                    <% upcomingOffers.forEach(offer=> { %>

                      <div class="col-12 col-md-6 col-lg-4">

                        <article class="offer-card">

                          <div class="offer-image-wrapper">
                            <img src="<%= offer.offer.bannerImage %>" class="offer-image"
                              alt="<%= offer.offer.offerDescription %>" loading="lazy">

                          </div>

                          <div class="offer-content">

                            <span class="offer-tag">
                              <i class="fa-regular fa-clock me-1"></i>
                              Coming soon
                            </span>

                            <h3 class="offer-title">
                              <%= offer.offer.offerDescription %>
                            </h3>

                            <p class="offer-description">
                              Discount:
                              <strong class="offer-code">
                                <% if (offer.offer.discountType==='percentage' ) { %>
                                  <%= offer.offer.discountValue %>% off
                                    <% } else if (offer.offer.discountType==='fixed' ) { %>
                                      ₹<%= offer.offer.discountValue %> off
                                        <% } %>
                              </strong>
                            </p>

                            <div class="countdown" data-start-date="<%= offer.offer.startDate.toISOString() %>">
                              Calculating offer start time...
                            </div>

                          </div>

                        </article>

                      </div>

                      <% }) %>

                  </div>

                </section>

                <% } %>

    </div>

    <%- include('../partials/userfooter') %>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
      <script>
        function startCountdown() {
          document.querySelectorAll('.countdown').forEach(element => {
            const startDate = new Date(
              element.getAttribute('data-start-date')
            ).getTime();

            if (Number.isNaN(startDate)) {
              element.textContent = 'Start date unavailable';
              return;
            }

            function updateCountdown() {
              const distance = startDate - Date.now();

              if (distance <= 0) {
                element.textContent = 'Offer has started!';
                clearInterval(interval);
                return;
              }

              const days = Math.floor(distance / (1000 * 60 * 60 * 24));
              const hours = Math.floor(
                (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)
              );
              const minutes = Math.floor(
                (distance % (1000 * 60 * 60)) / (1000 * 60)
              );
              const seconds = Math.floor(
                (distance % (1000 * 60)) / 1000
              );

              element.textContent =
                `Starts in: ${days}d ${hours}h ${minutes}m ${seconds}s`;
            }

            updateCountdown();

            const interval = setInterval(updateCountdown, 1000);
          });
        }

        document.addEventListener('DOMContentLoaded', startCountdown);

        function showToast(message, type = 'success') {
          Swal.fire({
            toast: true,
            position: 'top-end',
            icon: type,
            text: message,
            showConfirmButton: false,
            timer: 2500,
            timerProgressBar: true,
            background: type === 'success' ? '#218838' : '#dc3545',
            color: '#fff',
            customClass: {
              popup: 'colored-toast'
            }
          });
        }




        function addtowishlist(productId, element) {
          const $button = $(element);

          if ($button.data('loading')) {
            return;
          }

          $button.data('loading', true);

          $.ajax({
            url: '/add-to-wishlist',
            type: 'POST',
            data: { productId: productId },

            success: function (response) {
              const $icon = $button.find('.fa-heart');
              const $text = $button.find('.wishlist-text');

              const isWishlisted = response.isWishlisted;

              if (typeof isWishlisted !== 'boolean') {
                showToast('Unexpected server response', 'error');
                return;
              }


              $button.toggleClass('wishlisted', isWishlisted);

              $button.attr(
                'aria-label',
                isWishlisted ? 'Remove from wishlist' : 'Add to wishlist'
              );

              $icon
                .toggleClass('fa-solid', isWishlisted)
                .toggleClass('fa-regular', !isWishlisted);

              $text.text(isWishlisted ? 'WISHLISTED' : 'WISHLIST');

              showToast(
                response.message ||
                (isWishlisted
                  ? 'Added to your wishlist'
                  : 'Removed from your wishlist'),
                'success'
              );
            },

            error: function (xhr) {
              const response = xhr.responseJSON || {};

              if (xhr.status === 401) {
                window.location.href = '/login';
                return;
              }

              showToast(
                response.message || 'Unable to update wishlist',
                'error'
              );
            },

            complete: function () {
              $button.data('loading', false);
            }
          });
        }



        function addtobag(productId, element) {
          const $button = $(element);

          if ($button.data('loading')) {
            return;
          }

          $button.data('loading', true);

          $.ajax({
            url: '/add-to-cart',
            type: 'POST',
            data: {
              productId: productId
            },

            success: function (response) {
              $button.addClass('added');
              $button.html(`
            <i class="bi bi-bag-check"></i>
            <span>Added</span>
          `);

              showToast(
                response.message || 'Product added to your bag',
                'success'
              );
            },

            error: function (xhr) {
              const response = xhr.responseJSON || {};
              const errorMessage = response.message || 'Unable to add product to bag';

              if (xhr.status === 401) {
                window.location.href = '/login';
                return;
              }

              showToast(errorMessage, 'error');
            },

            complete: function () {
              $button.data('loading', false);
            }
          });
        }
      </script>

</body>

</html>