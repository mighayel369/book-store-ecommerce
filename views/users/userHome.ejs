<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <title>Carousel Example</title>
  <style>
    .carousel-item img {
      width: 100%;
      height: 400px;
      object-fit:cover
    }
    #category_image{
      width: 30px;
      height: 150px;
      border-radius:10%
    }


    .card {
      border: 1px solid #ddd;
      border-radius: 8px;
      overflow: hidden;
      transition: box-shadow 0.3s ease;
      height: 350px;
    }

    .card:hover {
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .card img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      position: relative;
    }

    .wishlist {
  position: absolute;
  top: 90%;
  left: 50%;
  transform: translateX(-50%);
  border: 1px solid black;
  width: 200px;
  padding: 5px 10px;
  height: 30px;
  font-weight: bold;
  background-color: white;
  color:black;
  border-radius: 5px;
  display: none;
  justify-content: center;
  align-items: center;
  z-index: 1;
  cursor: pointer;
}

.img-wrapper {
  position: relative;
  padding: 30px;
}

.img-wrapper:hover .wishlist {
  display: flex;
}


    .allfeatures {
      display: flex;
      justify-content: space-between;
    }

    .addtobag {
      color: grey;
      font-size: 0.9rem;
      font-weight: bold;
      cursor: pointer;
    }

    .price {
      font-weight: bold;
      color: #333;
    }
    .colored-toast {
  background: #9b7878!important; 
  color: white!important; 
}

.toast-text {
  color: #ffffff!important;
}
.wishlisted{
  position: absolute;
  top: 90%;
  left: 50%;
  transform: translateX(-50%);
  border: 1px solid black;
  width: 200px;
  padding: 5px 10px;
  height: 30px;
  font-weight: bold;
  background-color: #dc3545;
  color:#fff;
  border-radius: 5px;
  display: none;
  justify-content: center;
  align-items: center;
  z-index: 1;
  cursor: pointer;
}
.img-wrapper:hover .wishlisted {
  display: flex;
}
#divContainer{
  margin-left: 100px;
  min-height: 600px;
}
.offerImage img {
      width: 210px;
      height: 210px;
      object-fit: cover;
      border-radius: 8px;
      
    }
  </style>
</head>
<body>
<%- include('../partials/userHeader') %>
<div class="container mt-5">
    <div class="row">
        <div id="carouselExample" class="carousel slide">
  <div class="carousel-inner">
    <div class="carousel-item active">
      <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRQbAjVgy6_rnDEFAsafE6_PjmwtUZhuHdwLw&s" class="d-block w-100">
    </div>
    <div class="carousel-item">
      <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQlKj1szO72RFKH6YbTH7a24EHYhriSfxQ2LQ&s" class="d-block w-100" alt="...">
    </div>
    <div class="carousel-item">
      <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQOuFaBd48CkjEdb5bsJBaoJCQCjiI08yICbg&s" class="d-block w-100">
    </div>
  </div>
  <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>
</div>
    </div>
    <div class="row mt-5">
        <span class="fw-bold fs-2">Top Selling Books</span>
        <% products.forEach(product => { %>
          <div class="col-md-4 mt-5 vis-products" data-categories="<%= product.productcategory.categoryname %>" data-price="<%= product.discountPrice?product.discountPrice:product.productprice %>" data-name="<%= product.productname %>" data-popularity="<%= product.popularityScore %>" data-created="<%= product.createdAt.toISOString().split('T')[0] %>">
            <div class="card" style="width: 18rem;">
              <% if (users) { %>
                <% let isInWishlist = users.wishlist.some(id => id.equals(product._id)); %>
                <div class="img-wrapper">
                  <a href="/singlepage/<%= product._id %>">
                    <img src="/product_images/<%= product.image[0] %>" class="card-img-top" alt="<%= product.productname %>">
                  </a>
                  <div class="<%= isInWishlist ? 'wishlisted' : 'wishlist' %>" onclick="addtowishlist('<%= product._id %>', this)">
                    <i class="<%= isInWishlist ? 'fa-solid' : 'fa-regular' %> fa-heart mx-1"></i>
                    <span class="wishlist-text"><%= isInWishlist ? 'WISHLISTED' : 'WISHLIST' %></span>
                  </div>
                </div>
              <% } else { %>
                <div class="img-wrapper">
                  <a href="/singlepage/<%= product._id %>">
                    <img src="/product_images/<%= product.image[0] %>" class="card-img-top" alt="<%= product.productname %>">
                  </a>
                  <div class="wishlist" onclick="addtowishlist('<%= product._id %>', this)">
                    <i class="fa-regular fa-heart mx-1"></i>
                    <span class="wishlist-text">WISHLIST</span>
                  </div>
                </div>
              <% } %>   
              <div class="card-body">
                <h5 class="card-title"><%= product.productname %></h5>
                <div class="allfeatures">
                    <% let offerSource = product.discountSource %>
                    <% if (offerSource === 'category' && product.productcategory.offer.isOfferActive) { %>
                      <p class="price">Rs. <%= product.discountPrice %>
                        <span class="fw-light" style="font-size: .7rem;color: orange;">
                          <span class="text-dark mx-1" style="text-decoration: line-through;">Rs. <%= product.productprice %></span> 
                          <% if (product.productcategory.offer.discountType === 'percentage') { %>
                            (<%= product.productcategory.offer.discountValue %>% off)
                          <% } else if (product.productcategory.offer.discountType === 'fixed') { %>
                            (Rs. <%= product.productcategory.offer.discountValue %>)
                          <% } %>
                        </span>
                      </p>
                      <%} else if(offerSource==='product'&&product.offer.isOfferActive){ %>
                        <p class="price">Rs. <%= product.discountPrice %>
                          <span class="fw-light" style="font-size: .7rem;color: orange;">
                            <span class="text-dark mx-1" style="text-decoration: line-through;">Rs. <%= product.productprice %></span> 
                            <% if (product.productcategory.offer.discountType === 'percentage') { %>
                              (<%= product.productcategory.offer.discountValue %>% off)
                            <% } else if (product.productcategory.offer.discountType === 'fixed') { %>
                              (Rs. <%= product.productcategory.offer.discountValue %>)
                            <% } %>
                          </span>
                        </p>
                    <% } else { %>
                      <p class="price">Rs. <%= product.productprice %></p>
                    <% } %>
                      <% if (product.stockqty>0) { %>
                        <span class="addtobag" onclick="addtobag('<%= product._id %>')">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-bag-plus mx-1" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M8 7.5a.5.5 0 0 1 .5.5v1.5H10a.5.5 0 0 1 0 1H8.5V12a.5.5 0 0 1-1 0v-1.5H6a.5.5 0 0 1 0-1h1.5V8a.5.5 0 0 1 .5-.5"/>
                            <path d="M8 1a2.5 2.5 0 0 1 2.5 2.5V4h-5v-.5A2.5 2.5 0 0 1 8 1m3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4zM2 5h12v9a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z"/>
                          </svg>
                          Add to bag
                        </span>
                      <% }else{ %>
                        <p class="text-danger fw-bold">out of stock</p>
                        <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
    </div>
    <div class="row mt-5">
      <span class="fw-bold fs-2">Shop By Category</span>
      <% category.forEach(element => { %>
        <div class="col-md-3 mt-5">
          <img id="category_image" src="/category_images/<%= element.image %>" alt="" class="w-100">
          <p class="fw-bold text-center mt-1"><%= element.categoryname %></p>
        </div>
      <% }) %>
    </div>
</div>


<%- include('../partials/userfooter') %>
<script>
   function addtowishlist(productId,element){
  $.ajax({
    url:'/add-to-wishlist',
    type:"POST",
    data:{
      productId:productId
    },
    success:function(response){
      const icon = $(element).find('.fa-heart');
      const text = $(element).find('.wishlist-text');
      $(element).css({
                'background': '#dc3545',
                 'color': '#fff'
                    });
      icon.removeClass('fa-regular').addClass('fa-solid');
      text.text('WISHLISTED');
      Swal.fire({
                toast: true,
                position: 'top-end',
                text: response.message,
                showConfirmButton: false,
                timer: 2000,
                timerProgressBar: false,
                background: '#28a745',
                customClass: {
                    popup: 'colored-toast',
                    text: 'toast-text'
                }
            });
    },
    error: function(xhr) {
            const errMsg = xhr.responseJSON.message;
            console.log(errMsg);

            if (xhr.status === 401) {
                window.location.href = '/login';
            } else if(xhr.status===400){
                const icon = $(element).find('.fa-heart');
                const text = $(element).find('.wishlist-text');
               $(element).css({
                'background': 'white',
                 'color': 'black'
                    });
                  icon.removeClass('fa-solid').addClass('fa-regular');
               text.text('WISHLIST');
              Swal.fire({
                  toast: true,
                  position: 'top-end',
                  icon: 'error',
                  text: errMsg,
                  showConfirmButton: false,
                  timer: 2000,
                  timerProgressBar: false,
                  background: '#dc3545',
                  customClass: {
                      popup: 'colored-toast',
                      text: 'toast-text'
                  }
              });
          }else {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    text: errMsg,
                    showConfirmButton: false,
                    timer: 2000,
                    timerProgressBar: false,
                    background: '#dc3545',
                    customClass: {
                        popup: 'colored-toast',
                        text: 'toast-text'
                    }
                });
            }
        }
  })
}

function addtobag(productId) {
  let userId = $('.vis-products').data('userid');
    $.ajax({
        url: '/add-to-cart',
        type: 'POST',
        data: {
            productId: productId
        },
        success: function(response) {
            $('span[onclick="addtobag(\'' + productId + '\')"]').html(`
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-bag-check mx-1" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M10.854 8.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 0 1 .708-.708L7.5 10.793l2.646-2.647a.5.5 0 0 1 .708 0"/>
                    <path d="M8 1a2.5 2.5 0 0 1 2.5 2.5V4h-5v-.5A2.5 2.5 0 0 1 8 1m3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4zM2 5h12v9a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z"/>
                </svg>
                Added
            `);

            Swal.fire({
                toast: true,
                position: 'top-end',
                text: response.message,
                showConfirmButton: false,
                timer: 2000,
                timerProgressBar: false,
                background: '#28a745',
                customClass: {
                    popup: 'colored-toast',
                    text: 'toast-text'
                }
            });
        },
        error: function(xhr) {
            const errMsg = xhr.responseJSON.message;
            console.log(errMsg);

            if (xhr.status === 401) {
                window.location.href = '/login';
            }
            else{
              Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    text: errMsg,
                    showConfirmButton: false,
                    timer: 2000,
                    timerProgressBar: false,
                    background: '#dc3545',
                    customClass: {
                        popup: 'colored-toast',
                        text: 'toast-text'
                    }
                });
            }
        }
    });
}
</script>