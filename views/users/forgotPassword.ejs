<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#faf9f7">

    <title>Update Password | Shoe Rack</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
    >

    <style>
        :root {
            --accent: #f4512c;
            --accent-hover: #df3f1c;
            --dark: #202020;
            --muted: #777;
            --border: #e7e7e7;
            --background: #faf9f7;
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--background);
            color: var(--dark);
            font-family: Arial, Helvetica, sans-serif;
        }

        .password-page {
            width: 100%;
            min-height: 85vh;
            padding: 40px 20px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .password-card {
            width: 100%;
            max-width: 1000px;
            min-height: 540px;
            display: grid;
            grid-template-columns: 0.9fr 1.1fr;
            background: #fff;
            border: 1px solid rgba(0, 0, 0, 0.035);
            border-radius: 22px;
            overflow: hidden;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.08);
        }


        .password-promo {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 42px 34px;
            overflow: hidden;
            background:
                radial-gradient(
                    circle at 90% 15%,
                    rgba(244, 81, 44, 0.10),
                    transparent 35%
                ),
                linear-gradient(145deg, #ffffff, #fff5f1);
            color: var(--dark);
        }

        .password-promo-content,
        .password-promo-bottom {
            position: relative;
            z-index: 1;
        }

        .password-brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--dark);
            font-size: 23px;
            font-weight: 800;
            text-decoration: none;
        }

        .password-brand:hover {
            color: var(--dark);
        }

        .password-brand-icon {
            width: 42px;
            height: 42px;
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--accent);
            color: #fff;
            border-radius: 12px;
        }

        .password-promo h1 {
            margin-top: 70px;
            margin-bottom: 20px;
            font-size: clamp(32px, 3.5vw, 42px);
            line-height: 1.2;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .password-promo h1 span {
            display: block;
            color: var(--accent);
        }

        .password-promo-description {
            margin-bottom: 0;
            color: #666;
            font-size: 15px;
            line-height: 1.8;
        }

        .password-security {
            display: flex;
            align-items: flex-start;
            gap: 13px;
            margin-top: 35px;
            padding: 17px;
            border: 1px solid rgba(244, 81, 44, 0.12);
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.75);
        }

        .password-security-icon {
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: #fff0e9;
            color: var(--accent);
        }

        .password-security strong {
            display: block;
            margin-bottom: 5px;
            font-size: 13px;
        }

        .password-security p {
            margin: 0;
            color: #777;
            font-size: 12px;
            line-height: 1.6;
        }

        .password-promo-bottom {
            margin-top: 35px;
            color: #777;
            font-size: 12px;
            line-height: 1.6;
        }


        .password-form-panel {
            min-width: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 45px 48px;
        }

        .password-form-content {
            width: 100%;
            max-width: 390px;
        }

        .password-step-icon {
            width: 52px;
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 24px;
            border-radius: 15px;
            background: #fff0e9;
            color: var(--accent);
            font-size: 21px;
        }

        .password-heading {
            margin: 0 0 10px;
            font-size: 30px;
            font-weight: 800;
            letter-spacing: -0.7px;
        }

        .password-subheading {
            margin-bottom: 28px;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.7;
        }

        .password-form .form-label {
            display: block;
            margin-bottom: 7px;
            color: #333;
            font-size: 13px;
            font-weight: 600;
        }

        .password-input-wrapper {
            position: relative;
        }

        .password-form .form-control {
            width: 100%;
            min-height: 47px;
            padding: 11px 45px 11px 13px;
            border: 1px solid #e1e1e1;
            border-radius: 9px;
            background-color: #fff;
            color: var(--dark);
            font-size: 14px;
            box-shadow: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .password-form .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(244, 81, 44, 0.10);
        }

        .password-form .form-control::placeholder {
            color: #aaa;
        }

        .password-toggle {
            position: absolute;
            top: 50%;
            right: 13px;
            transform: translateY(-50%);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 32px;
            padding: 4px;
            border: 0;
            background: transparent;
            color: #888;
            cursor: pointer;
        }

        .password-toggle:hover,
        .password-toggle:focus-visible {
            color: var(--accent);
        }

        .password-toggle:focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
            border-radius: 5px;
        }

        .password-requirement {
            margin-top: 7px;
            color: #888;
            font-size: 11px;
            line-height: 1.5;
        }

        .password-error {
            margin-bottom: 17px;
            padding: 12px 14px;
            border: 1px solid #f3caca;
            border-radius: 8px;
            background: #fff1f1;
            color: #b42318;
            font-size: 13px;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .password-submit {
            width: 100%;
            min-height: 47px;
            margin-top: 8px;
            padding: 12px 16px;
            border: 0;
            border-radius: 9px;
            background: var(--accent);
            color: #fff;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.2s, transform 0.2s;
        }

        .password-submit:hover {
            background: var(--accent-hover);
            transform: translateY(-1px);
        }

        .password-submit:focus-visible {
            outline: 3px solid rgba(244, 81, 44, 0.25);
            outline-offset: 3px;
        }

        .password-back-link {
            display: block;
            margin-top: 22px;
            color: #777;
            font-size: 13px;
            text-align: center;
            text-decoration: none;
        }

        .password-back-link i {
            margin-right: 6px;
        }

        .password-back-link:hover {
            color: var(--accent);
        }


        @media (max-width: 850px) {
            .password-page {
                min-height: auto;
                padding: 35px 20px;
            }

            .password-card {
                max-width: 550px;
                min-height: auto;
                grid-template-columns: 1fr;
            }

            .password-promo {
                min-height: auto;
                padding: 30px;
            }

            .password-promo h1 {
                margin-top: 35px;
                font-size: 32px;
            }

            .password-security {
                margin-top: 22px;
            }

            .password-promo-bottom {
                margin-top: 25px;
            }

            .password-form-panel {
                padding: 38px 35px 42px;
            }
        }


        @media (max-width: 480px) {
            .password-page {
                padding: 22px 12px;
            }

            .password-card {
                border-radius: 15px;
            }

            .password-promo {
                padding: 24px;
            }

            .password-brand {
                font-size: 21px;
            }

            .password-brand-icon {
                width: 38px;
                height: 38px;
            }

            .password-promo h1 {
                margin-top: 27px;
                margin-bottom: 12px;
                font-size: 29px;
            }

            .password-promo-description {
                font-size: 13px;
                line-height: 1.7;
            }

            .password-security {
                gap: 10px;
                padding: 12px;
            }

            .password-form-panel {
                padding: 30px 22px;
            }

            .password-step-icon {
                width: 46px;
                height: 46px;
                margin-bottom: 20px;
                font-size: 19px;
            }

            .password-heading {
                font-size: 27px;
            }

            .password-subheading {
                margin-bottom: 24px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .password-submit,
            .password-form .form-control {
                transition: none;
            }

            .password-submit:hover {
                transform: none;
            }
        }
    </style>
</head>

<body>

    <%- include('../partials/userHeader') %>

    <main class="password-page">
        <div class="password-card">

            <section class="password-promo">
                <div class="password-promo-content">

                    <a href="/" class="password-brand">
                        <span class="password-brand-icon">
                            <i class="fa-solid fa-shoe-prints" aria-hidden="true"></i>
                        </span>
                        <span>Shoe Rack</span>
                    </a>

                    <h1>
                        A fresh start
                        <span>begins here.</span>
                    </h1>

                    <p class="password-promo-description">
                        Create a new password to get back to your account
                        and continue discovering your favorite footwear.
                    </p>

                    <div class="password-security">
                        <div class="password-security-icon">
                            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                        </div>

                        <div>
                            <strong>Your account, protected</strong>
                            <p>
                                Choose a strong, unique password to help
                                keep your account secure.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="password-promo-bottom">
                    Your next favorite pair is waiting.
                </div>
            </section>

            <section class="password-form-panel">
                <div class="password-form-content">

                    <div class="password-step-icon">
                        <i class="fa-solid fa-lock" aria-hidden="true"></i>
                    </div>

                    <h2 class="password-heading">Update password</h2>

                    <p class="password-subheading">
                        Enter your new password below and confirm it
                        to complete the update.
                    </p>

                    <form
                        action="/forgotpassword"
                        method="post"
                        class="password-form"
                        id="passwordForm"
                    >

                        <div class="mb-4">
                            <label for="newpassword" class="form-label">
                                New password
                            </label>

                            <div class="password-input-wrapper">
                                <input
                                    type="password"
                                    class="form-control"
                                    id="newpassword"
                                    name="newpassword"
                                    placeholder="Enter your new password"
                                    autocomplete="new-password"
                                    required
                                >

                                <button
                                    type="button"
                                    class="password-toggle"
                                    data-target="newpassword"
                                    aria-label="Show new password"
                                    aria-pressed="false"
                                >
                                    <i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
                                </button>
                            </div>

                            <div class="password-requirement">
                                Use a strong password that you have not used elsewhere.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="confirmpassword" class="form-label">
                                Confirm new password
                            </label>

                            <div class="password-input-wrapper">
                                <input
                                    type="password"
                                    class="form-control"
                                    id="confirmpassword"
                                    name="confirmpassword"
                                    placeholder="Re-enter your new password"
                                    autocomplete="new-password"
                                    required
                                >

                                <button
                                    type="button"
                                    class="password-toggle"
                                    data-target="confirmpassword"
                                    aria-label="Show confirm password"
                                    aria-pressed="false"
                                >
                                    <i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>

                        <% if (typeof message !== 'undefined' && message) { %>
                            <div class="password-error" role="alert" id="change">
                                <%= message.message %>
                            </div>
                        <% } %>

                        <button type="submit" class="password-submit">
                            Update Password
                            <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true"></i>
                        </button>

                        <a href="/login" class="password-back-link">
                            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                            Back to login
                        </a>

                    </form>
                </div>
            </section>

        </div>
    </main>

    <%- include('../partials/userfooter') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('passwordForm');
            const newPassword = document.getElementById('newpassword');
            const confirmPassword = document.getElementById('confirmpassword');

            document.querySelectorAll('.password-toggle').forEach(function (button) {
                button.addEventListener('click', function () {
                    const input = document.getElementById(button.dataset.target);

                    if (!input) return;

                    const shouldShow = input.type === 'password';

                    input.type = shouldShow ? 'text' : 'password';

                    const icon = button.querySelector('i');

                    if (icon) {
                        icon.classList.toggle('fa-eye', shouldShow);
                        icon.classList.toggle('fa-eye-slash', !shouldShow);
                    }

                    const fieldName = button.dataset.target === 'newpassword'
                        ? 'new password'
                        : 'confirm password';

                    button.setAttribute(
                        'aria-label',
                        (shouldShow ? 'Hide ' : 'Show ') + fieldName
                    );

                    button.setAttribute('aria-pressed', String(shouldShow));
                });
            });

            function validatePasswordMatch() {
                if (confirmPassword.value !== newPassword.value) {
                    confirmPassword.setCustomValidity(
                        'The passwords do not match.'
                    );
                } else {
                    confirmPassword.setCustomValidity('');
                }
            }

            newPassword.addEventListener('input', validatePasswordMatch);
            confirmPassword.addEventListener('input', validatePasswordMatch);

            form.addEventListener('submit', function (event) {
                validatePasswordMatch();

                if (!form.checkValidity()) {
                    event.preventDefault();
                    form.reportValidity();
                }
            });
        });
    </script>

</body>
</html>