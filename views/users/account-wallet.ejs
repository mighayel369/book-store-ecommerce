<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Wallet</title>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
            color: #333;
        }

        .account-nav {
            border: 1px solid #ccc;
            border-radius: 10px;
            padding: 20px;
            width: 100%;
            font-weight: bold;
            background-color: #fff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .account-navitem {
            border-bottom: 1px solid #ccc;
            padding: 10px;
            cursor: pointer;
        }

        .account-navitem:last-child {
            border-bottom: none;
        }

        .nav-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: #555;
            text-decoration: none;
        }

        .nav-link i {
            margin-right: 10px;
        }

        .account {
            margin-left: 30px;
            margin-top: 70px;
        }

        .active {
            background-color: #df9f9f;
            border-radius: 5px;
        }

        .arrow {
            position: absolute;
            left: 255px;
        }

        .addressDiv {
            margin-top: 130px;
            background-color: #fff;
            border: 1px solid #ccc;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            min-height: 400px;
        }

        .header-section {
            background-color: #b46363;
            color: white;
            height: 50px;
            text-align: center;
            padding-top: 10px;
            border-bottom: 1px solid #ccc;
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
        }

        .walletDiv {
            width: 100%;
            padding: 20px;
            text-align: center;
        }

        .wallet-balance {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .transactions-table {
            margin-top: 20px;
            min-height: 150px;
        }

        .table th, .table td {
            vertical-align: middle;
        }

    </style>
</head>
<body>
    <%- include('../partials/userHeader') %>
    <p class="fw-bold text-dark fs-5 mt-4 ms-3">Home > <span>Account ></span><span class="text-warning fs-5"> Wallet</span></p>

    <div class="container-fluid">
        <% if (message) { %>
            <div class="alert m-4 alert-dismissible fade show alert-<%= message.type %>" role="alert">
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                <strong><%= message.message %></strong>
            </div>
        <% } %>
        <div class="row">
            <div class="col-md-3">
                <%- include('../partials/account-nav') %>
            </div>
            <div class="col-md-9">
                <div class="addressDiv">
                    <div class="header-section">
                        <h5 class="fw-bold">Wallet</h5>
                    </div>
                    <div class="walletDiv">
                        <div class="wallet-balance">
                            Wallet Balance: ₹<%= users.wallet.balance %>
                        </div>
                        <h5 class="mt-4 fw-bold" style="text-align: left;">Transaction History</h5>
                        <div class="transactions-table">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Description</th>
                                        <th>Type</th>
                                        <th>Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (transactionData.length>0) { %>
                                     <% transactionData.forEach(transaction => { %>
                                        <tr>
                                            <td><%= new Date(transaction.date).toLocaleDateString() %></td>
                                            <td><%= transaction.description %></td>
                                            <td><%= transaction.transactionType %></td>
                                            <td><%= transaction.amount ? transaction.amount.toFixed(2) : '0.00' %></td>

                                        </tr>
                                        <% }) %>
                                    <% }else{ %>
                                        <tr>
                                            <td colspan="4" class="text-center mt-5 fw-bold text-danger">
                                                <i class="fa-solid fa-exclamation-circle me-2"></i> No Transactions Found!
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                        <% if (transactionData.length>0) { %>
                            <nav aria-label="Page navigation example">
                                <ul class="pagination d-flex justify-content-end">
                                  <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                    <a class="page-link" href="?page=<%= currentPage - 1 %>&limit=<%= limit %>&search=<%= search %>" aria-label="Previous">
                                      <span aria-hidden="true">&laquo;</span>
                                    </a>
                                  </li>
                                  <% for (let i = 1; i <= totalPages; i++) { %>
                                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                      <a class="page-link" href="?page=<%= i %>&limit=<%= limit %>&search=<%= search %>"><%= i %></a>
                                    </li>
                                  <% } %>
                                  <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="?page=<%= currentPage + 1 %>&limit=<%= limit %>&search=<%= search %>" aria-label="Next">
                                      <span aria-hidden="true">&raquo;</span>
                                    </a>
                                  </li>
                                </ul>
                              </nav>
                        <% } %>
                        <div class="text-end">
                            <a type="button" href="/wallet/clearhistory/<%= users._id %>" class="btn btn-danger fw-bold">Clear-History</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>   
    </div>

    <%- include('../partials/userfooter') %>
<script>
     $(document).ready(function(){

const navItems = $('.account-navitem a');
navItems.each(function() {
    if (window.location.pathname === $(this).attr('href')) {
        $(this).parent().addClass('active');
    }
});

navItems.on('click', function() {
    navItems.parent().removeClass('active'); 
    $(this).parent().addClass('active');
});
     })


</script>
</body>
</html>
