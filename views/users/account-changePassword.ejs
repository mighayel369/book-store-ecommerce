<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Change Password | Shoe Rack</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --password-primary: #f4512c;
            --password-primary-dark: #dc3f1d;
            --password-text: #262626;
            --password-muted: #777;
            --password-border: #ededed;
            --password-bg: #f7f8fa;
            --password-white: #fff;
            --password-radius: 16px;
            --password-shadow: 0 5px 24px rgba(0, 0, 0, 0.045);
        }

        .password-page {
            min-height: 70vh;
            padding: 22px 0 65px;
            color: var(--password-text);
            background: var(--password-bg);
        }

        .password-page * {
            box-sizing: border-box;
        }

        .password-page .password-breadcrumb {
            margin: 0 0 24px;
            color: var(--password-muted);
            font-size: 14px;
        }

        .password-page .password-breadcrumb a {
            color: var(--password-muted);
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .password-page .password-breadcrumb a:hover {
            color: var(--password-primary);
        }

        .password-page .breadcrumb-current {
            color: var(--password-primary);
            font-weight: 600;
        }

        .password-page .password-card {
            overflow: hidden;
            min-width: 0;
            background: var(--password-white);
            border: 1px solid var(--password-border);
            border-radius: var(--password-radius);
            box-shadow: var(--password-shadow);
        }

        .password-page .password-card-header {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 24px;
            border-bottom: 1px solid var(--password-border);
        }

        .password-page .password-header-icon {
            display: flex;
            flex: 0 0 48px;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            color: var(--password-primary);
            background: #fff0eb;
            border-radius: 13px;
            font-size: 20px;
        }

        .password-page .password-title {
            margin: 0;
            color: var(--password-text);
            font-size: 23px;
            font-weight: 750;
            letter-spacing: -0.5px;
        }

        .password-page .password-subtitle {
            margin: 7px 0 0;
            color: var(--password-muted);
            font-size: 13px;
            line-height: 1.6;
        }

        .password-page .password-content {
            max-width: 590px;
            padding: 30px 32px 34px;
        }

        .password-page .security-note {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 15px;
            margin-bottom: 27px;
            background: #fff8f4;
            border: 1px solid #ffe5da;
            border-radius: 12px;
        }

        .password-page .security-note-icon {
            margin-top: 2px;
            color: var(--password-primary);
            font-size: 17px;
        }

        .password-page .security-note-title {
            margin: 0 0 5px;
            color: #3d302c;
            font-size: 13px;
            font-weight: 700;
        }

        .password-page .security-note-text {
            margin: 0;
            color: #796c66;
            font-size: 12px;
            line-height: 1.6;
        }

        .password-page .password-field {
            margin-bottom: 22px;
        }

        .password-page .password-label {
            display: block;
            margin-bottom: 9px;
            color: #333;
            font-size: 13px;
            font-weight: 700;
        }

        .password-page .password-input-group {
            position: relative;
            display: flex;
            align-items: center;
        }

        .password-page .password-input {
            display: block;
            width: 100%;
            height: 48px;
            padding: 12px 54px 12px 14px;
            color: var(--password-text);
            background: #fff;
            border: 1px solid #e5e5e5;
            border-radius: 10px !important;
            outline: none;
            font-family: inherit;
            font-size: 13px;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .password-page .password-input::placeholder {
            color: #aaa;
        }

        .password-page .password-input:focus {
            border-color: var(--password-primary);
            box-shadow: 0 0 0 3px rgba(244, 81, 44, 0.1);
        }

        .password-page .password-input.is-invalid {
            border-color: #dc3545;
        }

        .password-page .password-input.is-valid {
            border-color: #198754;
        }

        .password-page .toggle-password {
            position: absolute;
            top: 50%;
            right: 13px;
            padding: 5px 0;
            color: #777;
            background: transparent;
            border: none;
            font-size: 12px;
            font-weight: 650;
            transform: translateY(-50%);
            cursor: pointer;
        }

        .password-page .toggle-password:hover {
            color: var(--password-primary);
        }

        .password-page .password-hint {
            margin: 8px 0 0;
            color: #888;
            font-size: 11px;
            line-height: 1.6;
        }

        .password-page .password-match-message {
            display: none;
            margin-top: 8px;
            font-size: 11px;
        }

        .password-page .password-match-message.match {
            display: block;
            color: #198754;
        }

        .password-page .password-match-message.no-match {
            display: block;
            color: #dc3545;
        }

        .password-page .password-strength {
            display: none;
            margin-top: 10px;
        }

        .password-page .strength-track {
            width: 100%;
            height: 4px;
            overflow: hidden;
            background: #eee;
            border-radius: 20px;
        }

        .password-page .strength-fill {
            width: 0;
            height: 100%;
            background: #dc3545;
            border-radius: 20px;
            transition: width 0.25s ease, background 0.25s ease;
        }

        .password-page .strength-label {
            display: block;
            margin-top: 6px;
            color: #888;
            font-size: 11px;
        }

        .password-page .password-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 30px;
        }

        .password-page .btn-update-password {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            min-height: 46px;
            padding: 12px 21px;
            color: #fff;
            background: var(--password-primary);
            border: 1px solid var(--password-primary);
            border-radius: 10px;
            font-size: 13px;
            font-weight: 750;
            transition: background 0.2s ease, transform 0.2s ease;
            cursor: pointer;
        }

        .password-page .btn-update-password:hover {
            color: #fff;
            background: var(--password-primary-dark);
            border-color: var(--password-primary-dark);
            transform: translateY(-1px);
        }

        .password-page .btn-update-password:disabled {
            opacity: 0.65;
            cursor: wait;
            transform: none;
        }

        .password-page .btn-reset-password {
            min-height: 46px;
            padding: 12px 17px;
            color: #666;
            background: #fff;
            border: 1px solid #e5e5e5;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 650;
            cursor: pointer;
            transition: background 0.2s ease;
        }

        .password-page .btn-reset-password:hover {
            background: #f7f7f7;
        }

        .password-page .form-feedback {
            padding: 12px 14px;
            margin-top: 18px;
            border-radius: 9px;
            font-size: 12px;
            line-height: 1.6;
        }

        .password-page .password-footer-note {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            padding-top: 22px;
            margin-top: 27px;
            color: #888;
            border-top: 1px solid #f0f0f0;
            font-size: 11px;
            line-height: 1.7;
        }

        .password-page .password-footer-note i {
            margin-top: 3px;
            color: var(--password-primary);
        }

        .password-page .colored-toast {
            color: #fff !important;
            border-radius: 12px !important;
        }

        @media (max-width: 991px) {
            .password-page .password-content {
                max-width: none;
                padding: 25px;
            }

            .password-page .password-card-header {
                padding: 20px;
            }
        }

        @media (max-width: 575px) {
            .password-page {
                padding-top: 16px;
            }

            .password-page .password-breadcrumb {
                margin-bottom: 17px;
                font-size: 12px;
            }

            .password-page .password-card-header {
                align-items: flex-start;
                padding: 18px 16px;
            }

            .password-page .password-header-icon {
                flex-basis: 42px;
                width: 42px;
                height: 42px;
            }

            .password-page .password-title {
                font-size: 20px;
            }

            .password-page .password-content {
                padding: 22px 16px;
            }

            .password-page .password-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .password-page .btn-update-password,
            .password-page .btn-reset-password {
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <%- include('../partials/userHeader') %>

        <main class="password-page">
            <div class="container">

                <nav class="password-breadcrumb" aria-label="Breadcrumb">
                    <a href="/">Home</a>
                    <span class="mx-2">/</span>
                    <a href="/profile">Account</a>
                    <span class="mx-2">/</span>
                    <span class="breadcrumb-current">Change Password</span>
                </nav>

                <% if (message && message.message) { %>
                    <div id="flash-message" hidden>
                        <%= message.message %>
                    </div>

                    <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            const messageElement = document.getElementById('flash-message');

                            if (messageElement) {
                                Swal.fire({
                                    toast: true,
                                    position: 'top-end',
                                    title: messageElement.textContent.trim(),
                                    showConfirmButton: false,
                                    timer: 2500,
                                    timerProgressBar: true,
                                    background: '#218838',
                                    color: '#fff',
                                    customClass: {
                                        popup: 'colored-toast'
                                    }
                                });
                            }
                        });
                    </script>
                    <% } %>


                        <div class="row g-4">

                            <aside class="col-lg-3 col-md-4">
                                <%- include('../partials/account-nav') %>
                            </aside>

                            <section class="col-lg-9 col-md-8">

                                <div class="password-card">

                                    <div class="password-card-header">
                                        <div class="password-header-icon">
                                            <i class="fa-solid fa-shield-halved"></i>
                                        </div>

                                        <div>
                                            <h1 class="password-title">Change Password</h1>
                                            <p class="password-subtitle">
                                                Update your password to help keep your account secure.
                                            </p>
                                        </div>
                                    </div>

                                    <div class="password-content">

                                        <div class="security-note">
                                            <i class="fa-solid fa-lock security-note-icon"></i>

                                            <div>
                                                <p class="security-note-title">Keep your account secure</p>
                                                <p class="security-note-text">
                                                    Use a strong password that you don't use on other websites.
                                                    Avoid sharing your password with anyone.
                                                </p>
                                            </div>
                                        </div>

                                        <form id="changePasswordForm" action="/change-password" method="POST">

                                            <div class="password-field">
                                                <label for="currentPassword" class="password-label">
                                                    Current Password
                                                </label>

                                                <div class="password-input-group">
                                                    <input type="password" class="password-input" id="currentPassword"
                                                        name="currentPassword" placeholder="Enter your current password"
                                                        autocomplete="current-password" required>

                                                    <button type="button" class="toggle-password"
                                                        data-target="currentPassword" aria-label="Show current password"
                                                        aria-pressed="false">
                                                        Show
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="password-field">
                                                <label for="newPassword" class="password-label">
                                                    New Password
                                                </label>

                                                <div class="password-input-group">
                                                    <input type="password" class="password-input" id="newPassword"
                                                        name="newPassword" placeholder="Create a new password"
                                                        autocomplete="new-password" required>

                                                    <button type="button" class="toggle-password"
                                                        data-target="newPassword" aria-label="Show new password"
                                                        aria-pressed="false">
                                                        Show
                                                    </button>
                                                </div>

                                                <p class="password-hint">
                                                    Choose a strong password with at least 8 characters.
                                                </p>

                                                <div class="password-strength" id="passwordStrength">
                                                    <div class="strength-track">
                                                        <div class="strength-fill" id="strengthFill"></div>
                                                    </div>
                                                    <span class="strength-label" id="strengthLabel"></span>
                                                </div>
                                            </div>

                                            <div class="password-field">
                                                <label for="confirmPassword" class="password-label">
                                                    Confirm New Password
                                                </label>

                                                <div class="password-input-group">
                                                    <input type="password" class="password-input" id="confirmPassword"
                                                        name="confirmPassword" placeholder="Re-enter your new password"
                                                        autocomplete="new-password" required>

                                                    <button type="button" class="toggle-password"
                                                        data-target="confirmPassword"
                                                        aria-label="Show password confirmation" aria-pressed="false">
                                                        Show
                                                    </button>
                                                </div>

                                                <div id="passwordMatchMessage" class="password-match-message"
                                                    aria-live="polite">
                                                </div>
                                            </div>

                                            <div id="formMessage" class="form-feedback d-none" role="status"
                                                aria-live="polite">
                                            </div>

                                            <div class="password-actions">
                                                <button class="btn-update-password" id="updatePasswordButton"
                                                    type="submit">
                                                    <i class="fa-solid fa-shield-halved"></i>
                                                    Update Password
                                                </button>

                                                <button class="btn-reset-password" type="reset">
                                                    Clear Fields
                                                </button>
                                            </div>

                                        </form>

                                        <div class="password-footer-note">
                                            <i class="fa-solid fa-circle-info"></i>
                                            <span>
                                                If you don't remember your current password, use the
                                                password recovery option instead of repeatedly trying
                                                different passwords.
                                            </span>
                                        </div>

                                    </div>
                                </div>

                            </section>
                        </div>
            </div>
        </main>

        <%- include('../partials/userfooter') %>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script>
                $(function () {

                    const $form = $('#changePasswordForm');
                    const $currentPassword = $('#currentPassword');
                    const $newPassword = $('#newPassword');
                    const $confirmPassword = $('#confirmPassword');
                    const $formMessage = $('#formMessage');
                    const $submitButton = $('#updatePasswordButton');

                    let requestInProgress = false;

                    function showFormMessage(message, type) {
                        $formMessage
                            .removeClass('d-none alert-danger alert-success alert-warning')
                            .addClass('alert-' + type)
                            .text(message);
                    }

                    function clearFormMessage() {
                        $formMessage
                            .addClass('d-none')
                            .removeClass('alert-danger alert-success alert-warning')
                            .text('');
                    }

                    function checkPasswordMatch() {
                        const newPassword = $newPassword.val();
                        const confirmPassword = $confirmPassword.val();
                        const $matchMessage = $('#passwordMatchMessage');

                        $confirmPassword.removeClass('is-valid is-invalid');
                        $matchMessage.removeClass('match no-match').text('');

                        if (!confirmPassword) {
                            return false;
                        }

                        if (newPassword === confirmPassword) {
                            $confirmPassword.addClass('is-valid');

                            $matchMessage
                                .addClass('match')
                                .text('Passwords match.');

                            return true;
                        }

                        $confirmPassword.addClass('is-invalid');

                        $matchMessage
                            .addClass('no-match')
                            .text('Passwords do not match.');

                        return false;
                    }

                    function updatePasswordStrength() {
                        const password = $newPassword.val();
                        const $strength = $('#passwordStrength');
                        const $fill = $('#strengthFill');
                        const $label = $('#strengthLabel');

                        if (!password) {
                            $strength.hide();
                            $fill.css({
                                width: '0%',
                                background: '#dc3545'
                            });
                            $label.text('');
                            return;
                        }

                        $strength.show();

                        let score = 0;

                        if (password.length >= 8) score++;
                        if (password.length >= 12) score++;
                        if (/[a-z]/.test(password) && /[A-Z]/.test(password)) score++;
                        if (/\d/.test(password)) score++;
                        if (/[^A-Za-z0-9]/.test(password)) score++;

                        let strength;

                        if (password.length < 8) {
                            strength = {
                                label: 'Too short',
                                width: '20%',
                                color: '#dc3545'
                            };
                        } else if (score <= 2) {
                            strength = {
                                label: 'Weak',
                                width: '35%',
                                color: '#dc3545'
                            };
                        } else if (score <= 3) {
                            strength = {
                                label: 'Moderate',
                                width: '65%',
                                color: '#e5a000'
                            };
                        } else {
                            strength = {
                                label: 'Strong',
                                width: '100%',
                                color: '#198754'
                            };
                        }

                        $fill.css({
                            width: strength.width,
                            background: strength.color
                        });

                        $label.text('Password strength: ' + strength.label);
                    }

                    $('.toggle-password').on('click', function () {
                        const $button = $(this);
                        const targetId = $button.data('target');
                        const input = document.getElementById(targetId);

                        if (!input) return;

                        const shouldShow = input.type === 'password';

                        input.type = shouldShow ? 'text' : 'password';

                        $button.text(shouldShow ? 'Hide' : 'Show');
                        $button.attr('aria-pressed', String(shouldShow));
                        $button.attr(
                            'aria-label',
                            (shouldShow ? 'Hide ' : 'Show ') +
                            targetId.replace(/([A-Z])/g, ' $1').toLowerCase()
                        );
                    });

                    $newPassword.on('input', function () {
                        updatePasswordStrength();

                        if ($confirmPassword.val()) {
                            checkPasswordMatch();
                        }
                    });

                    $confirmPassword.on('input', checkPasswordMatch);

                    $form.find('input').on('input', function () {
                        clearFormMessage();
                    });

                    $form.on('reset', function () {
                        setTimeout(function () {
                            clearFormMessage();

                            $form.find('input').removeClass('is-valid is-invalid');

                            $('.toggle-password')
                                .text('Show')
                                .attr('aria-pressed', 'false');

                            $form.find('input[type="text"]').each(function () {
                                if (
                                    this.id === 'currentPassword' ||
                                    this.id === 'newPassword' ||
                                    this.id === 'confirmPassword'
                                ) {
                                    this.type = 'password';
                                }
                            });

                            $('#passwordMatchMessage')
                                .removeClass('match no-match')
                                .text('');

                            $('#passwordStrength').hide();
                            $('#strengthFill').css('width', '0%');
                            $('#strengthLabel').text('');

                        }, 0);
                    });

                    $form.on('submit', function (event) {
                        event.preventDefault();

                        if (requestInProgress) return;

                        const currentPassword = $currentPassword.val();
                        const newPassword = $newPassword.val();
                        const confirmPassword = $confirmPassword.val();

                        clearFormMessage();

                        if (!currentPassword || !newPassword || !confirmPassword) {
                            showFormMessage('Please fill in all password fields.', 'danger');
                            return;
                        }

                        if (newPassword.length < 8) {
                            showFormMessage(
                                'Your new password must contain at least 8 characters.',
                                'danger'
                            );

                            $newPassword.trigger('focus');
                            return;
                        }

                        if (currentPassword === newPassword) {
                            showFormMessage(
                                'Your new password must be different from your current password.',
                                'warning'
                            );

                            $newPassword.trigger('focus');
                            return;
                        }

                        if (newPassword !== confirmPassword) {
                            showFormMessage(
                                'The new password and confirmation do not match.',
                                'danger'
                            );

                            $confirmPassword.trigger('focus');
                            return;
                        }

                        requestInProgress = true;

                        $submitButton
                            .prop('disabled', true)
                            .html('<i class="fa-solid fa-spinner fa-spin"></i> Updating...');

                        $.ajax({
                            type: 'POST',
                            url: '/change-password',
                            data: $form.serialize(),
                            dataType: 'json',

                            success: function (response) {
                                if (response && response.success === false) {
                                    showFormMessage(
                                        response.message || 'Unable to update your password.',
                                        'danger'
                                    );

                                    return;
                                }

                                const successMessage = response && response.message
                                    ? response.message
                                    : 'Your password has been updated successfully.';

                                Swal.fire({
                                    icon: 'success',
                                    title: 'Password Updated',
                                    text: successMessage,
                                    confirmButtonText: 'OK',
                                    confirmButtonColor: '#f4512c'
                                }).then(function () {
                                    $form[0].reset();
                                });
                            },

                            error: function (xhr) {
                                const response = xhr.responseJSON;

                                const errorMessage = response && response.message
                                    ? response.message
                                    : 'Unable to update your password. Please check your details and try again.';

                                showFormMessage(errorMessage, 'danger');
                            },

                            complete: function () {
                                requestInProgress = false;

                                $submitButton
                                    .prop('disabled', false)
                                    .html('<i class="fa-solid fa-shield-halved"></i> Update Password');
                            }
                        });
                    });

                });
            </script>

</body>

</html>