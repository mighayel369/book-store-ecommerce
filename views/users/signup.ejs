<!doctype html>
<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <style>
        .container{
            height:110vh
        }
        
        .facebook{
              text-align: center;
              background-color: #3b5998;
              color: white;
              width: 400px;
              height: 45px;
              padding: 7px;
              border: 2px solid #3b5998;
              border-radius: 10px;
            }
            .google{
              text-align: center;
              background-color: red;
              color: white;
              width: 400px;
              height: 45px;
              padding: 7px;
              border: 2px solid red;
              border-radius: 10px;
              opacity:80%;
            }
    </style>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <title>Hello, world!</title>
  </head>
  <body>
    <%- include('../partials/userHeader') %>
   <div class="container  d-flex justify-content-center align-items-center">
    <div class="signup">
      <h3 class="fw-bold text-center mb-5 fs-2">Create An Account</h3>
      <div class="facebook"><a href="/facebook" class="text-decoration-none text-white"><span><i class="fa-brands fa-facebook-f mx-3 fs-4"></i></span>Sign in with Facebook</a></div>
      <div class="google mt-3"><a href="/google" class="text-decoration-none text-white"><span><i class="fa-brands fa-google mx-3 fs-4"></i></span>Sign in with Google</a></div>
      <p class="text-center my-4">Please fill the fields:</p>
    <form action="/signup" method="post">
        <div class="mb-3 ">
            <input type="username" class="form-control" id="username" placeholder="Name" name="username">
        </div>
        <div class="mb-3 ">
          <input type="email" class="form-control" id="email" placeholder="Enter email" name="email">
        </div>
        <div class="mb-3">
            <input type="number" class="form-control" id="phoneno" placeholder="Phone Number" name="phoneno">
        </div>
        <div class="mb-3">     
          <input type="password" class="form-control" id="password" placeholder="Enter password" name="password">
        </div>
        <div class="mb-3">
            <input type="password" class="form-control" id="confirmpassword" placeholder="Confirm password" name="confirmpassword">
        </div>
        <% if (message) {%>
          <div id="change"><p class="text-black fw-light"><%= message.message %></p></div>
        <% } %>
        <div class="d-grid ">
            <button class="btn btn-dark" type="submit">Signup</button>
        </div>
        <p class="text-center mt-2">Already have an account?<a href='/login' class="link-primary  fw-bold text-decoration-none mx-2">Login</a></p>
      </form>
    </div>
   </div>
   <%- include('../partials/userfooter') %>
    <script >
    let usernameInput = document.querySelector('#username');
      let changeElement = document.querySelector('#change');
      
      
      usernameInput.addEventListener('focus', () => {
        changeElement.innerText = '';
      });
      </script>
         <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
         <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>
  </body>
</html>