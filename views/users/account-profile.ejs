<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Personal Data | Shoe Rack</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --brand: #f4512c;
            --brand-dark: #d83c1b;
            --brand-light: #fff1ec;
            --text: #262626;
            --muted: #777;
            --border: #ececec;
            --page-bg: #f7f7f8;
            --white: #fff;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: var(--page-bg);
            color: var(--text);
        }

        a {
            text-decoration: none;
        }

        .account-page {
            min-height: 75vh;
            padding: 25px 0 65px;
        }

        .account-container {
            max-width: 1320px;
            margin: auto;
            padding: 0 22px;
        }

        .breadcrumb-line {
            font-size: 13px;
            color: var(--muted);
            margin-bottom: 28px;
        }

        .breadcrumb-line a {
            color: var(--muted);
            transition: color .2s;
        }

        .breadcrumb-line a:hover {
            color: var(--brand);
        }

        .breadcrumb-line .current {
            color: var(--brand);
            font-weight: 700;
        }

        .page-heading {
            margin-bottom: 25px;
        }

        .page-heading h1 {
            font-size: clamp(25px, 3vw, 34px);
            font-weight: 800;
            letter-spacing: -.7px;
            margin: 0 0 8px;
        }

        .page-heading p {
            color: var(--muted);
            font-size: 14px;
            margin: 0;
        }

        .account-nav-wrapper {
            position: sticky;
            top: 20px;
        }

        .account-nav-wrapper .account-nav {
            width: 100%;
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 18px;
            box-shadow: 0 5px 22px rgba(0, 0, 0, .035);
        }


        .profile-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 5px 24px rgba(0, 0, 0, .035);
        }

        .profile-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 25px 28px;
            border-bottom: 1px solid var(--border);
            background: linear-gradient(135deg, #fff 0%, #fff8f5 100%);
        }

        .profile-card-header h2 {
            font-size: 19px;
            font-weight: 800;
            margin: 0 0 6px;
        }

        .profile-card-header p {
            color: var(--muted);
            font-size: 12px;
            margin: 0;
        }

        .edit-profile-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 1px solid var(--brand);
            background: var(--brand);
            color: white;
            border-radius: 10px;
            padding: 11px 16px;
            font-size: 12px;
            font-weight: 750;
            white-space: nowrap;
            transition: all .2s;
        }

        .edit-profile-btn:hover {
            color: white;
            background: var(--brand-dark);
            border-color: var(--brand-dark);
            transform: translateY(-1px);
        }

        .profile-content {
            padding: 30px;
        }

        .profile-overview {
            display: flex;
            align-items: center;
            gap: 22px;
            padding: 22px;
            border: 1px solid #f0e5e1;
            border-radius: 15px;
            background: #fffaf8;
            margin-bottom: 30px;
        }

        .profile-avatar {
            width: 105px;
            height: 105px;
            flex-shrink: 0;
            border-radius: 50%;
            overflow: hidden;
            border: 4px solid white;
            box-shadow: 0 0 0 1px #f1d5cb;
            background: var(--brand-light);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .profile-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .profile-avatar i {
            font-size: 55px;
            color: #e4a18d;
        }

        .profile-overview-info {
            min-width: 0;
        }

        .profile-overview-info h3 {
            font-size: 21px;
            font-weight: 800;
            margin: 0 0 7px;
            overflow-wrap: anywhere;
        }

        .profile-overview-info p {
            color: var(--muted);
            font-size: 13px;
            margin: 0 0 10px;
            overflow-wrap: anywhere;
        }

        .account-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 20px;
            color: #267b48;
            background: #eaf8ef;
            font-size: 11px;
            font-weight: 750;
        }

        .account-status i {
            font-size: 8px;
        }

        .details-heading {
            font-size: 14px;
            font-weight: 800;
            margin: 0 0 18px;
        }

        .profile-detail {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            padding: 17px;
            border: 1px solid var(--border);
            border-radius: 12px;
            margin-bottom: 13px;
            min-width: 0;
            transition: border-color .2s;
        }

        .profile-detail:hover {
            border-color: #f3c2b4;
        }

        .detail-icon {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--brand);
            background: var(--brand-light);
            flex-shrink: 0;
            font-size: 16px;
        }

        .detail-content {
            min-width: 0;
            flex: 1;
        }

        .detail-label {
            display: block;
            color: #888;
            font-size: 11px;
            font-weight: 650;
            margin-bottom: 6px;
        }

        .detail-value {
            display: block;
            font-size: 14px;
            font-weight: 700;
            color: #292929;
            overflow-wrap: anywhere;
            word-break: break-word;
        }

        .detail-value.muted {
            color: #999;
            font-weight: 500;
        }

        .detail-note {
            color: #999;
            font-size: 11px;
            margin-top: 5px;
        }

        .profile-security-note {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin-top: 15px;
            padding: 16px;
            border-radius: 12px;
            background: #f5f8ff;
            color: #5b6b88;
            font-size: 12px;
            line-height: 1.6;
        }

        .profile-security-note i {
            margin-top: 2px;
            font-size: 16px;
        }


        .profile-offcanvas {
            width: min(500px, 100%) !important;
            border: 0;
            box-shadow: -10px 0 50px rgba(0, 0, 0, .08);
        }

        .profile-offcanvas .offcanvas-header {
            padding: 25px;
            border-bottom: 1px solid var(--border);
            background: linear-gradient(135deg, #fff 0%, #fff8f5 100%);
        }

        .profile-offcanvas .offcanvas-title {
            font-size: 20px;
            font-weight: 800;
        }

        .offcanvas-subtitle {
            color: var(--muted);
            font-size: 12px;
            margin: 6px 0 0;
        }

        .profile-offcanvas .offcanvas-body {
            padding: 25px;
        }

        .edit-avatar-preview {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 15px 0 25px;
        }

        .edit-avatar-preview img,
        .edit-avatar-preview .avatar-placeholder {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 50%;
            border: 4px solid white;
            box-shadow: 0 0 0 1px #eee;
        }

        .edit-avatar-preview .avatar-placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--brand-light);
            color: #e4a18d;
            font-size: 50px;
        }

        .edit-avatar-preview small {
            margin-top: 10px;
            color: var(--muted);
            font-size: 11px;
        }

        .form-label {
            color: #505050;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .form-control {
            border: 1px solid #e2e2e2;
            border-radius: 10px;
            padding: 12px 13px;
            font-size: 13px;
        }

        .form-control:focus {
            border-color: var(--brand);
            box-shadow: 0 0 0 .2rem rgba(244, 81, 44, .12);
        }

        .form-control[type="file"] {
            padding: 10px;
        }

        .form-text {
            font-size: 11px;
            color: #888;
        }

        .profile-submit-btn {
            width: 100%;
            padding: 13px;
            border-radius: 10px;
            border: 1px solid var(--brand);
            background: var(--brand);
            color: white;
            font-size: 13px;
            font-weight: 800;
            transition: background .2s;
        }

        .profile-submit-btn:hover {
            background: var(--brand-dark);
            border-color: var(--brand-dark);
        }

        .colored-toast {
            background: #262626 !important;
            color: #fff !important;
        }

        @media (max-width: 991px) {
            .account-nav-wrapper {
                position: static;
                margin-bottom: 22px;
            }

            .account-nav-wrapper .account-nav {
                padding: 12px;
            }

            .account-nav-heading {
                padding-bottom: 8px;
            }
        }

        @media (max-width: 575px) {
            .account-container {
                padding: 0 12px;
            }

            .account-page {
                padding-top: 18px;
            }

            .breadcrumb-line {
                margin-bottom: 20px;
            }

            .profile-card-header {
                align-items: flex-start;
                padding: 20px 17px;
            }

            .profile-card-header h2 {
                font-size: 17px;
            }

            .profile-card-header p {
                line-height: 1.5;
            }

            .edit-profile-btn {
                padding: 10px;
                font-size: 11px;
            }

            .edit-profile-btn .button-text {
                display: none;
            }

            .profile-content {
                padding: 17px;
            }

            .profile-overview {
                padding: 15px;
                gap: 14px;
                margin-bottom: 24px;
            }

            .profile-avatar {
                width: 78px;
                height: 78px;
            }

            .profile-avatar i {
                font-size: 43px;
            }

            .profile-overview-info h3 {
                font-size: 17px;
            }

            .profile-overview-info p {
                font-size: 11px;
            }

            .profile-detail {
                padding: 13px;
                gap: 11px;
            }

            .detail-icon {
                width: 37px;
                height: 37px;
                font-size: 14px;
            }

            .detail-value {
                font-size: 13px;
            }

            .profile-offcanvas .offcanvas-header,
            .profile-offcanvas .offcanvas-body {
                padding: 19px;
            }
        }
    </style>
</head>

<body>
    <%- include('../partials/userHeader') %>

        <main class="account-page">
            <div class="container">

                <nav class="breadcrumb-line" aria-label="Breadcrumb">
                    <a href="/">Home</a>
                    <span class="mx-2">/</span>
                    <a href="/account">Account</a>
                    <span class="mx-2">/</span>
                    <span class="current">Personal Data</span>
                </nav>


                <% if (message && message.message) { %>
                    <div id="flash-message" hidden>
                        <%= message.message %>
                    </div>

                    <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            const messageElement = document.getElementById('flash-message');

                            if (messageElement) {
                                Swal.fire({
                                    toast: true,
                                    position: 'top-end',
                                    title: messageElement.textContent.trim(),
                                    showConfirmButton: false,
                                    timer: 2500,
                                    timerProgressBar: true,
                                    background: '#218838',
                                    color: '#fff',
                                    customClass: {
                                        popup: 'colored-toast'
                                    }
                                });
                            }
                        });
                    </script>
                    <% } %>


                        <div class="row g-4">

                            <div class="col-lg-3 col-md-4">
                                <div class="account-nav-wrapper">
                                    <%- include('../partials/account-nav') %>
                                </div>
                            </div>

                            <div class="col-lg-9 col-md-8">
                                <section class="profile-card">

                                    <div class="profile-card-header">
                                        <div>
                                            <h2>Personal Information</h2>
                                            <p>View and update your profile details.</p>
                                        </div>

                                        <button type="button" class="edit-profile-btn" data-bs-toggle="offcanvas"
                                            data-bs-target="#editProfileCanvas" aria-controls="editProfileCanvas">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                            <span class="button-text">Edit Profile</span>
                                        </button>
                                    </div>

                                    <div class="profile-content">

                                        <div class="profile-overview">
                                            <div class="profile-avatar">
                                                <% if (users.photo) { %>
                                                    <img src="<%= users.photo %>" alt="Profile picture"
                                                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                    <i class="fa-solid fa-user" style="display:none;"></i>
                                                    <% } else { %>
                                                        <i class="fa-solid fa-user"></i>
                                                        <% } %>
                                            </div>

                                            <div class="profile-overview-info">
                                                <h3>
                                                    <%= users.username || 'User' %>
                                                </h3>

                                                <p>
                                                    <i class="fa-regular fa-envelope me-1"></i>
                                                    <%= users.email || 'Email not provided' %>
                                                </p>

                                                <span class="account-status">
                                                    <i class="fa-solid fa-circle"></i>
                                                    Account Profile
                                                </span>
                                            </div>
                                        </div>

                                        <h3 class="details-heading">Account Details</h3>

                                        <div class="row g-2">

                                            <div class="col-md-6">
                                                <div class="profile-detail">
                                                    <div class="detail-icon">
                                                        <i class="fa-solid fa-user"></i>
                                                    </div>

                                                    <div class="detail-content">
                                                        <span class="detail-label">Full Name</span>
                                                        <% if (users.username) { %>
                                                            <span class="detail-value">
                                                                <%= users.username %>
                                                            </span>
                                                            <% } else { %>
                                                                <span class="detail-value muted">Not provided</span>
                                                                <% } %>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-md-6">
                                                <div class="profile-detail">
                                                    <div class="detail-icon">
                                                        <i class="fa-regular fa-envelope"></i>
                                                    </div>

                                                    <div class="detail-content">
                                                        <span class="detail-label">Email Address</span>
                                                        <% if (users.email) { %>
                                                            <span class="detail-value">
                                                                <%= users.email %>
                                                            </span>
                                                            <% } else { %>
                                                                <span class="detail-value muted">Not provided</span>
                                                                <% } %>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-md-6">
                                                <div class="profile-detail">
                                                    <div class="detail-icon">
                                                        <i class="fa-solid fa-phone"></i>
                                                    </div>

                                                    <div class="detail-content">
                                                        <span class="detail-label">Phone Number</span>
                                                        <% if (users.phoneno) { %>
                                                            <span class="detail-value">
                                                                <%= users.phoneno %>
                                                            </span>
                                                            <% } else { %>
                                                                <span class="detail-value muted">Not provided</span>
                                                                <% } %>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-md-6">
                                                <div class="profile-detail">
                                                    <div class="detail-icon">
                                                        <i class="fa-solid fa-lock"></i>
                                                    </div>

                                                    <div class="detail-content">
                                                        <span class="detail-label">Password</span>
                                                        <span class="detail-value">••••••••••</span>
                                                        <div class="detail-note">
                                                            Your password is kept private.
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="profile-security-note">
                                            <i class="fa-solid fa-shield-halved"></i>
                                            <div>
                                                <strong>Your information matters.</strong>
                                                <br>
                                                Keep your contact details up to date so you can receive order and
                                                delivery updates.
                                                Your actual password is never displayed on this page.
                                            </div>
                                        </div>

                                    </div>
                                </section>
                            </div>

                        </div>
            </div>
        </main>


        <div class="offcanvas offcanvas-end profile-offcanvas" tabindex="-1" id="editProfileCanvas"
            aria-labelledby="editProfileCanvasLabel">
            <div class="offcanvas-header">
                <div>
                    <h5 class="offcanvas-title" id="editProfileCanvasLabel">
                        Edit Profile
                    </h5>
                    <p class="offcanvas-subtitle">
                        Update your personal information below.
                    </p>
                </div>

                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>

            <div class="offcanvas-body">

                <form action="/edit-profile" method="post" enctype="multipart/form-data" id="editProfileForm">

                    <div class="edit-avatar-preview">
                        <% if (users.photo) { %>
                            <img src="<%= users.photo %>" alt="Current profile picture" id="photoPreview">
                            <% } else { %>
                                <div class="avatar-placeholder" id="photoPlaceholder">
                                    <i class="fa-solid fa-user"></i>
                                </div>

                                <img src="" alt="Profile photo preview" id="photoPreview" style="display:none;">
                                <% } %>

                                    <small>Choose a photo to update your profile picture.</small>
                    </div>

                    <div class="mb-3">
                        <label for="edit-username" class="form-label">
                            Full Name
                        </label>

                        <input type="text" class="form-control" id="edit-username" name="username"
                            value="<%= users.username || '' %>" placeholder="Enter your full name" required
                            minlength="2" maxlength="80" autocomplete="name">
                    </div>

                    <div class="mb-3">
                        <label for="edit-email" class="form-label">
                            Email Address
                        </label>

                        <input type="email" class="form-control" id="edit-email" name="email"
                            value="<%= users.email || '' %>" placeholder="Enter your email" required
                            autocomplete="email">
                    </div>

                    <div class="mb-3">
                        <label for="edit-phoneno" class="form-label">
                            Phone Number
                        </label>

                        <input type="tel" class="form-control" id="edit-phoneno" name="phoneno"
                            value="<%= users.phoneno || '' %>" placeholder="Enter your phone number" pattern="[0-9]{10}"
                            maxlength="10" inputmode="numeric" required autocomplete="tel">

                        <div class="form-text">
                            Enter a 10-digit phone number.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="photo" class="form-label">
                            Profile Photo
                        </label>

                        <input type="file" class="form-control" id="photo" name="photo"
                            accept="image/jpeg,image/png,image/webp">

                        <div class="form-text">
                            JPG, PNG, or WebP images are recommended.
                        </div>
                    </div>

                    <button type="submit" class="profile-submit-btn" id="saveProfileButton">
                        <i class="fa-solid fa-check me-2"></i>
                        Save Changes
                    </button>

                </form>
            </div>
        </div>

        <%- include('../partials/userfooter') %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

            <script>
                $(document).ready(function () {


                    $('#photo').on('change', function () {
                        const file = this.files && this.files[0];

                        if (!file) return;

                        const allowedTypes = [
                            'image/jpeg',
                            'image/png',
                            'image/webp'
                        ];

                        if (!allowedTypes.includes(file.type)) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Unsupported image',
                                text: 'Please select a JPG, PNG, or WebP image.'
                            });

                            this.value = '';
                            return;
                        }

                        const maxSize = 5 * 1024 * 1024;

                        if (file.size > maxSize) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Image is too large',
                                text: 'Please choose an image smaller than 5 MB.'
                            });

                            this.value = '';
                            return;
                        }

                        const reader = new FileReader();

                        reader.onload = function (event) {
                            $('#photoPreview')
                                .attr('src', event.target.result)
                                .show();

                            $('#photoPlaceholder').hide();
                        };

                        reader.readAsDataURL(file);
                    });

                    $('#editProfileForm').on('submit', function (event) {
                        if (!this.checkValidity()) {
                            event.preventDefault();
                            this.reportValidity();
                            return;
                        }

                        $('#saveProfileButton')
                            .prop('disabled', true)
                            .html(
                                '<span class="spinner-border spinner-border-sm me-2"></span>Saving...'
                            );
                    });
                });
            </script>

</body>

</html>