<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Centered Profile Card</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
            color: #333;
        }

        .account-nav {
            border: 1px solid #ccc;
            border-radius: 10px;
            padding: 20px;
            width: 100%;
            font-weight: bold;
            background-color: #fff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .account-navitem {
            border-bottom: 1px solid #ccc;
            padding: 10px;
            cursor: pointer;
        }

        .account-navitem:last-child {
            border-bottom: none;
        }

        .nav-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: #555;
            text-decoration: none;
        }

        .nav-link i {
            margin-right: 10px;
        }

        .account {
            margin-left: 30px;
            margin-top: 70px;
        }

        .active {
            background-color: #df9f9f;
            border-radius: 5px;
        }

        .arrow {
            position: absolute;
            left: 255px;
        }

        .addressDiv {
            margin-top: 130px;
            background-color: #fff;
            border: 1px solid #ccc;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            min-height: 400px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .header-section {
            background-color: #b46363;
            color: white;
            height: 50px;
            text-align: center;
            padding-top: 10px;
            border-bottom: 1px solid #ccc;
            width: 100%;
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
        }

        .user-details {
            display: flex;
            justify-content: center;
            padding: 20px 0;
            width: 400px;
        }

        .card {
            width: 100%;
            max-width: 500px;
            border: none;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-radius: 10px;
            overflow: hidden;
            background-color: #fff;
        }

        .card-body {
            padding: 20px;
        }

        .form-control {
            margin-bottom: 15px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }

        .form-control:focus {
            box-shadow: none;
            border-color: #b46363;
        }

        .form-label {
            font-size: 0.9rem;
            color: #777;
        }
        .offcanvas-center {
        top: 20%;
        left: 30%;
        width: 40%; 
        max-width: 300px; 
        height: auto; 
        max-height: 400px; 
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); 
    }
    </style>
</head>
<body>
    <%- include('../partials/userHeader') %>
    <p class="fw-bold text-dark fs-5 mt-4 ms-3">Home > <span>Account ></span><span class="text-warning fs-5"> Personal Data</span></p>
    <div class="container-fluid">
        <% if (message) { %>
            <div class="alert m-4 alert-dismissible fade show alert-<%= message.type %>" role="alert">
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                <strong><%= message.message %></strong>
            </div>
        <% } %>
        <div class="row">
            <div class="col-md-3">
                <%- include('../partials/account-nav') %>
            </div>
            <div class="col-md-9">
                <div class="addressDiv">
                    <div class="header-section">
                        <h5 class="fw-bold">Personal Data</h5>
                    </div>
                    <a class="edit-profile-link text-muted ms-auto m-3 text-decoration-none text-primary fw-bold" data-bs-target="#offcanvasBottom" data-bs-toggle="offcanvas">
                        <i class="fa-solid fa-pen-to-square"></i> Edit Profile
                    </a>
                    <div class="user-details">
                        <div class="card">
                            <div class="profile-image text-center p-3">
                                <i class="fas fa-user-circle fa-5x text-secondary"></i>
                            </div>
                            <div class="card-body">
                                <div class="form-floating mb-3">
                                    <input type="text" class="form-control" id="username" value="<%= users.username ? users.username : 'Not Provided' %>" readonly>
                                    <label class="form-label" for="username">Username</label>
                                </div>
                                <div class="form-floating mb-3">
                                    <input type="text" class="form-control" id="email" value="<%= users.email ? users.email : 'Not Provided' %>" readonly>
                                    <label class="form-label" for="email">Email</label>
                                </div>
                                <div class="form-floating mb-3">
                                    <input type="text" class="form-control" id="phone" value="<%= users.phoneno ? users.phoneno : 'Not Provided' %>" readonly>
                                    <label class="form-label" for="phone">Phone Number</label>
                                </div>
                                <div class="form-floating">
                                    <input type="password" class="form-control" id="password" value="**********" readonly>
                                    <label class="form-label" for="password">Password</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                </div>
                <div class="offcanvas offcanvas-center text-center" tabindex="-1" id="offcanvasBottom" aria-labelledby="offcanvasBottomLabel">
                    <div class="offcanvas-header">
                        <h5 class="offcanvas-title" id="offcanvasBottomLabel">Update Profile</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body small">
                        <form action="/edit-profile" method="post">
                        <div class="mb-3 row">
                            <label for="username" class="col-sm-2 col-form-label">Name</label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" id="username" value="<%= users.username ?users.username:"" %>" name="username">
                            </div>
                        </div>
                        <div class="mb-3 row">
                            <label for="staticEmail" class="col-sm-2 col-form-label">Email</label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" id="staticEmail" value="<%= users.email ?users.email :"" %>" name="email">
                            </div>
                        </div>
                        <div class="mb-3 row">
                            <label for="phoneno" class="col-sm-2 col-form-label">Phone</label>
                            <div class="col-sm-10">
                                <input type="number" class="form-control" id="phoneno" value="<%= users.phoneno ?users.phoneno:"" %>" name="phoneno">
                            </div>
                        </div>
                         <button type="submit" class="btn btn-primary">Update Profile</button>
                    </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/userfooter') %>

    <script>
 $(document).ready(function() {
        const navItems = $('.account-navitem a');
        navItems.each(function() {
            if (window.location.pathname === $(this).attr('href')) {
                $(this).parent().addClass('active');
            }
        });

        navItems.on('click', function() {
            navItems.parent().removeClass('active'); 
            $(this).parent().addClass('active');
        });
    });
</script>
    </script>
</body>
</html>
