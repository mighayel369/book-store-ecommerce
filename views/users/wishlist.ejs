<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>My Wishlist | Shoe Rack</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #faf9f7;
      color: #202020;
      font-family: Arial, Helvetica, sans-serif;
    }

    .wishlist-page {
      width: 100%;
      max-width: 1440px;
      min-height: 65vh;
      margin: 0 auto;
      padding: 30px 40px 70px;
    }



    .wishlist-breadcrumb {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      margin-bottom: 28px;
      color: #777;
      font-size: 13px;
    }

    .wishlist-breadcrumb a {
      color: #777;
      text-decoration: none;
      transition: color 0.2s;
    }

    .wishlist-breadcrumb a:hover {
      color: #f4512c;
    }

    .wishlist-breadcrumb .separator {
      color: #c7c0bc;
    }

    .wishlist-breadcrumb .current {
      color: #f4512c;
      font-weight: 700;
    }



    .wishlist-heading {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 30px;
      padding: 28px 32px;
      border: 1px solid #f0e8e4;
      border-radius: 18px;
      background:
        radial-gradient(circle at 90% 15%,
          rgba(244, 81, 44, 0.10),
          transparent 35%),
        linear-gradient(145deg, #ffffff, #fff5f1);
    }

    .wishlist-eyebrow {
      margin-bottom: 8px;
      color: #f4512c;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .wishlist-heading h1 {
      margin: 0;
      font-size: clamp(26px, 3vw, 34px);
      font-weight: 800;
      letter-spacing: -0.8px;
    }

    .wishlist-heading p {
      margin: 10px 0 0;
      color: #777;
      font-size: 14px;
      line-height: 1.7;
    }

    .wishlist-count {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 40px;
      padding: 9px 15px;
      border: 1px solid #f3d9d0;
      border-radius: 30px;
      background: #fff;
      color: #f4512c;
      font-size: 13px;
      font-weight: 700;
      white-space: nowrap;
    }



    .wishlist-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 25px;
      align-items: stretch;
    }

    .wishlist-product {
      min-width: 0;
      overflow: hidden;
      border: 1px solid #eee8e4;
      border-radius: 16px;
      background: #fff;
      box-shadow: 0 4px 15px rgba(32, 32, 32, 0.035);
      transition:
        transform 0.25s ease,
        box-shadow 0.25s ease,
        border-color 0.25s ease;
    }

    .wishlist-product:hover {
      transform: translateY(-5px);
      border-color: #f3d4ca;
      box-shadow: 0 12px 28px rgba(32, 32, 32, 0.09);
    }

    .wishlist-image-wrapper {
      position: relative;
      overflow: hidden;
      padding: 12px;
      background: #f7f6f4;
    }

    .wishlist-image-link {
      display: block;
      overflow: hidden;
      border-radius: 10px;
      background: #fff;
    }

    .wishlist-image {
      display: block;
      width: 100%;
      height: 230px;
      object-fit: contain;
      mix-blend-mode: multiply;
      transition: transform 0.35s ease;
    }

    .wishlist-product:hover .wishlist-image {
      transform: scale(1.045);
    }

    .wishlist-heart {
      position: absolute;
      top: 20px;
      right: 20px;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 39px;
      height: 39px;
      border: 1px solid #eee3de;
      border-radius: 50%;
      background: #fff;
      color: #f4512c;
      cursor: pointer;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
      transition:
        background 0.2s,
        color 0.2s,
        transform 0.2s;
    }

    .wishlist-heart:hover {
      transform: scale(1.07);
      background: #f4512c;
      color: #fff;
    }

    .wishlist-heart:disabled {
      opacity: 0.6;
      cursor: wait;
    }

    .wishlist-heart i {
      font-size: 16px;
    }

    .wishlist-heart .wishlist-text {
      display: none;
    }

    .wishlist-product-body {
      display: flex;
      flex-direction: column;
      padding: 18px;
    }

    .wishlist-category {
      margin: 0 0 8px;
      color: #f4512c;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.2px;
      text-transform: uppercase;
    }

    .wishlist-product-title {
      display: -webkit-box;
      min-height: 44px;
      margin: 0 0 12px;
      overflow: hidden;
      color: #202020;
      font-size: 15px;
      font-weight: 700;
      line-height: 1.5;
      text-decoration: none;
      text-transform: capitalize;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }

    .wishlist-product-title:hover {
      color: #f4512c;
    }

    .wishlist-price-row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 8px;
      min-height: 28px;
      margin-bottom: 16px;
    }

    .wishlist-price {
      color: #202020;
      font-size: 18px;
      font-weight: 800;
    }

    .wishlist-original-price {
      color: #999;
      font-size: 12px;
      text-decoration: line-through;
    }

    .wishlist-discount {
      color: #16834a;
      font-size: 11px;
      font-weight: 700;
    }

    .wishlist-product-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: auto;
    }

    .wishlist-bag-button {
      display: inline-flex;
      flex: 1;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 43px;
      padding: 10px 12px;
      border: 1px solid #f4512c;
      border-radius: 9px;
      background: #f4512c;
      color: #fff;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s;
    }

    .wishlist-bag-button:hover {
      border-color: #df3f1c;
      background: #df3f1c;
    }

    .wishlist-bag-button:disabled {
      opacity: 0.65;
      cursor: wait;
    }

    .wishlist-bag-button.is-moved {
      border-color: #d8eade;
      background: #edf7ef;
      color: #218447;
      cursor: default;
    }

    .wishlist-bag-button.is-moved:hover {
      border-color: #d8eade;
      background: #edf7ef;
    }



    .wishlist-empty {
      padding: 65px 20px;
      border: 1px solid #f0e8e4;
      border-radius: 18px;
      background: #fff;
      text-align: center;
    }

    .wishlist-empty-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 85px;
      height: 85px;
      margin: 0 auto 22px;
      border-radius: 50%;
      background: #fff0ea;
      color: #f4512c;
      font-size: 32px;
    }

    .wishlist-empty h2 {
      margin: 0 0 12px;
      font-size: 24px;
      font-weight: 800;
    }

    .wishlist-empty p {
      max-width: 420px;
      margin: 0 auto 24px;
      color: #777;
      font-size: 14px;
      line-height: 1.7;
    }

    .wishlist-shop-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      min-height: 45px;
      padding: 12px 22px;
      border-radius: 9px;
      background: #f4512c;
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      transition: background 0.2s;
    }

    .wishlist-shop-button:hover {
      background: #df3f1c;
      color: #fff;
    }


    .wishlist-pagination {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 7px;
      margin-top: 42px;
    }

    .wishlist-pagination .page-link {
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 39px;
      min-height: 39px;
      border: 1px solid #e9e2dd;
      border-radius: 9px;
      background: #fff;
      color: #555;
      font-size: 13px;
      box-shadow: none;
    }

    .wishlist-pagination .page-item.active .page-link {
      border-color: #f4512c;
      background: #f4512c;
      color: #fff;
    }

    .wishlist-pagination .page-link:hover {
      border-color: #f4512c;
      color: #f4512c;
    }

    .wishlist-pagination .page-item.active .page-link:hover {
      color: #fff;
    }


    .colored-toast {
      border-radius: 12px !important;
      color: #fff !important;
    }

    .colored-toast .swal2-title,
    .colored-toast .swal2-html-container {
      color: #fff !important;
    }

    @media (max-width: 1100px) {
      .wishlist-page {
        padding-right: 28px;
        padding-left: 28px;
      }

      .wishlist-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
      }

      .wishlist-image {
        height: 220px;
      }
    }

    @media (max-width: 760px) {
      .wishlist-page {
        padding: 24px 18px 50px;
      }

      .wishlist-heading {
        padding: 23px 22px;
      }

      .wishlist-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }

      .wishlist-image {
        height: 190px;
      }

      .wishlist-product-body {
        padding: 14px;
      }

      .wishlist-product-title {
        font-size: 14px;
      }

      .wishlist-price {
        font-size: 16px;
      }
    }

    @media (max-width: 420px) {
      .wishlist-page {
        padding-right: 12px;
        padding-left: 12px;
      }

      .wishlist-grid {
        gap: 10px;
      }

      .wishlist-image-wrapper {
        padding: 7px;
      }

      .wishlist-image {
        height: 145px;
      }

      .wishlist-heart {
        top: 12px;
        right: 12px;
        width: 33px;
        height: 33px;
      }

      .wishlist-product-body {
        padding: 11px;
      }

      .wishlist-product-title {
        min-height: 42px;
        font-size: 13px;
      }

      .wishlist-product-actions {
        gap: 5px;
      }

      .wishlist-bag-button {
        gap: 5px;
        padding: 9px 6px;
        font-size: 10px;
      }

      .wishlist-empty {
        padding: 45px 16px;
      }
    }
  </style>
</head>

<body>

  <%- include('../partials/userHeader') %>

    <main class="wishlist-page">

      <nav class="wishlist-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span class="current">My Wishlist</span>
      </nav>

      <% const wishlistCount=Array.isArray(productlist) ? productlist.length : 0; %>

        <section class="wishlist-heading">
          <div>
            <div class="wishlist-eyebrow">Your favourites</div>
            <h1>My Wishlist <i class="fa-regular fa-heart" style="color:#f4512c;font-size:25px;"></i></h1>
            <p>Keep the shoes you love in one place, ready for your next purchase.</p>
          </div>

          <div class="wishlist-count">
            <i class="fa-solid fa-heart"></i>
            <span>
              <%= wishlistCount %>
                <%= wishlistCount===1 ? 'item' : 'items' %>
            </span>
          </div>
        </section>

        <% if (wishlistCount> 0) { %>

          <section class="wishlist-grid" id="divContainer" aria-label="Wishlist products">

            <% productlist.forEach(product=> { %>

              <% const isInWishlist=users.wishlist.some(id=>
                id.equals ? id.equals(product._id) : String(id) === String(product._id)
                );

                const offerSource = product.discountSource;

                let hasOffer = false;
                let displayedPrice = product.productprice;
                let discountLabel = '';

                if (
                offerSource === 'category' &&
                product.categoryoffer &&
                product.categoryoffer.isOfferActive
                ) {
                hasOffer = true;
                displayedPrice = product.productdiscount;

                if (product.categoryoffer.discountType === 'percentage') {
                discountLabel = product.categoryoffer.discountValue + '% off';
                } else if (product.categoryoffer.discountType === 'fixed') {
                discountLabel = 'Save Rs. ' + product.categoryoffer.discountValue;
                }
                } else if (
                offerSource === 'product' &&
                product.productoffer &&
                product.productoffer.isOfferActive
                ) {
                hasOffer = true;
                displayedPrice = product.productdiscount;

                if (product.productoffer.discountType === 'percentage') {
                discountLabel = product.productoffer.discountValue + '% off';
                } else if (product.productoffer.discountType === 'fixed') {
                discountLabel = 'Save Rs. ' + product.productoffer.discountValue;
                }
                }

                const categoryName =
                product.productcategory && product.productcategory.categoryname
                ? product.productcategory.categoryname
                : 'Shoes';

                const productImage =
                product.image && product.image.length > 0
                ? '/product_images/' + product.image[0]
                : '';
                %>

                <article class="wishlist-product vis-products" data-product-id="<%= product._id %>">

                  <div class="wishlist-image-wrapper">

                    <a href="/singlepage/<%= product._id %>" class="wishlist-image-link"
                      aria-label="View <%= product.productname %>">
                      <% if (product.image[0]) { %>
                        <img src="<%= product.image[0] %>" class="wishlist-image" alt="<%= product.productname %>"
                          loading="lazy">
                        <% } else { %>
                          <div class="wishlist-image d-flex align-items-center justify-content-center" role="img"
                            aria-label="No product image available">
                            <i class="fa-solid fa-shoe-prints fa-2x text-secondary"></i>
                          </div>
                          <% } %>
                    </a>

                    <button type="button" class="wishlist-heart <%= isInWishlist ? 'wishlisted' : '' %>"
                      onclick="addtowishlist('<%= product._id %>', this)"
                      aria-label="<%= isInWishlist ? 'Remove or update wishlist status' : 'Add to wishlist' %>"
                      aria-pressed="<%= isInWishlist ? 'true' : 'false' %>"
                      title="<%= isInWishlist ? 'Wishlisted' : 'Add to wishlist' %>">
                      <i class="<%= isInWishlist ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
                      <span class="wishlist-text">
                        <%= isInWishlist ? 'WISHLISTED' : 'WISHLIST' %>
                      </span>
                    </button>

                  </div>

                  <div class="wishlist-product-body">

                    <p class="wishlist-category">
                      <%= categoryName %>
                    </p>

                    <a href="/singlepage/<%= product._id %>" class="wishlist-product-title"
                      title="<%= product.productname %>">
                      <%= product.productname %>
                    </a>

                    <div class="wishlist-price-row">

                      <span class="wishlist-price">
                        Rs. <%= displayedPrice %>
                      </span>

                      <% if (hasOffer) { %>
                        <span class="wishlist-original-price">
                          Rs. <%= product.productprice %>
                        </span>

                        <% if (discountLabel) { %>
                          <span class="wishlist-discount">
                            <%= discountLabel %>
                          </span>
                          <% } %>
                            <% } %>

                    </div>

                    <div class="wishlist-product-actions">

                      <button type="button" class="wishlist-bag-button" onclick="addtobag('<%= product._id %>', this)">
                        <i class="fa-solid fa-bag-shopping"></i>
                        <span>Move to Bag</span>
                      </button>

                    </div>

                  </div>

                </article>

                <% }) %>

          </section>

          <% if (totalPages> 1) { %>
            <nav aria-label="Wishlist pagination">
              <ul class="pagination wishlist-pagination">

                <% for (let i=1; i <=totalPages; i++) { %>

                  <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                    <a class="page-link"
                      href="?page=<%= i %>&limit=<%= limit %>&search=<%= typeof search !== 'undefined' ? search : '' %>"
                      <%=i===currentPage ? 'aria-current="page"' : '' %>
                      >
                      <%= i %>
                    </a>
                  </li>

                  <% } %>

              </ul>
            </nav>
            <% } %>

              <% } else { %>

                <section class="wishlist-empty" id="divContainer">

                  <div class="wishlist-empty-icon">
                    <i class="fa-regular fa-heart"></i>
                  </div>

                  <h2>Your wishlist is waiting</h2>

                  <p>
                    You haven't saved any shoes yet. Explore our collection
                    and add your favourites here for easy access later.
                  </p>

                  <a href="/" class="wishlist-shop-button">
                    <i class="fa-solid fa-arrow-left"></i>
                    Explore Shoes
                  </a>

                </section>

                <% } %>

    </main>

    <%- include('../partials/userfooter') %>

      <script>
        function showToast(message, type = 'success') {
          Swal.fire({
            toast: true,
            position: 'top-end',
            icon: type,
            text: message || 'Something went wrong. Please try again.',
            showConfirmButton: false,
            timer: 2500,
            timerProgressBar: true,
            background: type === 'success' ? '#218447' : '#c62828',
            color: '#fff',
            customClass: {
              popup: 'colored-toast'
            }
          });
        }

        function getErrorMessage(xhr) {
          return xhr.responseJSON && xhr.responseJSON.message
            ? xhr.responseJSON.message
            : 'Something went wrong. Please try again.';
        }

        function addtowishlist(productId, element) {
          const button = $(element);

          if (button.prop('disabled')) {
            return;
          }

          button.prop('disabled', true);

          $.ajax({
            url: '/add-to-wishlist',
            type: 'POST',
            data: {
              productId: productId
            },

            success: function (response) {
              const icon = button.find('.fa-heart');
              const text = button.find('.wishlist-text');

              button
                .addClass('wishlisted')
                .attr('aria-pressed', 'true')
                .attr('aria-label', 'Wishlisted')
                .attr('title', 'Wishlisted');

              icon.removeClass('fa-regular').addClass('fa-solid');
              text.text('WISHLISTED');

              showToast(response.message, 'success');
            },

            error: function (xhr) {
              const errorMessage = getErrorMessage(xhr);

              if (xhr.status === 401) {
                window.location.href = '/login';
                return;
              }

              showToast(errorMessage, 'error');
            },

            complete: function () {
              button.prop('disabled', false);
            }
          });
        }

        function addtobag(productId, element) {
          const button = $(element);

          if (button.prop('disabled') || button.hasClass('is-moved')) {
            return;
          }

          const originalContent = button.html();

          button.prop('disabled', true);

          $.ajax({
            url: '/add-to-cart',
            type: 'POST',
            data: {
              productId: productId
            },

            success: function (response) {
              button
                .addClass('is-moved')
                .html(
                  '<i class="fa-solid fa-check"></i>' +
                  '<span>Moved</span>'
                );

              showToast(response.message, 'success');
            },

            error: function (xhr) {
              if (xhr.status === 401) {
                window.location.href = '/login';
                return;
              }

              showToast(getErrorMessage(xhr), 'error');
              button.html(originalContent);
            },

            complete: function () {
              button.prop('disabled', false);
            }
          });
        }


        $(document).ready(function () {
          const searchInput = $('#search-input');

          if (!searchInput.length) {
            return;
          }

          let searchRequest;

          searchInput.on('input', function () {
            const query = $(this).val().trim();

            if (searchRequest) {
              searchRequest.abort();
            }

            if (!query) {
              window.location.href = '/wishlist';
              return;
            }

            searchRequest = $.ajax({
              url: '/wishlist',
              type: 'GET',
              data: {
                search: query,
                page: 1
              },
              dataType: 'json',

              success: function (response) {
                if (response && typeof response.html === 'string') {
                  $('#divContainer').html(response.html);
                }
              },

              error: function (xhr, status, error) {
                if (status === 'abort') return;

                if (xhr.status === 401 || xhr.status === 403) {
                  window.location.href = '/login';
                  return;
                }

                if (xhr.status >= 500) {
                  Swal.fire({
                    icon: 'error',
                    title: 'Server error',
                    text: 'Unable to search your wishlist right now. Please try again later.'
                  });
                  return;
                }

                Swal.fire({
                  icon: 'error',
                  title: 'Search failed',
                  text: 'Unable to fetch wishlist results. Please try again.'
                });
              }
            });
          });
        });
      </script>

</body>

</html>