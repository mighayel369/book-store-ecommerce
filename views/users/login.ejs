<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <style>
    .container {
      height: 90vh
    }

    .facebook {
      text-align: center;
      background-color: #3b5998;
      color: white;
      width: 400px;
      height: 45px;
      padding: 7px;
      border: 2px solid #3b5998;
      border-radius: 10px;
    }

    .google {
      text-align: center;
      background-color: red;
      color: white;
      width: 400px;
      height: 45px;
      padding: 7px;
      border: 2px solid red;
      border-radius: 10px;
      opacity: 80%;
    }
  </style>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

  <title>Shoe Rack</title>
</head>

<body>
  <%- include('../partials/userHeader') %>
    <div class="container  d-flex justify-content-center align-items-center">
      <div class="login">
        <h3 class="fw-bold text-center mb-5 fs-2">Login</h3>
        <div class="facebook"><a href="/facebook" class="text-decoration-none text-white"><span><i
                class="fa-brands fa-facebook-f mx-3 fs-4"></i></span>Sign in with Facebook</a></div>
        <div class="google mt-3"><a href="/google" class="text-decoration-none text-white"><span><i
                class="fa-brands fa-google mx-3 fs-4"></i></span>Sign in with Google</a></div>
        <p class="text-center my-4">Please enter your email and password:</p>
        <form action="/login" method="post">
          <div class="mb-3 mt-3">
            <input type="email" class="form-control" id="email" placeholder="Enter email" name="email">
          </div>
          <div class=" position-relative">
            <input type="password" class="form-control" id="password" placeholder="Enter password" name="password">
            <span id="togglePassword" class="position-absolute top-50 end-0 translate-middle-y me-3 cursor-pointer">
              <i class="fas fa-eye-slash"></i>
            </span>
          </div>
          <div class="d-flex justify-content-end mb-3">
            <a href='/verify-email' class="text-decoration-none text-dark" style="font-size:.9rem;">Forgot Password</a>
          </div>
          <div class="d-flex justify-content-center">
            <% if (message) { %>
              <p class="text-danger fw-light">
                <%= message.message %>
              </p>
              <% } %>
          </div>
          <div class="d-grid">
            <button class="btn btn-dark" type="submit">Login</button>
          </div>
          <p class="text-center mt-2">Don't have an account?<a href='/signup'
              class="link-primary  fw-bold text-decoration-none mx-2">Signup</a></p>
        </form>
      </div>
    </div>
    <%- include('../partials/userfooter') %>

      <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"></script>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
        integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
        crossorigin="anonymous"></script>

      <script>
        document.addEventListener('DOMContentLoaded', function () {
          const togglePassword = document.getElementById('togglePassword');
          const password = document.getElementById('password');

          togglePassword.addEventListener('click', function () {
            const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
            password.setAttribute('type', type);

            this.querySelector('i').classList.toggle('fa-eye');
            this.querySelector('i').classList.toggle('fa-eye-slash');
          });
        });
      </script>

</body>

</html>
</body>

</html>