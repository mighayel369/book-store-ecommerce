<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shopping Cart | Shoe Rack</title>


  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet">
  <style>
    :root {
      --sr-primary: #f4512c;
      --sr-primary-dark: #d83e1c;
      --sr-text: #252525;
      --sr-muted: #777;
      --sr-border: #eeeeee;
      --sr-bg: #f8f9fb;
      --sr-success: #16834a;
    }

    .sr-cart-page,
    .sr-cart-page * {
      box-sizing: border-box;
    }

    .sr-cart-page {
      min-height: 80vh;
      padding: 28px 0 65px;
      background: var(--sr-bg);
      color: var(--sr-text);
    }

    .sr-cart-container {
      width: min(1320px, 94%);
      margin: 0 auto;
    }

    .sr-breadcrumb {
      margin-bottom: 25px;
      color: var(--sr-muted);
      font-size: 14px;
    }

    .sr-breadcrumb a {
      color: var(--sr-muted);
      text-decoration: none;
    }

    .sr-breadcrumb a:hover {
      color: var(--sr-primary);
    }

    .sr-breadcrumb span {
      color: var(--sr-primary);
      font-weight: 600;
    }

    .sr-page-heading {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 28px;
    }

    .sr-page-heading h1 {
      margin: 0;
      font-size: clamp(27px, 3vw, 36px);
      font-weight: 750;
      letter-spacing: -1px;
    }

    .sr-page-heading p {
      margin: 7px 0 0;
      color: var(--sr-muted);
      font-size: 14px;
    }

    .sr-cart-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 350px;
      align-items: start;
      gap: 26px;
    }

    .sr-cart-card,
    .sr-summary-card {
      background: #fff;
      border: 1px solid var(--sr-border);
      border-radius: 16px;
      box-shadow: 0 5px 25px rgba(0, 0, 0, 0.035);
    }

    .sr-cart-card {
      padding: 24px;
      min-width: 0;
    }

    .sr-cart-card-heading {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--sr-border);
    }

    .sr-cart-card-heading h2 {
      margin: 0;
      font-size: 20px;
      font-weight: 700;
    }

    .sr-item-count {
      padding: 7px 12px;
      border-radius: 30px;
      background: #fff0eb;
      color: var(--sr-primary);
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    .sr-product-row {
      display: grid;
      grid-template-columns: 145px minmax(0, 1fr) auto;
      align-items: center;
      gap: 22px;
      padding: 25px 0;
      border-bottom: 1px solid var(--sr-border);
    }

    .sr-product-row:last-child {
      padding-bottom: 5px;
      border-bottom: none;
    }

    .sr-product-image {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 145px;
      height: 155px;
      padding: 10px;
      overflow: hidden;
      border-radius: 12px;
      background: #f7f7f7;
    }

    .sr-product-image img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      transition: transform 0.25s ease;
    }

    .sr-product-image:hover img {
      transform: scale(1.06);
    }

    .sr-product-details {
      min-width: 0;
    }

    .sr-product-name {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      margin: 0 0 10px;
      color: var(--sr-text);
      font-size: 18px;
      font-weight: 700;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    .sr-product-category {
      margin: 0 0 12px;
      color: var(--sr-muted);
      font-size: 13px;
    }

    .sr-price-line {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 12px;
    }

    .sr-current-price {
      color: var(--sr-text);
      font-size: 17px;
      font-weight: 750;
    }

    .sr-original-price {
      color: #999;
      font-size: 13px;
      text-decoration: line-through;
    }

    .sr-discount-badge {
      padding: 4px 7px;
      border-radius: 5px;
      background: #eaf8ef;
      color: var(--sr-success);
      font-size: 11px;
      font-weight: 700;
    }

    .sr-stock {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      color: var(--sr-success);
      font-size: 12px;
      font-weight: 600;
    }

    .sr-stock-low {
      color: #c77700;
    }

    .sr-product-actions {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 18px;
      margin-top: 17px;
    }

    .sr-quantity-control {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      width: 116px;
      height: 38px;
      padding: 0 5px;
      border: 1px solid #e3e3e3;
      border-radius: 8px;
      background: #fff;
    }

    .sr-quantity-control button {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 29px;
      height: 29px;
      border: none;
      border-radius: 6px;
      background: transparent;
      color: var(--sr-text);
      cursor: pointer;
    }

    .sr-quantity-control button:hover {
      background: #fff0eb;
      color: var(--sr-primary);
    }

    .sr-quantity {
      min-width: 22px;
      text-align: center;
      font-size: 14px;
      font-weight: 700;
    }

    .sr-delete-button {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 0;
      border: none;
      background: transparent;
      color: #777;
      font-size: 13px;
      cursor: pointer;
    }

    .sr-delete-button:hover {
      color: #dc3545;
    }

    .sr-line-total {
      min-width: 105px;
      text-align: right;
      align-self: start;
      padding-top: 5px;
    }

    .sr-line-total small {
      display: block;
      margin-bottom: 6px;
      color: var(--sr-muted);
      font-size: 12px;
    }

    .sr-line-total strong {
      font-size: 18px;
      font-weight: 750;
      white-space: nowrap;
    }

    .sr-summary-card {
      position: sticky;
      top: 24px;
      padding: 25px;
    }

    .sr-summary-card h2 {
      margin: 0 0 22px;
      font-size: 21px;
      font-weight: 750;
    }

    .sr-summary-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      margin: 17px 0;
      color: #666;
      font-size: 14px;
    }

    .sr-summary-row>span:last-child {
      color: var(--sr-text);
      font-weight: 600;
      text-align: right;
    }

    .sr-free-shipping {
      color: var(--sr-success) !important;
    }

    .sr-summary-divider {
      height: 1px;
      margin: 22px 0;
      border: 0;
      background: var(--sr-border);
    }

    .sr-grand-total {
      color: var(--sr-text);
      font-size: 16px;
      font-weight: 750;
    }

    .sr-grand-total>span:last-child {
      font-size: 22px;
    }

    .sr-checkout-button {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      width: 100%;
      min-height: 49px;
      margin-top: 23px;
      padding: 12px 16px;
      border: none;
      border-radius: 9px;
      background: var(--sr-primary);
      color: #fff !important;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      transition: background 0.2s ease, transform 0.2s ease;
    }

    .sr-checkout-button:hover {
      background: var(--sr-primary-dark);
      transform: translateY(-1px);
    }

    .sr-checkout-button:focus-visible,
    .sr-quantity-control button:focus-visible,
    .sr-delete-button:focus-visible {
      outline: 2px solid var(--sr-primary);
      outline-offset: 3px;
    }

    .sr-secure-note {
      margin: 16px 0 0;
      color: var(--sr-muted);
      font-size: 12px;
      text-align: center;
    }

    .sr-continue-shopping {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 22px;
      color: var(--sr-text);
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
    }

    .sr-continue-shopping:hover {
      color: var(--sr-primary);
    }

    .sr-empty-cart {
      padding: 65px 20px;
      border: 1px solid var(--sr-border);
      border-radius: 16px;
      background: #fff;
      text-align: center;
    }

    .sr-empty-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 78px;
      height: 78px;
      margin: 0 auto 20px;
      border-radius: 50%;
      background: #fff0eb;
      color: var(--sr-primary);
      font-size: 30px;
    }

    .sr-empty-cart h2 {
      margin: 0 0 10px;
      font-size: 24px;
      font-weight: 750;
    }

    .sr-empty-cart p {
      margin: 0 0 24px;
      color: var(--sr-muted);
      font-size: 14px;
    }

    .sr-empty-cart .sr-checkout-button {
      width: auto;
      display: inline-flex;
      padding: 12px 25px;
    }

    @media (max-width: 1100px) {
      .sr-cart-layout {
        grid-template-columns: minmax(0, 1fr) 310px;
        gap: 18px;
      }

      .sr-cart-card {
        padding: 20px;
      }

      .sr-product-row {
        grid-template-columns: 115px minmax(0, 1fr);
        gap: 17px;
      }

      .sr-product-image {
        width: 115px;
        height: 135px;
      }

      .sr-line-total {
        grid-column: 2;
        text-align: left;
        padding-top: 0;
      }

      .sr-line-total small {
        display: inline;
        margin-right: 8px;
      }
    }

    @media (max-width: 800px) {
      .sr-cart-layout {
        grid-template-columns: 1fr;
      }

      .sr-summary-card {
        position: static;
      }

      .sr-cart-page {
        padding-top: 20px;
      }
    }

    @media (max-width: 520px) {
      .sr-cart-container {
        width: 92%;
      }

      .sr-page-heading {
        margin-bottom: 20px;
      }

      .sr-cart-card {
        padding: 15px;
      }

      .sr-product-row {
        grid-template-columns: 95px minmax(0, 1fr);
        gap: 12px;
        padding: 19px 0;
      }

      .sr-product-image {
        width: 95px;
        height: 115px;
        padding: 5px;
      }

      .sr-product-name {
        font-size: 15px;
      }

      .sr-product-category {
        font-size: 12px;
      }

      .sr-current-price {
        font-size: 15px;
      }

      .sr-price-line {
        gap: 6px;
      }

      .sr-product-actions {
        gap: 10px;
        margin-top: 12px;
      }

      .sr-quantity-control {
        width: 105px;
        height: 35px;
      }

      .sr-quantity-control button {
        width: 27px;
        height: 27px;
      }

      .sr-delete-button {
        font-size: 12px;
      }

      .sr-line-total {
        grid-column: 2;
      }

      .sr-line-total strong {
        font-size: 16px;
      }

      .sr-summary-card {
        padding: 20px;
      }

      .sr-cart-card-heading h2 {
        font-size: 18px;
      }
    }
  </style>
</head>

<body>

  <%- include('../partials/userHeader') %>

    <main class="sr-cart-page">
      <div class="sr-cart-container">

        <nav class="sr-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span> / Cart</span>
        </nav>

        <div class="sr-page-heading">
          <div>
            <h1>My Shopping Cart</h1>
            <p>Review your items before placing your order.</p>
          </div>
        </div>

        <% let totalPrice=0; %>

          <% if (cartData && cartData.length> 0) { %>

            <div class="sr-cart-layout">

              <section class="sr-cart-card">

                <div class="sr-cart-card-heading">
                  <h2>Cart Items</h2>
                  <span class="sr-item-count">
                    <%= cartData.length %>
                      <%= cartData.length===1 ? 'ITEM' : 'ITEMS' %>
                  </span>
                </div>

                <% cartData.forEach(product=> {
                  const hasCategoryOffer =
                  product.discountSource === 'category' &&
                  product.categoryOffer &&
                  product.categoryOffer.isOfferActive;

                  const hasProductOffer =
                  product.discountSource === 'product' &&
                  product.offer &&
                  product.offer.isOfferActive;

                  const hasActiveOffer = hasCategoryOffer || hasProductOffer;

                  const activeOffer = hasCategoryOffer
                  ? product.categoryOffer
                  : (hasProductOffer ? product.offer : null);

                  const unitPrice = hasActiveOffer
                  ? Number(product.discountPrice)
                  : Number(product.productprice);

                  const subtotal = unitPrice * Number(product.quantity);

                  totalPrice += subtotal;
                  %>

                  <article class="sr-product-row">

                    <div class="sr-product-image">
                      <img src="<%= product.image && product.image[0] ? product.image[0] : '/images/placeholder.png' %>"
                        alt="<%= product.productname %>" loading="lazy">
                    </div>

                    <div class="sr-product-details">

                      <h3 class="sr-product-name">
                        <%= product.productname %>
                      </h3>

                      <p class="sr-product-category">
                        Category:
                        <%= product.categoryname %>
                      </p>

                      <div class="sr-price-line">

                        <span class="sr-current-price">
                          ₹<%= unitPrice.toLocaleString('en-IN') %>
                        </span>

                        <% if (hasActiveOffer) { %>

                          <span class="sr-original-price">
                            ₹<%= Number(product.productprice).toLocaleString('en-IN') %>
                          </span>

                          <span class="sr-discount-badge">
                            <% if (activeOffer.discountType==='percentage' ) { %>
                              <%= activeOffer.discountValue %>% OFF
                                <% } else if (activeOffer.discountType==='fixed' ) { %>
                                  ₹<%= activeOffer.discountValue %> OFF
                                    <% } else { %>
                                      OFFER
                                      <% } %>
                          </span>

                          <% } %>

                      </div>

                      <span class="sr-stock <%= Number(product.stock) <= 5 ? 'sr-stock-low' : '' %>">
                        <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                        <%= product.stock %> left in stock
                      </span>

                      <div class="sr-product-actions">

                        <div class="sr-quantity-control" aria-label="Quantity controls">

                          <button type="button" aria-label="Decrease quantity"
                            onclick="changeQuantity('<%= product.productId %>', -1, this)">
                            <i class="fa-solid fa-minus" aria-hidden="true"></i>
                          </button>

                          <span class="sr-quantity quantity">
                            <%= product.quantity %>
                          </span>

                          <button type="button" aria-label="Increase quantity"
                            onclick="changeQuantity('<%= product.productId %>', 1, this)">
                            <i class="fa-solid fa-plus" aria-hidden="true"></i>
                          </button>

                        </div>

                        <button type="button" class="sr-delete-button"
                          onclick="deleteFromCart('<%= product.productId %>')">
                          <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
                          Remove
                        </button>

                      </div>

                    </div>

                    <div class="sr-line-total">
                      <small>Subtotal</small>
                      <strong>
                        ₹<span class="subtotal">
                          <%= subtotal.toLocaleString('en-IN') %>
                        </span>
                      </strong>
                    </div>

                  </article>

                  <% }); %>

                    <a href="/" class="sr-continue-shopping">
                      <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                      Continue Shopping
                    </a>

              </section>

              <aside class="sr-summary-card">

                <h2>Order Summary</h2>

                <div class="sr-summary-row">
                  <span>Cart Subtotal</span>
                  <span>₹<span id="cartTotal">
                      <%= totalPrice.toLocaleString('en-IN') %>
                    </span></span>
                </div>

                <div class="sr-summary-row">
                  <span>Shipping</span>
                  <span class="sr-free-shipping">FREE</span>
                </div>

                <div class="sr-summary-row">
                  <span>Discount</span>
                  <span>Included in prices</span>
                </div>

                <hr class="sr-summary-divider">

                <div class="sr-summary-row sr-grand-total">
                  <span>Total</span>
                  <span>₹<span id="finalTotal">
                      <%= totalPrice.toLocaleString('en-IN') %>
                    </span></span>
                </div>

                <a href="/checkout" class="sr-checkout-button">
                  Proceed to Checkout
                  <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>

                <p class="sr-secure-note">
                  <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                  Your order is just a step away.
                </p>

              </aside>

            </div>

            <% } else { %>

              <section class="sr-empty-cart">

                <div class="sr-empty-icon">
                  <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>
                </div>

                <h2>Your cart is empty</h2>

                <p>
                  Looks like you haven't added any shoes yet.
                  Find your next favourite pair!
                </p>

                <a href="/" class="sr-checkout-button">
                  <i class="fa-solid fa-store" aria-hidden="true"></i>
                  Explore Shoes
                </a>

              </section>

              <% } %>

      </div>
    </main>

    <%- include('../partials/userfooter') %>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
      <script>
        function formatPrice(amount) {
          return Number(amount).toLocaleString('en-IN', {
            maximumFractionDigits: 2
          });
        }

        function changeQuantity(productId, count, button) {
          const quantityElement = $(button).siblings('.quantity');

          const subTotalElement = $(button)
            .closest('.sr-product-details')
            .siblings('.sr-line-total')
            .find('.subtotal');

          const currentQuantity = parseInt(quantityElement.text(), 10);
          const newQuantity = currentQuantity + count;

          if (newQuantity <= 0) {
            Swal.fire({
              title: 'Minimum quantity required',
              text: 'Your cart must contain at least one item.',
              icon: 'warning',
              confirmButtonColor: '#f4512c'
            });
            return;
          }

          $.ajax({
            url: '/update-quantity',
            method: 'POST',
            data: {
              productId: productId,
              newQuantity: newQuantity
            },

            success: function (data) {
              quantityElement.text(newQuantity);
              subTotalElement.text(formatPrice(data.subtotal));

              $.ajax({
                url: '/updated-total-price',
                method: 'GET',

                success: function (response) {
                  $('#cartTotal').text(formatPrice(response.totalprice));
                  $('#finalTotal').text(formatPrice(response.totalprice));
                },
                error: function (xhr, status, error) {
                  Swal.fire({
                    title: 'Total update failed',
                    text: 'Quantity was updated, but the cart total could not be refreshed. Please reload the page.',
                    icon: 'warning',
                    confirmButtonColor: '#f4512c'
                  });
                }
              });
            },
            error: function (xhr, status, error) {

              if (xhr.status === 409) {
                const errMsg = xhr.responseJSON?.errorMessage;

                if (errMsg === 'Out Of Stock') {
                  Swal.fire({
                    title: 'Out of stock',
                    text: 'This product is currently out of stock.',
                    icon: 'warning',
                    confirmButtonColor: '#f4512c'
                  });
                } else {
                  Swal.fire({
                    title: 'Quantity limit reached',
                    text: errMsg || 'You have reached the maximum available quantity.',
                    icon: 'warning',
                    confirmButtonColor: '#f4512c'
                  });
                }
              } else if (xhr.status === 401 || xhr.status === 403) {
                Swal.fire({
                  title: 'Access denied',
                  text: 'Please log in again to update your cart.',
                  icon: 'warning',
                  confirmButtonColor: '#f4512c'
                });
              } else if (xhr.status === 404) {
                Swal.fire({
                  title: 'Product not found',
                  text: 'This product may no longer be available.',
                  icon: 'warning',
                  confirmButtonColor: '#f4512c'
                });
              } else {
                Swal.fire({
                  title: 'Something went wrong',
                  text: 'Unable to update the quantity. Please try again.',
                  icon: 'error',
                  confirmButtonColor: '#f4512c'
                });
              }
            }
          });
        }

        function deleteFromCart(productId) {
          const url = `/cart/delete-product/${productId}`;

          Swal.fire({
            title: 'Remove this item?',
            text: 'This shoe will be removed from your cart.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#f4512c',
            cancelButtonColor: '#777',
            confirmButtonText: 'Yes, remove it',
            cancelButtonText: 'Keep item',
            reverseButtons: true
          }).then((result) => {
            if (result.isConfirmed) {
              window.location.href = url;
            }
          });
        }
      </script>

</body>

</html>