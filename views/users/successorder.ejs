<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Order Success | Shoe Rack</title>


  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9fa;
      color: #343a40;
      font-family: Arial, sans-serif;
      margin: 0;
    }

    .success-container {
      background-color: #ffffff;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
      padding: 50px 30px;
      margin: 100px auto;
      max-width: 650px;
      min-height: 350px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .success-icon {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      background-color: #e8f8ee;
      color: #198754;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 48px;
      font-weight: bold;
      margin-bottom: 25px;
    }

    .success-container h1 {
      font-size: 32px;
      margin-bottom: 15px;
      color: #212529;
    }

    .success-container p {
      font-size: 16px;
      line-height: 1.7;
      color: #6c757d;
      margin-bottom: 25px;
    }

    .success-container .brand {
      color: #198754;
      font-weight: bold;
    }

    .button-group {
      display: flex;
      gap: 15px;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 10px;
    }

    .btn {
      display: inline-block;
      padding: 13px 24px;
      border-radius: 6px;
      text-decoration: none;
      font-size: 15px;
      font-weight: 600;
      transition: background-color 0.2s ease;
    }

    .btn-primary {
      background-color: #212529;
      color: #ffffff;
      border: 1px solid #212529;
    }

    .btn-primary:hover {
      background-color: #343a40;
    }

    .btn-secondary {
      background-color: #ffffff;
      color: #212529;
      border: 1px solid #ced4da;
    }

    .btn-secondary:hover {
      background-color: #f1f3f5;
    }

    .confirmation-note {
      font-size: 13px !important;
      margin-top: 25px;
      margin-bottom: 0 !important;
    }

    @media (max-width: 576px) {
      .success-container {
        margin: 40px 15px;
        padding: 35px 20px;
        min-height: 300px;
      }

      .success-container h1 {
        font-size: 26px;
      }

      .button-group {
        flex-direction: column;
        width: 100%;
      }

      .btn {
        box-sizing: border-box;
        width: 100%;
      }
    }
  </style>
</head>

<body>

  <%- include('../partials/userHeader') %>

    <main class="success-container">

      <div class="success-icon" aria-label="Success">✓</div>

      <h1>Order Placed Successfully!</h1>

      <p>
        Thank you for shopping with <span class="brand">Shoe Rack</span>!
        Your order has been placed successfully.
        We appreciate your trust in us and hope you enjoy your new shoes.
      </p>

      <div class="button-group">
        <a href="/products" class="btn btn-primary">
          Continue Shopping
        </a>

        <a href="/account" class="btn btn-secondary">
          View My Orders
        </a>
      </div>

      <p class="confirmation-note">
        Thank you for choosing Shoe Rack. Step into style!
      </p>

    </main>

    <%- include('../partials/userfooter') %>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>